// Positive control for attack_mod: both sides run Test with modulus c
// before counting c up; Left with E, Right with F. With E = ModS() and
// F = ModSIn() the two are the same function, so the games are
// interchangeable.
import 'ModP.primitive';

Game Left(ModP E, ModP F) {
    Int c = 2;
    Bool f(Int a, Bool b, Bool d) {
        Bool r = E.Test(c, a, b, d);
        c = c + 1;
        return r;
    }
}

Game Right(ModP E, ModP F) {
    Int c = 2;
    Bool f(Int a, Bool b, Bool d) {
        Bool r = F.Test(c, a, b, d);
        c = c + 1;
        return r;
    }
}

export as CtlPair;
