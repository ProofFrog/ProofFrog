  module G_StoredSS2_R (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : C_c.KEM_INDCCA_MultiChal_Oracle = {
    var ss2Star : SS2Space
