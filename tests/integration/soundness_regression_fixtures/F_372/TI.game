// Left records 0 in M with probability 1/2, Right always.
// Distinguisher: Has() is false with probability 1/2 on Left, never on Right.
Game Left() {
    Map<Int, Int> M;
    Void Initialize() {
        Bool b <- Bool;
        if (b) {
            M[0] = 1;
        }
    }
    Bool Has() { return 0 in M; }
}
Game Right() {
    Map<Int, Int> M;
    Void Initialize() {
        Bool b <- Bool;
        M[0] = 1;
    }
    Bool Has() { return 0 in M; }
}
export as TI;
