// F-372, found by the review of S36's retry (2026-11-16).
// Target: conditional_calls._Rewriter._rewrite_statement (temporary form),
// which binds the parts before a && with EvaluationOrder.conflicting/bind,
// while the reduction is resolved alone.
// Hypothesis: as in bind_order.proof, only the parts that conflict with
// the && operands are bound in front, so CopyCtoD (reads c) jumps ahead of
// IncC (writes c). CDB().Left's DZero makes a dead read of c, so there both
// calls are bound and the order is kept; the two sides of CDB behave
// identically (the assumption is true).
// As written: IncC, CopyCtoD (d = 1), DZero false, Pick skipped, Test
// returns false: TC(P).Left on both sides of CDB.
// Sound engine: fails at hop 3.
// Unsound engine: Proof Succeeded! on the false theorem TC(P).
// Distinguisher: one Test({}) call returns false on TC(P).Left and true on
// TC(P).Right.
import 'Picker.primitive';
import 'PickImpl.scheme';
import 'CDB.game';
import 'TC.game';
Reduction R(Picker P) compose CDB() against TC(P).Adversary {
    Void Initialize() { challenger.Initialize(); }
    Bool Test(Set<BitString<1>> S) {
        return challenger.ThirdB(challenger.IncC(), challenger.CopyCtoD(), challenger.DZero() && P.Pick(S));
    }
}
proof:
let:
    PickImpl P = PickImpl();
assume:
    CDB();
theorem:
    TC(P);
games:
    TC(P).Left against TC(P).Adversary;
    CDB().Left compose R(P) against TC(P).Adversary;
    CDB().Right compose R(P) against TC(P).Adversary;
    TC(P).Right against TC(P).Adversary;
