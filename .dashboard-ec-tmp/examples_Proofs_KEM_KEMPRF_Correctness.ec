    smt().
    smt().
    proc.
    wp.
    call (_: true).
    skip => /#.
    proc.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__}).
    call (_: true); auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a2__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a2__, _r0}).
    wp.
    exists* (glob F){2}, (__a0__.`1){2}, (__a2__){2}; elim* => g1 a1_0 a1_1.
    call{2} (F_evaluate_det g1 a1_0 a1_1).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a2__, _r0, __a4__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a2__, _r0, __a4__, __a5__}).
    auto.
    skip => /#.
  qed.

  (* transform: Inline Single-Use Variables (reversed) (bucket=canned) *)
