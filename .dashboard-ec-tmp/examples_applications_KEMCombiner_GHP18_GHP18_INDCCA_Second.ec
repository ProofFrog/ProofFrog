  module R_Correct_L_Adv (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCCA_MultiChal_Adv, C : KEM2_c.KEMCorrectness_Oracle) = {
