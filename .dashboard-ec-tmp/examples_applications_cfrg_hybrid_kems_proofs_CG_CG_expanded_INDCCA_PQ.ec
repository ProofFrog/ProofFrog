  }
  proc encodeencapskey(ek : KEMPQEncapsKeySpace * NGElementSpace) : bs_kem_pq_nek_ng_nelem = {
    var _r0 : bs_kem_pq_nek;
    var _r1 : bs_ng_nelem;
    _r0 <@ K.encodeencapskey(ek.`1);
    _r1 <@ NG.encode(ek.`2);
    return concat_bs_kem_pq_nek_bs_ng_nelem_to_bs_kem_pq_nek_ng_nelem _r0 _r1;
  }
  proc decaps(dk : KEMPQDecapsKeySpace * NGScalarSpace * NGElementSpace, ct : KEMPQCiphertextSpace * NGElementSpace) : bs_kdf_nout = {
    var dk_PQ : KEMPQDecapsKeySpace;
    var dk_T : NGScalarSpace;
    var ek_T : NGElementSpace;
    var ct_PQ : KEMPQCiphertextSpace;
    var ct_T : NGElementSpace;
    var ss_PQ : bs_kem_pq_nss;
    var ss_T_elem : NGElementSpace;
    var ss_T : bs_ng_nss;
    var _r0 : bs_kem_pq_nss;
    var _r1 : bs_ng_nelem;
    var _r2 : bs_ng_nelem;
    var _r3 : bs_nlabel;
    var kdf_in : bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel;
    var _r4 : bs_kdf_nout;
    dk_PQ <- dk.`1;
    dk_T <- dk.`2;
    ek_T <- dk.`3;
    ct_PQ <- ct.`1;
    ct_T <- ct.`2;
    ss_PQ <@ K.decaps(dk_PQ, ct_PQ);
    ss_T_elem <@ NG.exp(ct_T, dk_T);
    ss_T <@ NG.elementtosharedsecret(ss_T_elem);
    _r0 <@ K.encodesharedsecret(ss_PQ);
    _r1 <@ NG.encode(ct_T);
    _r2 <@ NG.encode(ek_T);
    _r3 <@ L.get();
    kdf_in <- concat_bs_kem_pq_nss_2_ng_nelem_ng_nss_bs_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel (concat_bs_kem_pq_nss_ng_nelem_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_2_ng_nelem_ng_nss (concat_bs_kem_pq_nss_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_ng_nelem_ng_nss (concat_bs_kem_pq_nss_bs_ng_nss_to_bs_kem_pq_nss_ng_nss _r0 ss_T) _r1) _r2) _r3;
    _r4 <@ H.evaluate(kdf_in);
    return _r4;
  }
}.

