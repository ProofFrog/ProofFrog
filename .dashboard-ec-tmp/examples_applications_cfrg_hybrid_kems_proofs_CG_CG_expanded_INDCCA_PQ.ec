  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_0(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_1(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Real.dk.`1{1} = R_Correct_Real.corr.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`3{1} = NG_c.ev_exp (NG_c.ev_generator) (Hybrid_c.KEM_INDCCA_Real.dk.`2{1}) /\ Hybrid_c.KEM_INDCCA_Real.ctStar{1} = R_Correct_Real.ctStar{2} /\ R_Correct_Real.corr{2}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Real.corr{2}.`2) (R_Correct_Real.corr{2}.`3)).
    + conseq hop_0_decaps.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEMCorrectnessWithDK_advantage axiom applied to R_Correct_Real_Adv. *)

  lemma hop_1_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_1(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_2(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEMCorrectnessWithDK.
  proof.
    have hL : Pr[Game_step_1(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromDecaps(KEM_PQ, R_Correct_Real_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromEncaps(KEM_PQ, R_Correct_Real_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM_PQ_c.KEMCorrectnessWithDK_advantage KEM_PQ (R_Correct_Real_Adv(KEM_PQ, NG, G, H, L, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_2(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_3(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameCaseSplitReal.pq_keys.`1{2} = R_Correct_Real.corr.`1{1} /\ GameCaseSplitReal.pq_keys.`2{2} = R_Correct_Real.corr.`2{1} /\ GameCaseSplitReal.seed_T{2} = R_Correct_Real.seed_T{1} /\ GameCaseSplitReal.kem_ct{2} = R_Correct_Real.corr.`3{1} /\ GameCaseSplitReal.ss_PQ{2} = R_Correct_Real.corr.`4{1} /\ GameCaseSplitReal.ctStar{2} = R_Correct_Real.ctStar{1} /\ R_Correct_Real.corr{1}.`5 = R_Correct_Real.corr{1}.`4).
    + conseq hop_2_decaps.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_3_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_3(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_4(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
