  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0_initialize :
    equiv [ DSE_c.INDCPA__MultiChal_Real(GeneralDoubleSymEnc(D, E)).initialize ~ R1(D, E, GeneralDoubleSymEnc(D, E), E_c.INDCPA__MultiChal_Real(E)).initialize :
