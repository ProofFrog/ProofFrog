// Target: the method inliner (InlineTransformer), parameter substitution.
// Hypothesis: as ParamWrite, for an element write `X[k] = 0^n;` to a Map
// parameter: substituting the caller's field M for X writes M itself.
// Left: Clear passes M, so M is unchanged and Get returns the adversary's
// value; Right: Get returns 0^n after a Clear. Sound engine: Proof Failed!
// Unsound engine: Proof Succeeded!
import 'Writer.primitive';

Game Left(Writer T, Int n) {
    Map<BitString<n>, BitString<n>> M;

    Void Put(BitString<n> k, BitString<n> v) {
        M[k] = v;
    }

    BitString<n> ClearGet(BitString<n> k) {
        Bool b = T.Clear(M, k);
        return M[k];
    }
}

Game Right(Writer T, Int n) {
    Map<BitString<n>, BitString<n>> M;

    Void Put(BitString<n> k, BitString<n> v) {
        M[k] = v;
    }

    BitString<n> ClearGet(BitString<n> k) {
        M[k] = 0^n;
        return M[k];
    }
}

export as ParamElementWrite;
