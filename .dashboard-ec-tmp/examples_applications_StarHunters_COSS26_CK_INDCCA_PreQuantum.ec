(* ===== Concrete scheme implementation ===== *)

module CK (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : C_c.Scheme = {
  proc keygen() : (PK1Space * PK2Space) * (SK1Space * SK2Space * PK2Space) = {
    var k1 : PK1Space * SK1Space;
    var k2 : PK2Space * SK2Space;
    k1 <@ KEM1.keygen();
    k2 <@ KEM2.keygen();
    return ((k1.`1, k2.`1), (k1.`2, k2.`2, k2.`1));
  }
  proc encaps(pk : PK1Space * PK2Space) : bs_outlen * (CT1Space * CT2Space) = {
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var _tup : SS1Space * CT1Space;
    var ss1 : SS1Space;
    var ct1 : CT1Space;
    var _tup_0 : SS2Space * CT2Space;
    var ss2 : SS2Space;
    var ct2 : CT2Space;
    var bct2 : bs_ct2len;
    var bpk2 : bs_pk2len;
    var label : bs_ct2len_pk2len;
    var ss : bs_outlen;
    pk1 <- pk.`1;
    pk2 <- pk.`2;
    _tup <@ KEM1.encaps(pk1);
    ss1 <- _tup.`1;
    ct1 <- _tup.`2;
    _tup_0 <@ KEM2.encaps(pk2);
    ss2 <- _tup_0.`1;
    ct2 <- _tup_0.`2;
    bct2 <- ct2;
    bpk2 <- pk2;
    label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
    ss <@ F.evaluate(ss1, ss2, label);
    return (ss, (ct1, ct2));
  }
  proc decaps(sk : SK1Space * SK2Space * PK2Space, c : CT1Space * CT2Space) : bs_outlen = {
    var sk1 : SK1Space;
    var sk2 : SK2Space;
    var pk2 : PK2Space;
    var ct1 : CT1Space;
    var ct2 : CT2Space;
    var ss1 : SS1Space;
    var ss2 : SS2Space;
    var bct2 : bs_ct2len;
    var bpk2 : bs_pk2len;
    var label : bs_ct2len_pk2len;
    var _r0 : bs_outlen;
    sk1 <- sk.`1;
    sk2 <- sk.`2;
    pk2 <- sk.`3;
    ct1 <- c.`1;
    ct2 <- c.`2;
    ss1 <@ KEM1.decaps(sk1, ct1);
    ss2 <@ KEM2.decaps(sk2, ct2);
    bct2 <- ct2;
    bpk2 <- pk2;
    label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
    _r0 <@ F.evaluate(ss1, ss2, label);
    return _r0;
  }
}.

section Main.
  (* ===== Reductions ===== *)

  module R_Correct_2L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, C : C_c.Scheme, Challenger : KEM2_c.KEMCorrectness_Oracle) = {
    var ss2d : SS2Space
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var pk : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var _tup_1 : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var _tup_2 : CT2Space * SS2Space * SS2Space;
      var ss2e : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ KEM1.encaps(pk);
      ss1 <- _tup_1.`1;
      ct1Star <- _tup_1.`2;
      _tup_2 <@ Challenger.compute(pk2, sk2);
      ct2Star <- _tup_2.`1;
      ss2e <- _tup_2.`2;
      ss2d <- _tup_2.`3;
      bct2 <- ct2Star;
      bpk2 <- pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ F.evaluate(ss1, ss2e, label);
      return ((pk, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct2 = ct2Star) {
          _r1 <@ F.evaluate(ss1, ss2d, label);
          _r0 <- Some (_r1);
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

  module R_Correct_2R (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, C : C_c.Scheme, Challenger : KEM2_c.KEMCorrectness_Oracle) = {
    var ss2d : SS2Space
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var pk : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var rsp1 : SS1Space * CT1Space;
      var corr : CT2Space * SS2Space * SS2Space;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      rsp1 <@ KEM1.encaps(pk);
      ct1Star <- rsp1.`2;
      corr <@ Challenger.compute(pk2, sk2);
      ct2Star <- corr.`1;
      ss2d <- corr.`3;
      ss <$ dbs_outlen;
      return ((pk, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct2 = ct2Star) {
          _r1 <@ F.evaluate(ss1, ss2d, label);
          _r0 <- Some (_r1);
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

  module R_KEM2_L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, C : C_c.Scheme, Challenger : KEM2_c.KEM_INDCCA_MultiChal_Oracle) = {
    var ss2Star : SS2Space
    var sk1 : SK1Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var pk : PK1Space;
      var _tup_0 : PK2Space * SS2Space * CT2Space;
      var _tup_1 : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ Challenger.initialize();
      pk2 <- _tup_0.`1;
      ss2Star <- _tup_0.`2;
      ct2Star <- _tup_0.`3;
      _tup_1 <@ KEM1.encaps(pk);
      ss1 <- _tup_1.`1;
      ct1Star <- _tup_1.`2;
      bct2 <- ct2Star;
      bpk2 <- pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ F.evaluate(ss1, ss2Star, label);
      return ((pk, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var _r1 : bs_outlen;
      var ss2_opt : SS2Space option;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct2 = ct2Star) {
          _r1 <@ F.evaluate(ss1, ss2Star, label);
          _r0 <- Some (_r1);
        } else {
          ss2_opt <@ Challenger.decaps(ct2);
          if (false) {
            _r0 <- None;
          } else {
            _r2 <@ F.evaluate(ss1, oget (ss2_opt), label);
            _r0 <- Some (_r2);
          }
        }
      }
      return _r0;
    }
  }.

