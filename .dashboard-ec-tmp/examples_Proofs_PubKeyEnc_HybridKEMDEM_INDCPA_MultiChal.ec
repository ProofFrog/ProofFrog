  lemma hop_10_initialize :
    equiv [ R5(E, K, KEMDEM(K, E), K_c.KEM_INDCPA_MultiChal_Real(K)).initialize ~ KD_c.INDCPA_MultiChal_Right(KEMDEM(K, E)).initialize :
            ={glob E} /\ ={glob K} ==> ={res} /\ ={glob E} /\ ={glob K} /\ K_c.KEM_INDCPA_MultiChal_Real.pk{1} = KD_c.INDCPA_MultiChal_Right.pk{2} ].
  proof.
    (* resolution: synth-static *)
