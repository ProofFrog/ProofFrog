  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFFirstKeySecurity_Random, -F_c.TwoKeyPRFFirstKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS1, -G_StoredSS1_R, -KEM1_c.KEM_INDCCA_MultiChal_Random, -KEM1_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM1_L, -R_KEM1_R, -R_PRF_L, -R_PRF_R}) &m :
    Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F}).
    + conseq hop_0_decaps.
    call hop_0_initialize.
