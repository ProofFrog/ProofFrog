  module R_PRF_L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, C : C_c.Scheme, Challenger : F_c.TwoKeyPRFFirstKeySecurity_Oracle) = {
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var pk : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var rsp1 : SS1Space * CT1Space;
      var _tup_1 : SS2Space * CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
