  (* ===== Deterministic-method specs ===== *)

  declare axiom KEM1_decaps_det (g : (glob KEM1)) (a0 : SK1Space) (a1 : CT1Space) : phoare[ KEM1.decaps : (glob KEM1) = g /\ sk = a0 /\ m = a1 ==> (glob KEM1) = g /\ res = KEM1_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom KEM2_decaps_det (g : (glob KEM2)) (a0 : SK2Space) (a1 : CT2Space) : phoare[ KEM2.decaps : (glob KEM2) = g /\ sk = a0 /\ m = a1 ==> (glob KEM2) = g /\ res = KEM2_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom F_evaluate_det (g : (glob F)) (a0 : bs_lambda) (a1 : bs_ss2len) (a2 : bs_ct2len_pk2len) : phoare[ F.evaluate : (glob F) = g /\ key1 = a0 /\ key2 = a1 /\ input = a2 ==> (glob F) = g /\ res = F_c.ev_evaluate a0 a1 a2 ] = 1%r.

  (* ===== Glob-preservation specs (dead-call drop) ===== *)

  declare axiom KEM1_decaps_pres (g : (glob KEM1)) : phoare[ KEM1.decaps : (glob KEM1) = g ==> (glob KEM1) = g ] = 1%r.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0_initialize :
    equiv [ C_c.KEM_INDCCA_MultiChal_Real(CK(KEM1, KEM2, F)).initialize ~ R_Correct_L(KEM1, KEM2, F, CK(KEM1, KEM2, F), KEM1_c.KEMCorrectness_FromDecaps(KEM1)).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ].
