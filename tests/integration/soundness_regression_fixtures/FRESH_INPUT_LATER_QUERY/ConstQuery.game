// Call Fresh, then Hash: in Left v = 0b00 with probability 1/4, and the two
// answers are then equal, so they agree with probability 7/16 (1/4 in Right).
import 'P.primitive';

Game Left(P S) {
    Function<BitString<2>, BitString<2>> H;
    Set<BitString<2>> seen;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
    }
    BitString<2> Hash() {
        seen = seen union {0b00};
        return H(0b00);
    }
    BitString<2> Fresh() {
        BitString<2> v <-uniq[seen] BitString<2>;
        return H(v);
    }
}

Game Right(P S) {
    Function<BitString<2>, BitString<2>> H;
    Set<BitString<2>> seen;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
    }
    BitString<2> Hash() {
        seen = seen union {0b00};
        return H(0b00);
    }
    BitString<2> Fresh() {
        BitString<2> z <- BitString<2>;
        return z;
    }
}

export as ConstQuery;
