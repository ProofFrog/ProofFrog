  lemma hop_18_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_18(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_19(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_Consolidated.sk1{1} = R_KEM2_R.sk1{2} /\ G_Consolidated.pk2{1} = R_KEM2_R.pk2{2} /\ G_Consolidated.ct1Star{1} = R_KEM2_R.ct1Star{2} /\ G_Consolidated.ct2Star{1} = R_KEM2_R.ct2Star{2} /\ R_KEM2_R.ct2Star{2} = KEM2_c.KEM_INDCCA_MultiChal_Random.ctStar{2}).
    + conseq hop_18_decaps.
    call hop_18_initialize.
    auto.
    qed.

  (* Hop 19: assumption hop. Bounded by the KEM_INDCCA_MultiChal_advantage axiom applied to R_KEM2_R_Adv. *)

  lemma hop_19_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_19(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_20(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEM_INDCCA_MultiChal.
  proof.
    have hL : Pr[Game_step_19(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEM_INDCCA_MultiChal_Random(KEM2, R_KEM2_R_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM2_R, glob KEM2, glob KEM1, glob F, glob KEM2_c.KEM_INDCCA_MultiChal_Random}); [ proc; sim | wp; rnd; wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); skip => /# ].
    have hR : Pr[Game_step_20(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEM_INDCCA_MultiChal_Real(KEM2, R_KEM2_R_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM2_R, glob KEM2, glob KEM1, glob F, glob KEM2_c.KEM_INDCCA_MultiChal_Real}); [ proc; sim | wp; rnd; wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); skip => /# ].
    rewrite hL hR.
    have H := KEM2_c.KEM_INDCCA_MultiChal_advantage KEM2 (R_KEM2_R_Adv(KEM1, KEM2, F, A)) &m.
    smt().
    qed.

  (* Hop 20: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_20_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_20(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_21(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2_R.ss2Star{2} = R_KEM2_R.ss2Star{1} /\ G_StoredSS2_R.sk1{2} = R_KEM2_R.sk1{1} /\ G_StoredSS2_R.pk2{2} = R_KEM2_R.pk2{1} /\ G_StoredSS2_R.ct1Star{2} = R_KEM2_R.ct1Star{1} /\ G_StoredSS2_R.ct2Star{2} = R_KEM2_R.ct2Star{1} /\ R_KEM2_R.ct2Star{1} = KEM2_c.KEM_INDCCA_MultiChal_Real.ctStar{1}).
    + conseq hop_20_decaps.
    call hop_20_initialize.
    auto.
    qed.

  (* Hop 21: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_21_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_21(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_22(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2_R.sk1{1} = R_Correct_2R.sk1{2} /\ G_StoredSS2_R.sk2{1} = R_Correct_2R.sk2{2} /\ G_StoredSS2_R.pk2{1} = R_Correct_2R.pk2{2} /\ G_StoredSS2_R.ct1Star{1} = R_Correct_2R.ct1Star{2} /\ G_StoredSS2_R.ct2Star{1} = R_Correct_2R.ct2Star{2} /\ R_Correct_2R.corr{2}.`3 = R_Correct_2R.corr{2}.`2).
    + conseq hop_21_decaps.
    call hop_21_initialize.
    auto.
    qed.

  (* Hop 22: assumption hop. Bounded by the KEMCorrectness_advantage axiom applied to R_Correct_2R_Adv. *)

  lemma hop_22_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_22(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_23(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEMCorrectness.
  proof.
    have hL : Pr[Game_step_22(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromEncaps(KEM2, R_Correct_2R_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_23(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromDecaps(KEM2, R_Correct_2R_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    have H := KEM2_c.KEMCorrectness_advantage KEM2 (R_Correct_2R_Adv(KEM1, KEM2, F, A)) &m.
    smt().
    qed.

  (* Hop 23: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_23_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_23(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_24(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F}).
    + conseq hop_23_decaps.
    call hop_23_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_24(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEMCorrectness + KEM2_c.eps_KEM_INDCCA_MultiChal + KEM1_c.eps_KEM_C2PRI + F_c.eps_TwoKeyPRFSecondKeySecurity + F_c.eps_TwoKeyPRFSecondKeySecurity + KEM1_c.eps_KEM_C2PRI + KEM2_c.eps_KEM_INDCCA_MultiChal + KEM2_c.eps_KEMCorrectness.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    have h6 := hop_6_pr A &m.
    have h7 := hop_7_pr A &m.
    have h8 := hop_8_pr A &m.
    have h9 := hop_9_pr A &m.
    have h10 := hop_10_pr A &m.
    have h11 := hop_11_pr A &m.
    have h12 := hop_12_pr A &m.
    have h13 := hop_13_pr A &m.
    have h14 := hop_14_pr A &m.
    have h15 := hop_15_pr A &m.
    have h16 := hop_16_pr A &m.
    have h17 := hop_17_pr A &m.
    have h18 := hop_18_pr A &m.
    have h19 := hop_19_pr A &m.
    have h20 := hop_20_pr A &m.
    have h21 := hop_21_pr A &m.
    have h22 := hop_22_pr A &m.
    have h23 := hop_23_pr A &m.
    smt(F_c.eps_TwoKeyPRFSecondKeySecurity_pos KEM1_c.eps_KEM_C2PRI_pos KEM2_c.eps_KEMCorrectness_pos KEM2_c.eps_KEM_INDCCA_MultiChal_pos).
    qed.
end section Main.
