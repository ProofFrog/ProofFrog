(* NOTE: the FrogLang scheme has `requires` clauses that are not enforced by the EC export. The scheme module below may fail EC type-checking because cross-clone type equalities implied by the `requires` are not expressed in the clones. Deferred to Phase 5D. *)

(* ===== Concrete scheme implementation ===== *)

module CG_seedbased (K : KEM_PQ_c.Scheme, NG : NG_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme) : Hybrid_c.Scheme = {
  proc derivekeypair(seed : bs_kem_pq_nseed) : (KEMPQEncapsKeySpace * NGElementSpace) * bs_kem_pq_nseed = {
    var seed_full : bs_kem_pq_nseed_ng_nseed;
    var seed_PQ : bs_kem_pq_nseed;
    var seed_T : bs_ng_nseed;
    var _tup : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace;
    var ek_PQ : KEMPQEncapsKeySpace;
    var dk_PQ : KEMPQDecapsKeySpace;
    var dk_T : NGScalarSpace;
    var _r0 : NGElementSpace;
    var ek_T : NGElementSpace;
    seed_full <@ G.evaluate(seed);
    seed_PQ <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_kem_pq_nseed seed_full 0 kem_pq_nseed;
    seed_T <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_ng_nseed seed_full kem_pq_nseed (kem_pq_nseed + ng_nseed);
    _tup <@ K.derivekeypair(seed_PQ);
    ek_PQ <- _tup.`1;
    dk_PQ <- _tup.`2;
    dk_T <@ NG.randomscalar(seed_T);
    _r0 <@ NG.generator();
    ek_T <@ NG.exp(_r0, dk_T);
    return ((ek_PQ, ek_T), seed);
  }
  proc keygen() : (KEMPQEncapsKeySpace * NGElementSpace) * bs_kem_pq_nseed = {
    var seed : bs_kem_pq_nseed;
    var _r0 : (KEMPQEncapsKeySpace * NGElementSpace) * bs_kem_pq_nseed;
    seed <$ dbs_kem_pq_nseed;
    _r0 <@ derivekeypair(seed);
    return _r0;
  }
  proc encaps(ek : KEMPQEncapsKeySpace * NGElementSpace) : bs_kdf_nout * (KEMPQCiphertextSpace * NGElementSpace) = {
    var ek_PQ : KEMPQEncapsKeySpace;
    var ek_T : NGElementSpace;
    var _tup : bs_kem_pq_nss * KEMPQCiphertextSpace;
    var ss_PQ : bs_kem_pq_nss;
    var ct_PQ : KEMPQCiphertextSpace;
    var seed_E : bs_ng_nseed;
    var sk_E : NGScalarSpace;
    var _r0 : NGElementSpace;
    var ct_T : NGElementSpace;
    var ss_T_elem : NGElementSpace;
    var ss_T : bs_ng_nss;
    var _r1 : bs_kem_pq_nss;
    var _r2 : bs_ng_nelem;
    var _r3 : bs_ng_nelem;
    var _r4 : bs_nlabel;
    var kdf_in : bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel;
    var ss : bs_kdf_nout;
    var ct : KEMPQCiphertextSpace * NGElementSpace;
    ek_PQ <- ek.`1;
    ek_T <- ek.`2;
    _tup <@ K.encaps(ek_PQ);
    ss_PQ <- _tup.`1;
    ct_PQ <- _tup.`2;
    seed_E <$ dbs_ng_nseed;
    sk_E <@ NG.randomscalar(seed_E);
    _r0 <@ NG.generator();
    ct_T <@ NG.exp(_r0, sk_E);
    ss_T_elem <@ NG.exp(ek_T, sk_E);
    ss_T <@ NG.elementtosharedsecret(ss_T_elem);
    _r1 <@ K.encodesharedsecret(ss_PQ);
    _r2 <@ NG.encode(ct_T);
    _r3 <@ NG.encode(ek_T);
    _r4 <@ L.get();
    kdf_in <- concat_bs_kem_pq_nss_2_ng_nelem_ng_nss_bs_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel (concat_bs_kem_pq_nss_ng_nelem_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_2_ng_nelem_ng_nss (concat_bs_kem_pq_nss_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_ng_nelem_ng_nss (concat_bs_kem_pq_nss_bs_ng_nss_to_bs_kem_pq_nss_ng_nss _r1 ss_T) _r2) _r3) _r4;
    ss <@ H.evaluate(kdf_in);
    ct <- (ct_PQ, ct_T);
    return (ss, ct);
  }
  proc encodesharedsecret(ss : bs_kdf_nout) : bs_kdf_nout = {
    return ss;
  }
  proc encodeciphertext(ct : KEMPQCiphertextSpace * NGElementSpace) : bs_kem_pq_nct_ng_nelem = {
    var _r0 : bs_kem_pq_nct;
    var _r1 : bs_ng_nelem;
    _r0 <@ K.encodeciphertext(ct.`1);
    _r1 <@ NG.encode(ct.`2);
    return concat_bs_kem_pq_nct_bs_ng_nelem_to_bs_kem_pq_nct_ng_nelem _r0 _r1;
  }
  proc encodeencapskey(ek : KEMPQEncapsKeySpace * NGElementSpace) : bs_kem_pq_nek_ng_nelem = {
    var _r0 : bs_kem_pq_nek;
    var _r1 : bs_ng_nelem;
    _r0 <@ K.encodeencapskey(ek.`1);
    _r1 <@ NG.encode(ek.`2);
    return concat_bs_kem_pq_nek_bs_ng_nelem_to_bs_kem_pq_nek_ng_nelem _r0 _r1;
  }
  proc decaps(dk : bs_kem_pq_nseed, ct : KEMPQCiphertextSpace * NGElementSpace) : bs_kdf_nout = {
    var seed_full : bs_kem_pq_nseed_ng_nseed;
    var seed_PQ : bs_kem_pq_nseed;
    var seed_T : bs_ng_nseed;
    var _tup : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace;
    var ek_PQ : KEMPQEncapsKeySpace;
    var dk_PQ : KEMPQDecapsKeySpace;
    var dk_T : NGScalarSpace;
    var _r0 : NGElementSpace;
    var ek_T : NGElementSpace;
    var ct_PQ : KEMPQCiphertextSpace;
    var ct_T : NGElementSpace;
    var ss_PQ : bs_kem_pq_nss;
    var ss_T_elem : NGElementSpace;
    var ss_T : bs_ng_nss;
    var _r1 : bs_kem_pq_nss;
    var _r2 : bs_ng_nelem;
    var _r3 : bs_ng_nelem;
    var _r4 : bs_nlabel;
    var kdf_in : bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel;
    var _r5 : bs_kdf_nout;
    seed_full <@ G.evaluate(dk);
    seed_PQ <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_kem_pq_nseed seed_full 0 kem_pq_nseed;
    seed_T <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_ng_nseed seed_full kem_pq_nseed (kem_pq_nseed + ng_nseed);
    _tup <@ K.derivekeypair(seed_PQ);
    ek_PQ <- _tup.`1;
    dk_PQ <- _tup.`2;
    dk_T <@ NG.randomscalar(seed_T);
    _r0 <@ NG.generator();
    ek_T <@ NG.exp(_r0, dk_T);
    ct_PQ <- ct.`1;
    ct_T <- ct.`2;
    ss_PQ <@ K.decaps(dk_PQ, ct_PQ);
    ss_T_elem <@ NG.exp(ct_T, dk_T);
    ss_T <@ NG.elementtosharedsecret(ss_T_elem);
    _r1 <@ K.encodesharedsecret(ss_PQ);
    _r2 <@ NG.encode(ct_T);
    _r3 <@ NG.encode(ek_T);
    _r4 <@ L.get();
    kdf_in <- concat_bs_kem_pq_nss_2_ng_nelem_ng_nss_bs_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel (concat_bs_kem_pq_nss_ng_nelem_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_2_ng_nelem_ng_nss (concat_bs_kem_pq_nss_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_ng_nelem_ng_nss (concat_bs_kem_pq_nss_bs_ng_nss_to_bs_kem_pq_nss_ng_nss _r1 ss_T) _r2) _r3) _r4;
    _r5 <@ H.evaluate(kdf_in);
    return _r5;
  }
}.

section Main.
  (* ===== Reductions ===== *)

  module R_PRG_L (KEM_PQ : KEM_PQ_c.Scheme, NG : NG_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme, Hybrid : Hybrid_c.Scheme, Challenger : G_c.PRGSec_Oracle) = {
    var seed_full : bs_kem_pq_nseed_ng_nseed
    var ctStar : KEMPQCiphertextSpace * NGElementSpace
    proc initialize() : (KEMPQEncapsKeySpace * NGElementSpace) * bs_kdf_nout * (KEMPQCiphertextSpace * NGElementSpace) = {
      var seed_PQ : bs_kem_pq_nseed;
      var seed_T : bs_ng_nseed;
      var _tup : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace;
      var ek_PQ : KEMPQEncapsKeySpace;
      var dk_PQ : KEMPQDecapsKeySpace;
      var dk_T : NGScalarSpace;
      var _r0 : NGElementSpace;
      var ek_T : NGElementSpace;
      var _tup_0 : bs_kem_pq_nss * KEMPQCiphertextSpace;
      var ss_PQ : bs_kem_pq_nss;
      var ct_PQ : KEMPQCiphertextSpace;
      var seed_E : bs_ng_nseed;
      var sk_E : NGScalarSpace;
      var _r1 : NGElementSpace;
      var ct_T : NGElementSpace;
      var _r2 : NGElementSpace;
      var ss_T : bs_ng_nss;
      var _r3 : bs_kem_pq_nss;
      var _r4 : bs_ng_nelem;
      var _r5 : bs_ng_nelem;
      var _r6 : bs_nlabel;
      var kdf_in : bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel;
      var ss : bs_kdf_nout;
      seed_full <@ Challenger.query();
      seed_PQ <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_kem_pq_nseed seed_full 0 kem_pq_nseed;
      seed_T <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_ng_nseed seed_full kem_pq_nseed (kem_pq_nseed + ng_nseed);
      _tup <@ KEM_PQ.derivekeypair(seed_PQ);
      ek_PQ <- _tup.`1;
      dk_PQ <- _tup.`2;
      dk_T <@ NG.randomscalar(seed_T);
      _r0 <@ NG.generator();
      ek_T <@ NG.exp(_r0, dk_T);
      _tup_0 <@ KEM_PQ.encaps(ek_PQ);
      ss_PQ <- _tup_0.`1;
      ct_PQ <- _tup_0.`2;
      seed_E <$ dbs_ng_nseed;
      sk_E <@ NG.randomscalar(seed_E);
      _r1 <@ NG.generator();
      ct_T <@ NG.exp(_r1, sk_E);
      _r2 <@ NG.exp(ek_T, sk_E);
      ss_T <@ NG.elementtosharedsecret(_r2);
      _r3 <@ KEM_PQ.encodesharedsecret(ss_PQ);
      _r4 <@ NG.encode(ct_T);
      _r5 <@ NG.encode(ek_T);
      _r6 <@ L.get();
      kdf_in <- concat_bs_kem_pq_nss_2_ng_nelem_ng_nss_bs_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel (concat_bs_kem_pq_nss_ng_nelem_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_2_ng_nelem_ng_nss (concat_bs_kem_pq_nss_ng_nss_bs_ng_nelem_to_bs_kem_pq_nss_ng_nelem_ng_nss (concat_bs_kem_pq_nss_bs_ng_nss_to_bs_kem_pq_nss_ng_nss _r3 ss_T) _r4) _r5) _r6;
      ss <@ H.evaluate(kdf_in);
      ctStar <- (ct_PQ, ct_T);
      return ((ek_PQ, ek_T), ss, ctStar);
    }
    proc decaps(ct : KEMPQCiphertextSpace * NGElementSpace) : bs_kdf_nout option = {
      var _r7 : bs_kdf_nout option;
      var seed_PQ : bs_kem_pq_nseed;
      var seed_T : bs_ng_nseed;
      var _tup : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace;
      var ek_unused : KEMPQEncapsKeySpace;
      var dk_PQ : KEMPQDecapsKeySpace;
      var dk_T : NGScalarSpace;
      var ct_PQ : KEMPQCiphertextSpace;
      var ct_T : NGElementSpace;
      var dec_ss_PQ : bs_kem_pq_nss;
      var _r0 : NGElementSpace;
      var dec_ss_T : bs_ng_nss;
      var _r1 : bs_kem_pq_nss;
      var _r2 : bs_ng_nelem;
      var _r3 : NGElementSpace;
      var _r4 : NGElementSpace;
      var _r5 : bs_ng_nelem;
      var _r6 : bs_nlabel;
      var kdf_in : bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel;
      var _r8 : bs_kdf_nout;
      if (ct = ctStar) {
        _r7 <- None;
      } else {
        seed_PQ <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_kem_pq_nseed seed_full 0 kem_pq_nseed;
        seed_T <- slice_bs_kem_pq_nseed_ng_nseed_to_bs_ng_nseed seed_full kem_pq_nseed (kem_pq_nseed + ng_nseed);
        _tup <@ KEM_PQ.derivekeypair(seed_PQ);
        ek_unused <- _tup.`1;
        dk_PQ <- _tup.`2;
        dk_T <@ NG.randomscalar(seed_T);
        ct_PQ <- ct.`1;
        ct_T <- ct.`2;
        dec_ss_PQ <@ KEM_PQ.decaps(dk_PQ, ct_PQ);
        _r0 <@ NG.exp(ct_T, dk_T);
        dec_ss_T <@ NG.elementtosharedsecret(_r0);
        _r1 <@ KEM_PQ.encodesharedsecret(dec_ss_PQ);
        _r2 <@ NG.encode(ct_T);
        _r3 <@ NG.generator();
        _r4 <@ NG.exp(_r3, dk_T);
