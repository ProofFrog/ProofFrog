// Positive control for DupOrder.game: d and r always hold the same value,
// and every oracle adds z to r and then to d, in the same order. Remove
// Duplicate Fields must still merge them: both oracles hold an equal second
// write `d = d + z;`, and each is deleted from its own oracle. Right is the
// merged game.
// Sound engine: Proof Succeeded!
Game Left(Int q) {
    ModInt<q> d;
    ModInt<q> r;
    Void Initialize() {
        d <- ModInt<q>;
        r = d;
    }
    Void A0(ModInt<q> z) {
        r = r + z;
        d = d + z;
    }
    Void A1(ModInt<q> z) {
        r = r + z;
        d = d + z;
    }
    ModInt<q> Get() {
        return d;
    }
}

Game Right(Int q) {
    ModInt<q> d;
    Void Initialize() {
        d <- ModInt<q>;
    }
    Void A0(ModInt<q> z) {
        d = d + z;
    }
    Void A1(ModInt<q> z) {
        d = d + z;
    }
    ModInt<q> Get() {
        return d;
    }
}

export as SameOrder;
