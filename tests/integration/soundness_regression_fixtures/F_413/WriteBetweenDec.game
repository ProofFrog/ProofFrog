// F-413 control: Dec adds c to S between the test and its complement, so
// the second test reads the new S and fails for a c not encrypted before:
// Dec(c) for a fresh c returns c in Left and None in Right.
// Distinguishable.

Game Left(Int n) {
    Set<BitString<n>> S;
    BitString<n> Enc(BitString<n> m) {
        S = S union {m};
        return m;
    }
    BitString<n>? Dec(BitString<n> c) {
        if (c in S) {
            return None;
        }
        S = S union {c};
        if (!(c in S)) {
            return None;
        }
        return c;
    }
}

Game Right(Int n) {
    Set<BitString<n>> S;
    BitString<n> Enc(BitString<n> m) {
        S = S union {m};
        return m;
    }
    BitString<n>? Dec(BitString<n> c) {
        if (c in S) {
            return None;
        }
        S = S union {c};
        return None;
    }
}

export as WriteBetweenDec;
