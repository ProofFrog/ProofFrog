    exists* (glob F){1}, (__a1__){1}, (__a2__){1}; elim* => g0 a0_0 a0_1.
    call{1} (F_evaluate_det g0 a0_0 a0_1).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__, __a2__, __a3__, __a4__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__, __a2__, __a3__, __a4__, __a5__}).
    auto.
