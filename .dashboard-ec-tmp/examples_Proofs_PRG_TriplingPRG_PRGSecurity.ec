  (* transform: Split Uniform Samples (bucket=canned) *)
  lemma micro_2_left_6 :
    equiv [ Step_2L_state_6(G).query ~ Step_2L_state_7(G).query :
            ={glob G} ==> ={res, glob G} ].
  proof.
    (* resolution: synth-param *)
    proc.
    seq 1 2 : (={glob G} /\
               slice_bs_2_lambda_to_bs_lambda __a0__{1} 0 lambda = __a0___0{2} /\
               slice_bs_2_lambda_to_bs_lambda __a0__{1} lambda (2*lambda) = __a0___1{2}).
    - (* HEAD: sample step. *)
      transitivity {1}
        { __a0__ <$ dmap (dbs_lambda `*` dbs_lambda)
                              (fun (p : bs_lambda * bs_lambda) =>
                                 concat_bs_lambda_bs_lambda_to_bs_2_lambda p.`1 p.`2); }
        (={glob G} ==> ={glob G} /\ ={__a0__})
        (={glob G} ==>
         ={glob G} /\
         slice_bs_2_lambda_to_bs_lambda __a0__{1} 0 lambda = __a0___0{2} /\     slice_bs_2_lambda_to_bs_lambda __a0__{1} lambda (2*lambda) = __a0___1{2}).
      + by smt().
      + by smt().
      + rnd (fun (z : bs_2_lambda) => z) (fun (z : bs_2_lambda) => z).
        skip => />.
        smt(dbs_2_lambda_split_bs_lambda_bs_lambda).
      + rndsem*{2} 0.
        rnd (fun (z : bs_2_lambda) =>
               (slice_bs_2_lambda_to_bs_lambda z 0 lambda,
                slice_bs_2_lambda_to_bs_lambda z lambda (2*lambda)))
            (fun (p : bs_lambda * bs_lambda) => concat_bs_lambda_bs_lambda_to_bs_2_lambda p.`1 p.`2).
        skip => />.
        split; first by smt(slice_concat_left_bs_lambda_bs_lambda_bs_2_lambda slice_concat_right_bs_lambda_bs_lambda_bs_2_lambda).
        move => _.
        split.
        * move => p Hp.
          rewrite dmap1E /(\o) /pred1 /=.
          rewrite -(dmap_dprodE dbs_lambda dbs_lambda
                                (fun q : bs_lambda * bs_lambda => q)) dmap_id.
          apply mu_eq => q /=.
          smt(slice_concat_left_bs_lambda_bs_lambda_bs_2_lambda slice_concat_right_bs_lambda_bs_lambda_bs_2_lambda concat_slices_id_bs_lambda_bs_lambda_bs_2_lambda).
        * move => _ z Hz; split.
          - rewrite -(dmap_dprodE dbs_lambda dbs_lambda
                                  (fun p : bs_lambda * bs_lambda => p)) dmap_id.
            rewrite supp_dprod /=.
            smt(dbs_lambda_full dbs_lambda_full).
          - by smt(slice_concat_left_bs_lambda_bs_lambda_bs_2_lambda slice_concat_right_bs_lambda_bs_lambda_bs_2_lambda).
    - (* TAIL: invariant supplies the slice/var equalities so the call args match  *)
      (* and the return concats agree. *)
      call (_: true).
      auto => /> *.
  qed.

