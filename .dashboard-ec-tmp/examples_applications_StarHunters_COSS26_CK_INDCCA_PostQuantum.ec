      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      rsp1 <@ KEM1.encaps(pk);
      ct1Star <- rsp1.`2;
      _tup_1 <@ KEM2.encaps(pk2);
      ss2 <- _tup_1.`1;
      ct2Star <- _tup_1.`2;
      bct2 <- ct2Star;
      bpk2 <- pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ Challenger.lookup(ss2, label);
      return ((pk, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
