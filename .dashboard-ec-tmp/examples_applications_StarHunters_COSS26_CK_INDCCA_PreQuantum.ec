    var ss1Star : SS1Space
    var ss2Star : bs_ss2len
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space * CT1Space * SS1Space;
      var pk1 : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var rsp2 : SS2Space * CT2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      _tup <@ Challenger.initialize();
      pk1 <- _tup.`1;
      sk1 <- _tup.`2;
      ct1Star <- _tup.`3;
      ss1Star <- _tup.`4;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      rsp2 <@ KEM2.encaps(pk2);
      ct2Star <- rsp2.`2;
      ss2Star <$ dbs_ss2len;
      bct2 <- ct2Star;
      bpk2 <- pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ F.evaluate(ss1Star, ss2Star, label);
