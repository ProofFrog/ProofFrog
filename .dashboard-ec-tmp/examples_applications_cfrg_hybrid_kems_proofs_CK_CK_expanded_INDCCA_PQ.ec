    + move => [x1 y1] [x2 y2] _ _ /= heq.
      have hx : x1 = x2 by rewrite -(slice_concat_left_bs_kem_t_nct_kem_t_nek_bs_nlabel_bs_kem_t_nct_kem_t_nek_nlabel x1 y1) -(slice_concat_left_bs_kem_t_nct_kem_t_nek_bs_nlabel_bs_kem_t_nct_kem_t_nek_nlabel x2 y2) heq.
      have hy : y1 = y2 by rewrite -(slice_concat_right_bs_kem_t_nct_kem_t_nek_bs_nlabel_bs_kem_t_nct_kem_t_nek_nlabel x1 y1) -(slice_concat_right_bs_kem_t_nct_kem_t_nek_bs_nlabel_bs_kem_t_nct_kem_t_nek_nlabel x2 y2) heq.
      by rewrite hx hy.
    by apply: dprod_uni; apply: funi_uni; [exact dbs_kem_t_nct_kem_t_nek_fu | exact dbs_nlabel_fu].
  apply: dmap_ll; rewrite dprod_ll.
  by split; [exact dbs_kem_t_nct_kem_t_nek_ll | exact dbs_nlabel_ll].
qed.

lemma size_cat_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek :
  forall (a : bs_kem_t_nct) (b : bs_kem_t_nek),
  size (BW_bs_kem_t_nct.ofword a ++ BW_bs_kem_t_nek.ofword b) = kem_t_nct + kem_t_nek.
proof.
  move => a b.
  rewrite size_cat BW_bs_kem_t_nct.size_word BW_bs_kem_t_nek.size_word.
  by smt().
qed.

lemma slice_concat_left_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek :
  forall (a : bs_kem_t_nct) (b : bs_kem_t_nek),
  slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nct (concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek a b) 0 kem_t_nct = a.
proof.
  move => a b.
  rewrite /slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nct /concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek (BW_bs_kem_t_nct_kem_t_nek.ofwordK _ (size_cat_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek a b)) drop0.
  have ->: kem_t_nct - 0 = kem_t_nct by smt().
  by rewrite (take_size_cat _ _ _ (BW_bs_kem_t_nct.size_word a)) BW_bs_kem_t_nct.mkwordK.
qed.

lemma slice_concat_right_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek :
  forall (a : bs_kem_t_nct) (b : bs_kem_t_nek),
  slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nek (concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek a b) kem_t_nct (kem_t_nct + kem_t_nek) = b.
proof.
  move => a b.
  rewrite /slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nek /concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek (BW_bs_kem_t_nct_kem_t_nek.ofwordK _ (size_cat_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek a b)).
  have ->: (kem_t_nct + kem_t_nek) - kem_t_nct = kem_t_nek by smt().
  rewrite (drop_size_cat _ _ _ (BW_bs_kem_t_nct.size_word a)).
  have hb : size (BW_bs_kem_t_nek.ofword b) = kem_t_nek by exact BW_bs_kem_t_nek.size_word.
  by rewrite -hb take_size BW_bs_kem_t_nek.mkwordK.
qed.

lemma concat_slices_id_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek :
  forall (s : bs_kem_t_nct_kem_t_nek),
  concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek (slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nct s 0 kem_t_nct) (slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nek s kem_t_nct (kem_t_nct + kem_t_nek)) = s.
proof.
  move => s.
  have hs : size (BW_bs_kem_t_nct_kem_t_nek.ofword s) = kem_t_nct + kem_t_nek by exact BW_bs_kem_t_nct_kem_t_nek.size_word.
  rewrite /concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek /slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nct /slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nek drop0.
  have ->: kem_t_nct - 0 = kem_t_nct by smt().
  have ->: (kem_t_nct + kem_t_nek) - kem_t_nct = kem_t_nek by smt().
  have h1 : size (take kem_t_nct (BW_bs_kem_t_nct_kem_t_nek.ofword s)) = kem_t_nct
    by rewrite size_take; smt(gt0_kem_t_nct gt0_kem_t_nek).
  have hd : size (drop kem_t_nct (BW_bs_kem_t_nct_kem_t_nek.ofword s)) = kem_t_nek
    by rewrite size_drop; smt(gt0_kem_t_nct gt0_kem_t_nek).
  have ht : take kem_t_nek (drop kem_t_nct (BW_bs_kem_t_nct_kem_t_nek.ofword s))
          = drop kem_t_nct (BW_bs_kem_t_nct_kem_t_nek.ofword s)
    by rewrite take_oversize // hd.
  have h2 : size (take kem_t_nek (drop kem_t_nct (BW_bs_kem_t_nct_kem_t_nek.ofword s))) = kem_t_nek
    by rewrite ht hd.
  rewrite (BW_bs_kem_t_nct.ofwordK _ h1) (BW_bs_kem_t_nek.ofwordK _ h2) ht.
  by rewrite cat_take_drop BW_bs_kem_t_nct_kem_t_nek.mkwordK.
qed.

lemma dbs_kem_t_nct_kem_t_nek_split_bs_kem_t_nct_bs_kem_t_nek :
  dbs_kem_t_nct_kem_t_nek =
  dmap (dbs_kem_t_nct `*` dbs_kem_t_nek)
       (fun (p : bs_kem_t_nct * bs_kem_t_nek) => concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek p.`1 p.`2).
proof.
  apply: eq_funi_ll.
  + exact dbs_kem_t_nct_kem_t_nek_fu.
  + exact dbs_kem_t_nct_kem_t_nek_ll.
  + apply: is_full_funiform.
    + apply: dmap_fu_in => w.
      exists (slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nct w 0 kem_t_nct, slice_bs_kem_t_nct_kem_t_nek_to_bs_kem_t_nek w kem_t_nct (kem_t_nct + kem_t_nek)).
      rewrite supp_dprod /=; split.
      + by split; [exact dbs_kem_t_nct_full | exact dbs_kem_t_nek_full].
      by rewrite concat_slices_id_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek.
    apply: dmap_uni_in_inj.
    + move => [x1 y1] [x2 y2] _ _ /= heq.
      have hx : x1 = x2 by rewrite -(slice_concat_left_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek x1 y1) -(slice_concat_left_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek x2 y2) heq.
      have hy : y1 = y2 by rewrite -(slice_concat_right_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek x1 y1) -(slice_concat_right_bs_kem_t_nct_bs_kem_t_nek_bs_kem_t_nct_kem_t_nek x2 y2) heq.
      by rewrite hx hy.
    by apply: dprod_uni; apply: funi_uni; [exact dbs_kem_t_nct_fu | exact dbs_kem_t_nek_fu].
  apply: dmap_ll; rewrite dprod_ll.
  by split; [exact dbs_kem_t_nct_ll | exact dbs_kem_t_nek_ll].
qed.

lemma size_cat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel :
  forall (a : bs_kem_pq_nss_kem_t_nss) (b : bs_kem_t_nct_kem_t_nek_nlabel),
  size (BW_bs_kem_pq_nss_kem_t_nss.ofword a ++ BW_bs_kem_t_nct_kem_t_nek_nlabel.ofword b) = kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss + nlabel.
proof.
  move => a b.
  rewrite size_cat BW_bs_kem_pq_nss_kem_t_nss.size_word BW_bs_kem_t_nct_kem_t_nek_nlabel.size_word.
  by smt().
qed.

lemma slice_concat_left_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel :
  forall (a : bs_kem_pq_nss_kem_t_nss) (b : bs_kem_t_nct_kem_t_nek_nlabel),
  slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel a b) 0 (kem_pq_nss + kem_t_nss) = a.
proof.
  move => a b.
  rewrite /slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nss /concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofwordK _ (size_cat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel a b)) drop0.
  have ->: (kem_pq_nss + kem_t_nss) - 0 = (kem_pq_nss + kem_t_nss) by smt().
  by rewrite (take_size_cat _ _ _ (BW_bs_kem_pq_nss_kem_t_nss.size_word a)) BW_bs_kem_pq_nss_kem_t_nss.mkwordK.
qed.

lemma slice_concat_right_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel :
  forall (a : bs_kem_pq_nss_kem_t_nss) (b : bs_kem_t_nct_kem_t_nek_nlabel),
  slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_t_nct_kem_t_nek_nlabel (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel a b) (kem_pq_nss + kem_t_nss) (kem_pq_nss + kem_t_nss + kem_t_nct + kem_t_nek + nlabel) = b.
proof.
  move => a b.
  rewrite /slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_t_nct_kem_t_nek_nlabel /concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofwordK _ (size_cat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel a b)).
  have ->: (kem_pq_nss + kem_t_nss + kem_t_nct + kem_t_nek + nlabel) - (kem_pq_nss + kem_t_nss) = (kem_t_nct + kem_t_nek + nlabel) by smt().
  rewrite (drop_size_cat _ _ _ (BW_bs_kem_pq_nss_kem_t_nss.size_word a)).
  have hb : size (BW_bs_kem_t_nct_kem_t_nek_nlabel.ofword b) = (kem_t_nct + kem_t_nek + nlabel) by exact BW_bs_kem_t_nct_kem_t_nek_nlabel.size_word.
  by rewrite -hb take_size BW_bs_kem_t_nct_kem_t_nek_nlabel.mkwordK.
qed.

lemma concat_slices_id_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel :
  forall (s : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel),
  concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nss s 0 (kem_pq_nss + kem_t_nss)) (slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_t_nct_kem_t_nek_nlabel s (kem_pq_nss + kem_t_nss) (kem_pq_nss + kem_t_nss + kem_t_nct + kem_t_nek + nlabel)) = s.
proof.
  move => s.
  have hs : size (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s) = kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss + nlabel by exact BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.size_word.
  rewrite /concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel /slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nss /slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_t_nct_kem_t_nek_nlabel drop0.
  have ->: (kem_pq_nss + kem_t_nss) - 0 = (kem_pq_nss + kem_t_nss) by smt().
  have ->: (kem_pq_nss + kem_t_nss + kem_t_nct + kem_t_nek + nlabel) - (kem_pq_nss + kem_t_nss) = (kem_t_nct + kem_t_nek + nlabel) by smt().
  have h1 : size (take (kem_pq_nss + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s)) = (kem_pq_nss + kem_t_nss)
    by rewrite size_take; smt(gt0_kem_pq_nss gt0_kem_t_nct gt0_kem_t_nek gt0_kem_t_nss gt0_nlabel).
  have hd : size (drop (kem_pq_nss + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s)) = (kem_t_nct + kem_t_nek + nlabel)
    by rewrite size_drop; smt(gt0_kem_pq_nss gt0_kem_t_nct gt0_kem_t_nek gt0_kem_t_nss gt0_nlabel).
  have ht : take (kem_t_nct + kem_t_nek + nlabel) (drop (kem_pq_nss + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s))
          = drop (kem_pq_nss + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s)
    by rewrite take_oversize // hd.
  have h2 : size (take (kem_t_nct + kem_t_nek + nlabel) (drop (kem_pq_nss + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s))) = (kem_t_nct + kem_t_nek + nlabel)
    by rewrite ht hd.
  rewrite (BW_bs_kem_pq_nss_kem_t_nss.ofwordK _ h1) (BW_bs_kem_t_nct_kem_t_nek_nlabel.ofwordK _ h2) ht.
  by rewrite cat_take_drop BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.mkwordK.
qed.

lemma dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_split_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel :
  dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel =
  dmap (dbs_kem_pq_nss_kem_t_nss `*` dbs_kem_t_nct_kem_t_nek_nlabel)
       (fun (p : bs_kem_pq_nss_kem_t_nss * bs_kem_t_nct_kem_t_nek_nlabel) => concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel p.`1 p.`2).
proof.
  apply: eq_funi_ll.
  + exact dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_fu.
  + exact dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_ll.
  + apply: is_full_funiform.
    + apply: dmap_fu_in => w.
      exists (slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nss w 0 (kem_pq_nss + kem_t_nss), slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_t_nct_kem_t_nek_nlabel w (kem_pq_nss + kem_t_nss) (kem_pq_nss + kem_t_nss + kem_t_nct + kem_t_nek + nlabel)).
      rewrite supp_dprod /=; split.
      + by split; [exact dbs_kem_pq_nss_kem_t_nss_full | exact dbs_kem_t_nct_kem_t_nek_nlabel_full].
      by rewrite concat_slices_id_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.
    apply: dmap_uni_in_inj.
    + move => [x1 y1] [x2 y2] _ _ /= heq.
      have hx : x1 = x2 by rewrite -(slice_concat_left_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x1 y1) -(slice_concat_left_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x2 y2) heq.
      have hy : y1 = y2 by rewrite -(slice_concat_right_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x1 y1) -(slice_concat_right_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x2 y2) heq.
      by rewrite hx hy.
    by apply: dprod_uni; apply: funi_uni; [exact dbs_kem_pq_nss_kem_t_nss_fu | exact dbs_kem_t_nct_kem_t_nek_nlabel_fu].
  apply: dmap_ll; rewrite dprod_ll.
  by split; [exact dbs_kem_pq_nss_kem_t_nss_ll | exact dbs_kem_t_nct_kem_t_nek_nlabel_ll].
qed.

(* ===== Abstract theory: primitive + security games + assumption ===== *)

abstract theory KEM_Theory.
  type encapskey.

  type decapskey.

  type sharedsecret.

  type ciphertext.

  type bs_Nseed_t.

  op zero_Nseed_t : bs_Nseed_t.

  type bs_Nss_t.

  op zero_Nss_t : bs_Nss_t.

  type bs_Nct_t.

  op zero_Nct_t : bs_Nct_t.

  type bs_Nek_t.

  op zero_Nek_t : bs_Nek_t.

  op dsharedsecret : sharedsecret distr.

  axiom dsharedsecret_ll : is_lossless dsharedsecret.

  axiom dsharedsecret_fu : is_funiform dsharedsecret.

  axiom dsharedsecret_full : is_full dsharedsecret.

  module type Scheme = {
    proc keygen() : encapskey * decapskey
    proc derivekeypair(seed : bs_Nseed_t) : encapskey * decapskey
    proc encaps(ek : encapskey) : sharedsecret * ciphertext
    proc decaps(dk : decapskey, ct : ciphertext) : sharedsecret
    proc encodesharedsecret(ss : sharedsecret) : bs_Nss_t
    proc encodeciphertext(ct : ciphertext) : bs_Nct_t
    proc encodeencapskey(ek : encapskey) : bs_Nek_t
  }.

  op ev_derivekeypair : bs_Nseed_t -> encapskey * decapskey.

  op ev_decaps : decapskey -> ciphertext -> sharedsecret.

  op ev_encodesharedsecret : sharedsecret -> bs_Nss_t.

  op ev_encodeciphertext : ciphertext -> bs_Nct_t.

  op ev_encodeencapskey : encapskey -> bs_Nek_t.

  module type KEM_INDCCA_Oracle = {
    proc initialize() : encapskey * sharedsecret * ciphertext
    proc decaps(ct : ciphertext) : sharedsecret option
  }.

  module KEM_INDCCA_Real (K : Scheme) : KEM_INDCCA_Oracle = {
    var dk : decapskey
    var ctStar : ciphertext
    proc initialize() : encapskey * sharedsecret * ciphertext = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ssStar : sharedsecret;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ssStar <- _tup_0.`1;
      ctStar <- _tup_0.`2;
      return (ek, ssStar, ctStar);
    }
    proc decaps(ct : ciphertext) : sharedsecret option = {
      var _r0 : sharedsecret option;
      var _r1 : sharedsecret;
      if (ct = ctStar) {
        _r0 <- None;
      } else {
        _r1 <@ K.decaps(dk, ct);
        _r0 <- Some (_r1);
      }
      return _r0;
    }
  }.

  module KEM_INDCCA_Random (K : Scheme) : KEM_INDCCA_Oracle = {
    var dk : decapskey
    var ctStar : ciphertext
    proc initialize() : encapskey * sharedsecret * ciphertext = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss_unused : sharedsecret;
      var ssStar : sharedsecret;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ss_unused <- _tup_0.`1;
      ctStar <- _tup_0.`2;
      ssStar <$ dsharedsecret;
      return (ek, ssStar, ctStar);
    }
    proc decaps(ct : ciphertext) : sharedsecret option = {
      var _r0 : sharedsecret option;
      var _r1 : sharedsecret;
      if (ct = ctStar) {
        _r0 <- None;
      } else {
        _r1 <@ K.decaps(dk, ct);
        _r0 <- Some (_r1);
      }
      return _r0;
    }
  }.

  module type KEM_INDCCA_Adv (O : KEM_INDCCA_Oracle) = {
    proc distinguish(pk : encapskey * sharedsecret * ciphertext) : bool {O.decaps}
  }.

  module type KEMCorrectnessWithDK_Oracle = {
    proc compute() : encapskey * decapskey * ciphertext * sharedsecret * sharedsecret
  }.

  module KEMCorrectnessWithDK_FromDecaps (K : Scheme) : KEMCorrectnessWithDK_Oracle = {
    proc compute() : encapskey * decapskey * ciphertext * sharedsecret * sharedsecret = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var dk : decapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ct : ciphertext;
      var ss_d : sharedsecret;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ss <- _tup_0.`1;
      ct <- _tup_0.`2;
      ss_d <@ K.decaps(dk, ct);
      return (ek, dk, ct, ss, ss_d);
    }
  }.

  module KEMCorrectnessWithDK_FromEncaps (K : Scheme) : KEMCorrectnessWithDK_Oracle = {
    proc compute() : encapskey * decapskey * ciphertext * sharedsecret * sharedsecret = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var dk : decapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ct : ciphertext;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ss <- _tup_0.`1;
      ct <- _tup_0.`2;
      return (ek, dk, ct, ss, ss);
    }
  }.

  module type KEMCorrectnessWithDK_Adv (O : KEMCorrectnessWithDK_Oracle) = {
    proc distinguish() : bool
  }.

  module Game_KEM_INDCCA_Real (Em : Scheme, A : KEM_INDCCA_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : encapskey * sharedsecret * ciphertext;
      pk <@ KEM_INDCCA_Real(Em).initialize();
      b <@ A(KEM_INDCCA_Real(Em)).distinguish(pk);
      return b;
    }
  }.

  module Game_KEM_INDCCA_Random (Em : Scheme, A : KEM_INDCCA_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : encapskey * sharedsecret * ciphertext;
      pk <@ KEM_INDCCA_Random(Em).initialize();
      b <@ A(KEM_INDCCA_Random(Em)).distinguish(pk);
      return b;
    }
  }.

  op eps_KEM_INDCCA : real.

  axiom eps_KEM_INDCCA_pos : 0%r <= eps_KEM_INDCCA.

  axiom KEM_INDCCA_advantage (Em <: Scheme) (A <: KEM_INDCCA_Adv) &m :
    `| Pr[Game_KEM_INDCCA_Real(Em, A).main() @ &m : res] - Pr[Game_KEM_INDCCA_Random(Em, A).main() @ &m : res] | <= eps_KEM_INDCCA.

  module Game_KEMCorrectnessWithDK_FromDecaps (Em : Scheme, A : KEMCorrectnessWithDK_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectnessWithDK_FromDecaps(Em)).distinguish();
      return b;
    }
  }.

  module Game_KEMCorrectnessWithDK_FromEncaps (Em : Scheme, A : KEMCorrectnessWithDK_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectnessWithDK_FromEncaps(Em)).distinguish();
      return b;
    }
  }.

  op eps_KEMCorrectnessWithDK : real.

  axiom eps_KEMCorrectnessWithDK_pos : 0%r <= eps_KEMCorrectnessWithDK.

  axiom KEMCorrectnessWithDK_advantage (Em <: Scheme) (A <: KEMCorrectnessWithDK_Adv) &m :
    `| Pr[Game_KEMCorrectnessWithDK_FromDecaps(Em, A).main() @ &m : res] - Pr[Game_KEMCorrectnessWithDK_FromEncaps(Em, A).main() @ &m : res] | <= eps_KEMCorrectnessWithDK.
end KEM_Theory.

(* ===== Foreign primitive theory: PRG_Theory ===== *)

abstract theory PRG_Theory.
  type bs_lambda_t.

  op zero_lambda_t : bs_lambda_t.

  type bs_lambda_stretch_t.

  op zero_lambda_stretch_t : bs_lambda_stretch_t.

  module type Scheme = {
    proc evaluate(x : bs_lambda_t) : bs_lambda_stretch_t
  }.

  op ev_evaluate : bs_lambda_t -> bs_lambda_stretch_t.
end PRG_Theory.

(* ===== Foreign primitive theory: KDF_Theory ===== *)

abstract theory KDF_Theory.
  type bs_Nin_t.

  op zero_Nin_t : bs_Nin_t.

  type bs_Nout_t.

  op zero_Nout_t : bs_Nout_t.

  type bs_Nss2_t.

  op zero_Nss2_t : bs_Nss2_t.

  type bs_Nin_Nss1_Nss2_t.

  op zero_Nin_Nss1_Nss2_t : bs_Nin_Nss1_Nss2_t.

  type bs_Nss1_t.

  op zero_Nss1_t : bs_Nss1_t.

  type bs_Nss1_Nss2_t.

  op zero_Nss1_Nss2_t : bs_Nss1_Nss2_t.

  op dbs_Nss1_t : bs_Nss1_t distr.

  axiom dbs_Nss1_t_ll : is_lossless dbs_Nss1_t.

  axiom dbs_Nss1_t_fu : is_funiform dbs_Nss1_t.

  axiom dbs_Nss1_t_full : is_full dbs_Nss1_t.

  op dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t : (bs_Nss2_t * bs_Nin_Nss1_Nss2_t -> bs_Nout_t) distr.

  axiom dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t_ll : is_lossless dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t.

  axiom dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t_fu : is_funiform dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t.

  axiom dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t_full : is_full dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t.

  op slice_bs_Nin_t_to_bs_Nss1_Nss2_t : bs_Nin_t -> int -> int -> bs_Nss1_Nss2_t.

  op slice_bs_Nin_t_to_bs_Nin_Nss1_Nss2_t : bs_Nin_t -> int -> int -> bs_Nin_Nss1_Nss2_t.

  op slice_bs_Nss1_Nss2_t_to_bs_Nss1_t : bs_Nss1_Nss2_t -> int -> int -> bs_Nss1_t.

  op slice_bs_Nss1_Nss2_t_to_bs_Nss2_t : bs_Nss1_Nss2_t -> int -> int -> bs_Nss2_t.

  op concat_bs_Nss1_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nin_t : bs_Nss1_Nss2_t -> bs_Nin_Nss1_Nss2_t -> bs_Nin_t.

  op concat_bs_Nss1_t_bs_Nss2_t_to_bs_Nss1_Nss2_t : bs_Nss1_t -> bs_Nss2_t -> bs_Nss1_Nss2_t.

  module type Scheme = {
    proc evaluate(input : bs_Nin_t) : bs_Nout_t
  }.

  op ev_evaluate : bs_Nin_t -> bs_Nout_t.

  module type KDFFirstKeyPRF_Oracle = {
    proc initialize() : unit
    proc lookup(key2 : bs_Nss2_t, rest : bs_Nin_Nss1_Nss2_t) : bs_Nout_t
  }.

  module KDFFirstKeyPRF_Real (H : Scheme) : KDFFirstKeyPRF_Oracle = {
    var k1 : bs_Nss1_t
    proc initialize() : unit = {
      k1 <$ dbs_Nss1_t;
    }
    proc lookup(key2 : bs_Nss2_t, rest : bs_Nin_Nss1_Nss2_t) : bs_Nout_t = {
      var _r0 : bs_Nout_t;
      _r0 <@ H.evaluate(concat_bs_Nss1_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nin_t (concat_bs_Nss1_t_bs_Nss2_t_to_bs_Nss1_Nss2_t k1 key2) rest);
      return _r0;
    }
  }.

  module KDFFirstKeyPRF_Random (H : Scheme) : KDFFirstKeyPRF_Oracle = {
    var rF : bs_Nss2_t * bs_Nin_Nss1_Nss2_t -> bs_Nout_t
    proc initialize() : unit = {
      rF <$ dfun_bs_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nout_t;
    }
    proc lookup(key2 : bs_Nss2_t, rest : bs_Nin_Nss1_Nss2_t) : bs_Nout_t = {
      return rF (key2, rest);
    }
  }.

  module type KDFFirstKeyPRF_Adv (O : KDFFirstKeyPRF_Oracle) = {
    proc distinguish() : bool {O.lookup}
  }.

  module Game_KDFFirstKeyPRF_Real (Em : Scheme, A : KDFFirstKeyPRF_Adv) = {
    proc main() : bool = {
      var b : bool;
      KDFFirstKeyPRF_Real(Em).initialize();
      b <@ A(KDFFirstKeyPRF_Real(Em)).distinguish();
      return b;
    }
  }.

  module Game_KDFFirstKeyPRF_Random (Em : Scheme, A : KDFFirstKeyPRF_Adv) = {
    proc main() : bool = {
      var b : bool;
      KDFFirstKeyPRF_Random(Em).initialize();
      b <@ A(KDFFirstKeyPRF_Random(Em)).distinguish();
      return b;
    }
  }.

  op eps_KDFFirstKeyPRF : real.

  axiom eps_KDFFirstKeyPRF_pos : 0%r <= eps_KDFFirstKeyPRF.

  axiom KDFFirstKeyPRF_advantage (Em <: Scheme) (A <: KDFFirstKeyPRF_Adv) &m :
    `| Pr[Game_KDFFirstKeyPRF_Real(Em, A).main() @ &m : res] - Pr[Game_KDFFirstKeyPRF_Random(Em, A).main() @ &m : res] | <= eps_KDFFirstKeyPRF.
end KDF_Theory.

(* ===== Foreign primitive theory: Label_Theory ===== *)

abstract theory Label_Theory.
  type bs_Nlabel_t.

  op zero_Nlabel_t : bs_Nlabel_t.

  module type Scheme = {
    proc get() : bs_Nlabel_t
  }.

  op ev_get : bs_Nlabel_t.
end Label_Theory.

(* ===== Theory instantiation ===== *)

clone KEM_Theory as KEM_PQ_c with
  type sharedsecret <- bs_kem_pq_nss,
  type ciphertext <- KEMPQCiphertextSpace,
  type encapskey <- KEMPQEncapsKeySpace,
  type decapskey <- KEMPQDecapsKeySpace,
  type bs_Nseed_t <- bs_kem_pq_nseed,
  type bs_Nss_t <- bs_kem_pq_nss,
  type bs_Nct_t <- bs_kem_pq_nct,
  type bs_Nek_t <- bs_kem_pq_nek,
  op dsharedsecret <- dbs_kem_pq_nss.

clone KEM_Theory as KEM_T_c with
  type sharedsecret <- KEMTSharedSecretSpace,
  type ciphertext <- KEMTCiphertextSpace,
  type encapskey <- KEMTEncapsKeySpace,
  type decapskey <- KEMTDecapsKeySpace,
  type bs_Nseed_t <- bs_kem_t_nseed,
  type bs_Nss_t <- bs_kem_t_nss,
  type bs_Nct_t <- bs_kem_t_nct,
  type bs_Nek_t <- bs_kem_t_nek,
  op dsharedsecret <- dKEMTSharedSecretSpace.

clone PRG_Theory as G_c with
  type bs_lambda_t <- bs_kem_pq_nseed,
  type bs_lambda_stretch_t <- bs_kem_pq_nseed_prg_stretch.

clone KDF_Theory as H_c with
  type bs_Nin_t <- bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel,
  type bs_Nout_t <- bs_kdf_nout,
  type bs_Nss2_t <- bs_kem_t_nss,
  type bs_Nin_Nss1_Nss2_t <- bs_kem_t_nct_kem_t_nek_nlabel,
  type bs_Nss1_t <- bs_kem_pq_nss,
  type bs_Nss1_Nss2_t <- bs_kem_pq_nss_kem_t_nss,
  op dbs_Nss1_t <- dbs_kem_pq_nss,
  op concat_bs_Nss1_Nss2_t_bs_Nin_Nss1_Nss2_t_to_bs_Nin_t <- concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_kem_t_nek_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel,
  op concat_bs_Nss1_t_bs_Nss2_t_to_bs_Nss1_Nss2_t <- concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss.

clone Label_Theory as L_c with
  type bs_Nlabel_t <- bs_nlabel.

clone KEM_Theory as Hybrid_c with
  type sharedsecret <- bs_kdf_nout,
  type ciphertext <- KEMPQCiphertextSpace * KEMTCiphertextSpace,
  type encapskey <- KEMPQEncapsKeySpace * KEMTEncapsKeySpace,
  type decapskey <- KEMPQDecapsKeySpace * KEMTDecapsKeySpace * KEMTEncapsKeySpace,
  type bs_Nseed_t <- bs_kem_pq_nseed,
  type bs_Nss_t <- bs_kdf_nout,
  type bs_Nct_t <- bs_kem_pq_nct_kem_t_nct,
  type bs_Nek_t <- bs_kem_pq_nek_kem_t_nek,
  op dsharedsecret <- dbs_kdf_nout.

(* ===== Per-clone distribution axioms ===== *)

lemma KEM_PQ_dbs_kem_pq_nss_funi :
  is_funiform dbs_kem_pq_nss.
proof.
  exact dbs_kem_pq_nss_fu.
qed.

lemma KEM_PQ_dbs_kem_pq_nss_ll :
  is_lossless dbs_kem_pq_nss.
proof.
  exact dbs_kem_pq_nss_ll.
qed.

lemma KEM_T_dKEMTSharedSecretSpace_funi :
  is_funiform dKEMTSharedSecretSpace.
proof.
  exact dKEMTSharedSecretSpace_fu.
qed.

lemma KEM_T_dKEMTSharedSecretSpace_ll :
  is_lossless dKEMTSharedSecretSpace.
proof.
  exact dKEMTSharedSecretSpace_ll.
qed.

lemma H_dbs_kem_pq_nss_funi :
  is_funiform dbs_kem_pq_nss.
proof.
  exact dbs_kem_pq_nss_fu.
qed.

lemma H_dbs_kem_pq_nss_ll :
  is_lossless dbs_kem_pq_nss.
proof.
  exact dbs_kem_pq_nss_ll.
qed.

lemma Hybrid_dbs_kdf_nout_funi :
  is_funiform dbs_kdf_nout.
proof.
  exact dbs_kdf_nout_fu.
qed.

lemma Hybrid_dbs_kdf_nout_ll :
  is_lossless dbs_kdf_nout.
proof.
  exact dbs_kdf_nout_ll.
qed.

(* NOTE: the FrogLang scheme has `requires` clauses that are not enforced by the EC export. The scheme module below may fail EC type-checking because cross-clone type equalities implied by the `requires` are not expressed in the clones. Deferred to Phase 5D. *)

(* ===== Concrete scheme implementation ===== *)

module CK_expanded (KEM_PQ : KEM_PQ_c.Scheme, KEM_T : KEM_T_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme) : Hybrid_c.Scheme = {
  proc derivekeypair(seed : bs_kem_pq_nseed) : (KEMPQEncapsKeySpace * KEMTEncapsKeySpace) * (KEMPQDecapsKeySpace * KEMTDecapsKeySpace * KEMTEncapsKeySpace) = {
    var seed_full : bs_kem_pq_nseed_prg_stretch;
    var seed_PQ : bs_kem_pq_nseed;
    var seed_T : bs_kem_t_nseed;
    var _tup : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace;
    var ek_PQ : KEMPQEncapsKeySpace;
    var dk_PQ : KEMPQDecapsKeySpace;
    var _tup_0 : KEMTEncapsKeySpace * KEMTDecapsKeySpace;
    var ek_T : KEMTEncapsKeySpace;
    var dk_T : KEMTDecapsKeySpace;
    seed_full <@ G.evaluate(seed);
    seed_PQ <- slice_bs_kem_pq_nseed_prg_stretch_to_bs_kem_pq_nseed seed_full 0 kem_pq_nseed;
    seed_T <- slice_bs_kem_pq_nseed_prg_stretch_to_bs_kem_t_nseed seed_full kem_pq_nseed (kem_pq_nseed + kem_t_nseed);
    _tup <@ KEM_PQ.derivekeypair(seed_PQ);
    ek_PQ <- _tup.`1;
    dk_PQ <- _tup.`2;
    _tup_0 <@ KEM_T.derivekeypair(seed_T);
    ek_T <- _tup_0.`1;
    dk_T <- _tup_0.`2;
    return ((ek_PQ, ek_T), (dk_PQ, dk_T, ek_T));
  }
  proc keygen() : (KEMPQEncapsKeySpace * KEMTEncapsKeySpace) * (KEMPQDecapsKeySpace * KEMTDecapsKeySpace * KEMTEncapsKeySpace) = {
    var _tup : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace;
    var ek_PQ : KEMPQEncapsKeySpace;
    var dk_PQ : KEMPQDecapsKeySpace;
    var _tup_0 : KEMTEncapsKeySpace * KEMTDecapsKeySpace;
    var ek_T : KEMTEncapsKeySpace;
    var dk_T : KEMTDecapsKeySpace;
    _tup <@ KEM_PQ.keygen();
    ek_PQ <- _tup.`1;
    dk_PQ <- _tup.`2;
    _tup_0 <@ KEM_T.keygen();
    ek_T <- _tup_0.`1;
    dk_T <- _tup_0.`2;
    return ((ek_PQ, ek_T), (dk_PQ, dk_T, ek_T));
  }
  proc encaps(ek : KEMPQEncapsKeySpace * KEMTEncapsKeySpace) : bs_kdf_nout * (KEMPQCiphertextSpace * KEMTCiphertextSpace) = {
    var ek_PQ : KEMPQEncapsKeySpace;
    var ek_T : KEMTEncapsKeySpace;
    var _tup : bs_kem_pq_nss * KEMPQCiphertextSpace;
    var ss_PQ : bs_kem_pq_nss;
    var ct_PQ : KEMPQCiphertextSpace;
    var _tup_0 : KEMTSharedSecretSpace * KEMTCiphertextSpace;
    var ss_T : KEMTSharedSecretSpace;
    var ct_T : KEMTCiphertextSpace;
    var _r0 : bs_kem_pq_nss;
    var _r1 : bs_kem_t_nss;
    var _r2 : bs_kem_t_nct;
    var _r3 : bs_kem_t_nek;
    var _r4 : bs_nlabel;
    var kdf_in : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel;
    var ss : bs_kdf_nout;
    ek_PQ <- ek.`1;
    ek_T <- ek.`2;
    _tup <@ KEM_PQ.encaps(ek_PQ);
    ss_PQ <- _tup.`1;
    ct_PQ <- _tup.`2;
    _tup_0 <@ KEM_T.encaps(ek_T);
    ss_T <- _tup_0.`1;
    ct_T <- _tup_0.`2;
    _r0 <@ KEM_PQ.encodesharedsecret(ss_PQ);
    _r1 <@ KEM_T.encodesharedsecret(ss_T);
    _r2 <@ KEM_T.encodeciphertext(ct_T);
    _r3 <@ KEM_T.encodeencapskey(ek_T);
    _r4 <@ L.get();
    kdf_in <- concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_to_bs_kem_pq_nss_kem_t_nct_kem_t_nss (concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss _r0 _r1) _r2) _r3) _r4;
    ss <@ H.evaluate(kdf_in);
    return (ss, (ct_PQ, ct_T));
  }
  proc encodesharedsecret(ss : bs_kdf_nout) : bs_kdf_nout = {
    return ss;
  }
  proc encodeciphertext(ct : KEMPQCiphertextSpace * KEMTCiphertextSpace) : bs_kem_pq_nct_kem_t_nct = {
    var _r0 : bs_kem_pq_nct;
    var _r1 : bs_kem_t_nct;
    _r0 <@ KEM_PQ.encodeciphertext(ct.`1);
    _r1 <@ KEM_T.encodeciphertext(ct.`2);
    return concat_bs_kem_pq_nct_bs_kem_t_nct_to_bs_kem_pq_nct_kem_t_nct _r0 _r1;
  }
  proc encodeencapskey(ek : KEMPQEncapsKeySpace * KEMTEncapsKeySpace) : bs_kem_pq_nek_kem_t_nek = {
    var _r0 : bs_kem_pq_nek;
    var _r1 : bs_kem_t_nek;
