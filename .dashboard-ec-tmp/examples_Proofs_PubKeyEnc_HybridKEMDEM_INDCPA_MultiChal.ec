  (* Hop 8: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_8_pr (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
