  module Step_2R_state_1_fdet (K : K_c.Scheme, F : F_c.Scheme) = {
    proc compute(pk : PKeySpace, sk : SKeySpace) : CiphertextSpace * bs_out * bs_out = {
      var __a0__ : SharedSecretSpace * CiphertextSpace;
      var __a1__ : bs_lambda;
      var __a2__ : CiphertextSpace;
      var __a3__ : bs_out;
      var __a4__ : bs_out * CiphertextSpace;
      var __a5__ : bs_out;
      var __a6__ : CiphertextSpace;
      __a0__ <@ K.encaps(pk);
      __a1__ <- __a0__.`1;
      __a2__ <- __a0__.`2;
      __a3__ <- F_c.ev_evaluate (__a1__) (__a2__);
      __a4__ <- (__a3__, __a2__);
      __a5__ <- __a4__.`1;
      __a6__ <- __a4__.`2;
      return (__a6__, __a5__, __a5__);
    }
  }.

  module Step_2R_state_2_fdet (K : K_c.Scheme, F : F_c.Scheme) = {
    proc compute(pk : PKeySpace, sk : SKeySpace) : CiphertextSpace * bs_out * bs_out = {
      var __a0__ : SharedSecretSpace * CiphertextSpace;
      var __a2__ : CiphertextSpace;
      var _r0 : bs_out;
      var __a4__ : bs_out * CiphertextSpace;
      var __a5__ : bs_out;
      __a0__ <@ K.encaps(pk);
      __a2__ <- __a0__.`2;
      _r0 <- F_c.ev_evaluate (__a0__.`1) (__a2__);
      __a4__ <- (_r0, __a2__);
      __a5__ <- __a4__.`1;
      return (__a4__.`2, __a5__, __a5__);
    }
  }.

  (* transform: Inline Single-Use Variables (bucket=canned) *)
  lemma micro_2_right_1_fwd :
    equiv [ Step_2R_state_1(K, F).compute ~ Step_2R_state_2(K, F).compute :
            ={pk, sk, glob K, glob F} ==> ={res, glob K, glob F} ].
