import 'Cl.primitive';
// Left: adds the caller's i, n times. Right: adds the loop index.
Game Left(Cl P) {
    Int Test(Int i, Int n) {
        return P.Sum(i, n);
    }
}
Game Right(Cl P) {
    Int Test(Int i, Int n) {
        Int s = 0;
        for (Int j = 0 to n) {
            s = s + j;
        }
        return s;
    }
}
export as GSum;
