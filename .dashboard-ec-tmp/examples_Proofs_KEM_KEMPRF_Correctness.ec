  lemma canon_bridge_2 :
    equiv [ Step_2L_state_8(K, F).compute ~ Step_2R_state_5(K, F).compute :
            ={pk, sk, glob K, glob F} ==> ={res, glob K, glob F} ].
  proof.
    proc; sim.
  qed.

  lemma hop_2_chain :
    equiv [ Step_2L_state_0(K, F).compute ~ Step_2R_state_0(K, F).compute :
            ={pk, sk, glob K, glob F} ==> ={res, glob K, glob F} ].
  proof.
    (* Chain through per-transform micro-lemmas. *)
    transitivity Step_2L_state_1(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_0 |].
    transitivity Step_2L_state_2(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_1 |].
    transitivity Step_2L_state_3(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_2 |].
    transitivity Step_2L_state_4(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_3 |].
    transitivity Step_2L_state_5(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_4 |].
    transitivity Step_2L_state_6(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_5 |].
    transitivity Step_2L_state_7(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_6 |].
    transitivity Step_2L_state_8(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_left_7 |].
    transitivity Step_2R_state_5(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply canon_bridge_2 |].
    transitivity Step_2R_state_4(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_right_4_rev |].
    transitivity Step_2R_state_3(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_right_3_rev |].
    transitivity Step_2R_state_2(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_right_2_rev |].
    transitivity Step_2R_state_1(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply micro_2_right_1_rev |].
    apply micro_2_right_0_rev.
  qed.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0 :
    equiv [ KF_c.KEMCorrectness_FromDecaps(KEMPRF(K, F)).compute ~ R_KEM(K, F, KEMPRF(K, F), K_c.KEMCorrectness_FromDecaps(K)).compute :
            ={pk, sk, glob K, glob F} ==> ={res, glob K, glob F} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_0L_state_0(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_0R_state_0(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply hop_0_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  lemma hop_2 :
    equiv [ R_KEM(K, F, KEMPRF(K, F), K_c.KEMCorrectness_FromEncaps(K)).compute ~ KF_c.KEMCorrectness_FromEncaps(KEMPRF(K, F)).compute :
            ={pk, sk, glob K, glob F} ==> ={res, glob K, glob F} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_2L_state_0(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_2R_state_0(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}); [ smt() | smt() | apply hop_2_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: KF_c.KEMCorrectness_Adv {-K, -F}) &m :
    Pr[Game_step_0(K, F, A).main() @ &m : res] = Pr[Game_step_1(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc.
    call (_: ={glob K, glob F}); first by conseq hop_0.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEMCorrectness_advantage axiom applied to R_KEM_Adv. *)

  lemma hop_1_pr (A <: KF_c.KEMCorrectness_Adv {-K, -F}) &m :
    `| Pr[Game_step_1(K, F, A).main() @ &m : res] - Pr[Game_step_2(K, F, A).main() @ &m : res] | <= K_c.eps_KEMCorrectness.
  proof.
    have hL : Pr[Game_step_1(K, F, A).main() @ &m : res]
            = Pr[K_c.Game_KEMCorrectness_FromDecaps(K, R_KEM_Adv(K, F, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(K, F, A).main() @ &m : res]
            = Pr[K_c.Game_KEMCorrectness_FromEncaps(K, R_KEM_Adv(K, F, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    rewrite hL hR.
    apply (K_c.KEMCorrectness_advantage K (R_KEM_Adv(K, F, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: KF_c.KEMCorrectness_Adv {-K, -F}) &m :
    Pr[Game_step_2(K, F, A).main() @ &m : res] = Pr[Game_step_3(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc.
    call (_: ={glob K, glob F}); first by conseq hop_2.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: KF_c.KEMCorrectness_Adv {-K, -F}) &m :
    `| Pr[Game_step_0(K, F, A).main() @ &m : res] - Pr[Game_step_3(K, F, A).main() @ &m : res] | <= K_c.eps_KEMCorrectness.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    smt(K_c.eps_KEMCorrectness_pos).
    qed.
end section Main.
