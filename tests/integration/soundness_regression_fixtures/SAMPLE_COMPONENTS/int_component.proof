// A draw of [Int, BitString<n>] draws an Int component: ill-formed.
import 'Pairs.primitive';
import 'IntPairs.scheme';
import 'DrawPair.game';

proof:

let:
    Int n;
    Pairs E = IntPairs(n);

assume:

theorem:
    DrawPair(E);

games:
    DrawPair(E).Left against DrawPair(E).Adversary;
    DrawPair(E).Right against DrawPair(E).Adversary;
