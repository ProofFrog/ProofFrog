  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    swap{2} [2..2] -1.
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

  lemma hop_0_ctxt :
    equiv [ DSE_c.INDCPA__MultiChal_Real(GeneralDoubleSymEnc(D, E)).ctxt ~ R1(D, E, GeneralDoubleSymEnc(D, E), E_c.INDCPA__MultiChal_Real(E)).ctxt :
            ={m} /\ ={glob D} /\ ={glob E} /\ DSE_c.INDCPA__MultiChal_Real.k{1} = E_c.INDCPA__MultiChal_Real.k{2} ==> ={res} /\ ={glob D} /\ ={glob E} /\ DSE_c.INDCPA__MultiChal_Real.k{1} = E_c.INDCPA__MultiChal_Real.k{2} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 0, oracle 'ctxt': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_2_initialize :
    equiv [ R1(D, E, GeneralDoubleSymEnc(D, E), E_c.INDCPA__MultiChal_Random(E)).initialize ~ DSE_c.INDCPA__MultiChal_Random(GeneralDoubleSymEnc(D, E)).initialize :
            ={glob D} /\ ={glob E} ==> ={res} /\ ={glob D} /\ ={glob E} /\ E_c.INDCPA__MultiChal_Random.k{1} = DSE_c.INDCPA__MultiChal_Random.k{2} ].
  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    swap{1} [2..2] -1.
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

  lemma hop_2_ctxt :
    equiv [ R1(D, E, GeneralDoubleSymEnc(D, E), E_c.INDCPA__MultiChal_Random(E)).ctxt ~ DSE_c.INDCPA__MultiChal_Random(GeneralDoubleSymEnc(D, E)).ctxt :
            ={m} /\ ={glob D} /\ ={glob E} /\ E_c.INDCPA__MultiChal_Random.k{1} = DSE_c.INDCPA__MultiChal_Random.k{2} ==> ={res} /\ ={glob D} /\ ={glob E} /\ E_c.INDCPA__MultiChal_Random.k{1} = DSE_c.INDCPA__MultiChal_Random.k{2} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 2, oracle 'ctxt': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: DSE_c.INDCPA__MultiChal_Adv {-D, -E, -DSE_c.INDCPA__MultiChal_Random, -DSE_c.INDCPA__MultiChal_Real, -E_c.INDCPA__MultiChal_Random, -E_c.INDCPA__MultiChal_Real, -R1}) &m :
    Pr[Game_step_0(D, E, A).main() @ &m : res] = Pr[Game_step_1(D, E, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob D, glob E} ==> ={res}) => //.
    proc.
    call (_: ={glob D} /\ ={glob E} /\ DSE_c.INDCPA__MultiChal_Real.k{1} = E_c.INDCPA__MultiChal_Real.k{2}).
    + conseq hop_0_ctxt.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the INDCPA$_MultiChal_advantage axiom applied to R1_Adv. *)

  lemma hop_1_pr (A <: DSE_c.INDCPA__MultiChal_Adv {-D, -E, -DSE_c.INDCPA__MultiChal_Random, -DSE_c.INDCPA__MultiChal_Real, -E_c.INDCPA__MultiChal_Random, -E_c.INDCPA__MultiChal_Real, -R1}) &m :
    `| Pr[Game_step_1(D, E, A).main() @ &m : res] - Pr[Game_step_2(D, E, A).main() @ &m : res] | <= E_c.eps_INDCPA__MultiChal.
  proof.
    have hL : Pr[Game_step_1(D, E, A).main() @ &m : res]
            = Pr[E_c.Game_INDCPA__MultiChal_Real(E, R1_Adv(D, E, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob D, glob E} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(D, E, A).main() @ &m : res]
            = Pr[E_c.Game_INDCPA__MultiChal_Random(E, R1_Adv(D, E, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob D, glob E} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (E_c.INDCPA__MultiChal_advantage E (R1_Adv(D, E, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: DSE_c.INDCPA__MultiChal_Adv {-D, -E, -DSE_c.INDCPA__MultiChal_Random, -DSE_c.INDCPA__MultiChal_Real, -E_c.INDCPA__MultiChal_Random, -E_c.INDCPA__MultiChal_Real, -R1}) &m :
    Pr[Game_step_2(D, E, A).main() @ &m : res] = Pr[Game_step_3(D, E, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob D, glob E} ==> ={res}) => //.
    proc.
    call (_: ={glob D} /\ ={glob E} /\ E_c.INDCPA__MultiChal_Random.k{1} = DSE_c.INDCPA__MultiChal_Random.k{2}).
    + conseq hop_2_ctxt.
    call hop_2_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: DSE_c.INDCPA__MultiChal_Adv {-D, -E, -DSE_c.INDCPA__MultiChal_Random, -DSE_c.INDCPA__MultiChal_Real, -E_c.INDCPA__MultiChal_Random, -E_c.INDCPA__MultiChal_Real, -R1}) &m :
    `| Pr[Game_step_0(D, E, A).main() @ &m : res] - Pr[Game_step_3(D, E, A).main() @ &m : res] | <= E_c.eps_INDCPA__MultiChal.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    smt(E_c.eps_INDCPA__MultiChal_pos).
    qed.
end section Main.
