      var _r7 : bs_kem_t_nek;
      var _r8 : bs_nlabel;
      var _r9 : bs_kem_pq_nss;
      var _r10 : bs_kdf_nout;
      var dec_ss_T : bs_kem_t_nss;
      var _r0 : bs_kem_pq_nss;
      var _r1 : bs_kem_t_nss;
      var _r2 : bs_kem_t_nct;
      var _r3 : bs_kem_t_nek;
      var _r4 : bs_nlabel;
      var kdf_in : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel;
      var _r11 : bs_kdf_nout;
      if (ct = ctStar) {
        _r5 <- None;
      } else {
        ct_PQ <- ct.`1;
        ct_T <- ct.`2;
        dec_ss_PQ <@ KEM_PQ.decaps(pq_keys.`2, ct_PQ);
        if (ct_T = kem_ct_T) {
          if (dec_ss_PQ = ss_PQ_star) {
            r <$ dbs_kdf_nout;
            _r5 <- Some (r);
          } else {
            _r6 <@ KEM_T.encodeciphertext(ct_T);
            _r7 <@ KEM_T.encodeencapskey(t_keys.`1);
            _r8 <@ L.get();
            rest <- concat_bs_kem_t_nct_kem_t_nek_bs_nlabel_to_bs_kem_t_nct_kem_t_nek_nlabel (concat_bs_kem_t_nct_bs_kem_t_nek_to_bs_kem_t_nct_kem_t_nek _r6 _r7) _r8;
            _r9 <@ KEM_PQ.encodesharedsecret(dec_ss_PQ);
            _r10 <@ Challenger.lookup(_r9, rest);
            _r5 <- Some (_r10);
          }
        } else {
          dec_ss_T <@ KEM_T.decaps(t_keys.`2, ct_T);
          _r0 <@ KEM_PQ.encodesharedsecret(dec_ss_PQ);
          _r1 <@ KEM_T.encodesharedsecret(dec_ss_T);
          _r2 <@ KEM_T.encodeciphertext(ct_T);
          _r3 <@ KEM_T.encodeencapskey(t_keys.`1);
          _r4 <@ L.get();
          kdf_in <- concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_to_bs_kem_pq_nss_kem_t_nct_kem_t_nss (concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss _r0 _r1) _r2) _r3) _r4;
          _r11 <@ H.evaluate(kdf_in);
          _r5 <- Some (_r11);
        }
      }
      return _r5;
    }
  }.

