// Hash queries H through a local copy K. Call Fresh, then Hash on all four
// points: in Left one answer equals Fresh's output.
import 'P.primitive';

Game Left(P S) {
    Function<BitString<2>, BitString<2>> H;
    Set<BitString<2>> seen;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
    }
    BitString<2> Hash(BitString<2> x) {
        Function<BitString<2>, BitString<2>> K = H;
        return K(x);
    }
    BitString<2> Fresh() {
        BitString<2> v <-uniq[seen] BitString<2>;
        return H(v);
    }
}

Game Right(P S) {
    Function<BitString<2>, BitString<2>> H;
    Set<BitString<2>> seen;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
    }
    BitString<2> Hash(BitString<2> x) {
        Function<BitString<2>, BitString<2>> K = H;
        return K(x);
    }
    BitString<2> Fresh() {
        BitString<2> v <-uniq[seen] BitString<2>;
        BitString<2> z <- BitString<2>;
        return z;
    }
}

export as LocalAlias;
