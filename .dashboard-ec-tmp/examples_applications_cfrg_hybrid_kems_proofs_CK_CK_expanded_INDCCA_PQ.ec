  lemma hop_15_initialize :
    equiv [ R_Correct_Ideal(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), KEM_PQ_c.KEMCorrectnessWithDK_FromDecaps(KEM_PQ)).initialize ~ Hybrid_c.KEM_INDCCA_Random(CK_expanded(KEM_PQ, KEM_T, G, H, L)).initialize :
            ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.dk.`1{2} = R_Correct_Ideal.corr.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`2{2} = R_Correct_Ideal.t_keys.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`3{2} = R_Correct_Ideal.t_keys.`1{1} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_Correct_Ideal.ctStar{1} /\ R_Correct_Ideal.corr{1}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Ideal.corr{1}.`2) (R_Correct_Ideal.corr{1}.`3) ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 15, oracle 'initialize': init equiv
       with a dead F.evaluate on one side (PRF-random hop). The shared
       backbone is keygen; encaps; <fresh sample>, but one wrapper still
       runs an F.evaluate whose result the sample overwrites. Drop it with a
       one-sided phoare, then peel the common backbone:
         proc. inline *.
         (* drop the dead F.evaluate on the side that has it: *)
         seq <k> <k+1> : (={glob K, glob F} /\ <live coupling>).
         + exists* (glob F){i}, <Fseedi>, <Finputi>; elim* => gf a0 a1;
           call{i} (F_evaluate_det gf a0 a1); auto.
         wp; rnd; wp; call (_: true); wp; call (_: true); skip => /#. *)
    admit.
    qed.

  lemma hop_15_decaps :
    equiv [ R_Correct_Ideal(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), KEM_PQ_c.KEMCorrectnessWithDK_FromDecaps(KEM_PQ)).decaps ~ Hybrid_c.KEM_INDCCA_Random(CK_expanded(KEM_PQ, KEM_T, G, H, L)).decaps :
            ={ct} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.dk.`1{2} = R_Correct_Ideal.corr.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`2{2} = R_Correct_Ideal.t_keys.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`3{2} = R_Correct_Ideal.t_keys.`1{1} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_Correct_Ideal.ctStar{1} /\ R_Correct_Ideal.corr{1}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Ideal.corr{1}.`2) (R_Correct_Ideal.corr{1}.`3) ==> ={res} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.dk.`1{2} = R_Correct_Ideal.corr.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`2{2} = R_Correct_Ideal.t_keys.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`3{2} = R_Correct_Ideal.t_keys.`1{1} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_Correct_Ideal.ctStar{1} /\ R_Correct_Ideal.corr{1}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Ideal.corr{1}.`2) (R_Correct_Ideal.corr{1}.`3) ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 15, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -KEM_T, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFFirstKeyPRF_Random, -H_c.KDFFirstKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_0(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] = Pr[Game_step_1(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Real.dk.`1{1} = R_Correct_Real.corr.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`2{1} = R_Correct_Real.t_keys.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`3{1} = R_Correct_Real.t_keys.`1{2} /\ Hybrid_c.KEM_INDCCA_Real.ctStar{1} = R_Correct_Real.ctStar{2} /\ R_Correct_Real.corr{2}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Real.corr{2}.`2) (R_Correct_Real.corr{2}.`3)).
    + conseq hop_0_decaps.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEMCorrectnessWithDK_advantage axiom applied to R_Correct_Real_Adv. *)

  lemma hop_1_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -KEM_T, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFFirstKeyPRF_Random, -H_c.KDFFirstKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_1(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] - Pr[Game_step_2(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEMCorrectnessWithDK.
  proof.
    have hL : Pr[Game_step_1(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromDecaps(KEM_PQ, R_Correct_Real_Adv(KEM_PQ, KEM_T, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromEncaps(KEM_PQ, R_Correct_Real_Adv(KEM_PQ, KEM_T, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM_PQ_c.KEMCorrectnessWithDK_advantage KEM_PQ (R_Correct_Real_Adv(KEM_PQ, KEM_T, G, H, L, A)) &m).
    qed.

