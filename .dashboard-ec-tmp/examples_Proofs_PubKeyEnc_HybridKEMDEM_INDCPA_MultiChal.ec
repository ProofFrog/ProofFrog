  lemma hop_10_challenge :
    equiv [ R5(E, K, KEMDEM(K, E), K_c.KEM_INDCPA_MultiChal_Real(K)).challenge ~ KD_c.INDCPA_MultiChal_Right(KEMDEM(K, E)).challenge :
            ={mL, mR} /\ ={glob E} /\ ={glob K} /\ K_c.KEM_INDCPA_MultiChal_Real.pk{1} = KD_c.INDCPA_MultiChal_Right.pk{2} ==> ={res} /\ ={glob E} /\ ={glob K} /\ K_c.KEM_INDCPA_MultiChal_Real.pk{1} = KD_c.INDCPA_MultiChal_Right.pk{2} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 10, oracle 'challenge': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
    Pr[Game_step_0(E, K, A).main() @ &m : res] = Pr[Game_step_1(E, K, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //.
    proc.
    call (_: ={glob E} /\ ={glob K} /\ KD_c.INDCPA_MultiChal_Left.pk{1} = K_c.KEM_INDCPA_MultiChal_Real.pk{2}).
    + conseq hop_0_challenge.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEM_INDCPA_MultiChal_advantage axiom applied to R1_Adv. *)

  lemma hop_1_pr (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
    `| Pr[Game_step_1(E, K, A).main() @ &m : res] - Pr[Game_step_2(E, K, A).main() @ &m : res] | <= K_c.eps_KEM_INDCPA_MultiChal.
  proof.
    have hL : Pr[Game_step_1(E, K, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCPA_MultiChal_Real(K, R1_Adv(E, K, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(E, K, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCPA_MultiChal_Random(K, R1_Adv(E, K, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (K_c.KEM_INDCPA_MultiChal_advantage K (R1_Adv(E, K, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
    Pr[Game_step_2(E, K, A).main() @ &m : res] = Pr[Game_step_3(E, K, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //.
    proc.
    call (_: ={glob E} /\ ={glob K} /\ K_c.KEM_INDCPA_MultiChal_Random.pk{1} = R2.pk{2}).
    + conseq hop_2_challenge.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: assumption hop. Bounded by the KeyUniformity_advantage axiom applied to R2_Adv. *)

  lemma hop_3_pr (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
    `| Pr[Game_step_3(E, K, A).main() @ &m : res] - Pr[Game_step_4(E, K, A).main() @ &m : res] | <= E_c.eps_KeyUniformity.
  proof.
    have hL : Pr[Game_step_3(E, K, A).main() @ &m : res]
            = Pr[E_c.Game_KeyUniformity_Random(E, R2_Adv(E, K, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_4(E, K, A).main() @ &m : res]
            = Pr[E_c.Game_KeyUniformity_Real(E, R2_Adv(E, K, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    have H := E_c.KeyUniformity_advantage E (R2_Adv(E, K, A)) &m.
    smt().
    qed.

