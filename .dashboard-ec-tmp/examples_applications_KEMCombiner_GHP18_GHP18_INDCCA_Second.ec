    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: KC_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS2, -G_StoredSS2_R, -KC_c.KEM_INDCCA_MultiChal_Random, -KC_c.KEM_INDCCA_MultiChal_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM2_L, -R_KEM2_R, -R_PRF_L, -R_PRF_R}) &m :
    `| Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_17(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEMCorrectness + KEM2_c.eps_KEM_INDCCA_MultiChal + F_c.eps_TwoKeyPRFSecondKeySecurity + F_c.eps_TwoKeyPRFSecondKeySecurity + KEM2_c.eps_KEM_INDCCA_MultiChal + KEM2_c.eps_KEMCorrectness.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    have h6 := hop_6_pr A &m.
    have h7 := hop_7_pr A &m.
    have h8 := hop_8_pr A &m.
    have h9 := hop_9_pr A &m.
    have h10 := hop_10_pr A &m.
    have h11 := hop_11_pr A &m.
    have h12 := hop_12_pr A &m.
    have h13 := hop_13_pr A &m.
    have h14 := hop_14_pr A &m.
    have h15 := hop_15_pr A &m.
    have h16 := hop_16_pr A &m.
    smt(F_c.eps_TwoKeyPRFSecondKeySecurity_pos KEM2_c.eps_KEMCorrectness_pos KEM2_c.eps_KEM_INDCCA_MultiChal_pos).
    qed.
end section Main.
