    proc decaps(ct : KEMPQCiphertextSpace * KEMTCiphertextSpace) : bs_kdf_nout option = {
      var _r5 : bs_kdf_nout option;
      var ct_PQ : KEMPQCiphertextSpace;
      var ct_T : KEMTCiphertextSpace;
      var dec_ss_PQ : KEMPQSharedSecretSpace;
      var kdf_in : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel;
      var _r6 : bs_kem_pq_nss;
      var _r7 : bs_kem_t_nss;
      var _r8 : bs_kem_t_nct;
      var _r9 : bs_kem_t_nek;
