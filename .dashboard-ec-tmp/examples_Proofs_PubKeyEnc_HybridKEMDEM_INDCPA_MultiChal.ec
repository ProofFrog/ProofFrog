  lemma hop_9_pr (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
    `| Pr[Game_step_9(E, K, A).main() @ &m : res] - Pr[Game_step_10(E, K, A).main() @ &m : res] | <= K_c.eps_KEM_INDCPA_MultiChal.
  proof.
    have hL : Pr[Game_step_9(E, K, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCPA_MultiChal_Random(K, R5_Adv(E, K, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_10(E, K, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCPA_MultiChal_Real(K, R5_Adv(E, K, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    have H := K_c.KEM_INDCPA_MultiChal_advantage K (R5_Adv(E, K, A)) &m.
