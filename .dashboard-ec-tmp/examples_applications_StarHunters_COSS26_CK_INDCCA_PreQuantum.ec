       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_21_initialize :
    equiv [ G_StoredSS2_R(KEM1, KEM2, F).initialize ~ R_Correct_2R(KEM1, KEM2, F, CK(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromEncaps(KEM2)).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2_R.sk1{1} = R_Correct_2R.sk1{2} /\ G_StoredSS2_R.sk2{1} = R_Correct_2R.sk2{2} /\ G_StoredSS2_R.pk2{1} = R_Correct_2R.pk2{2} /\ G_StoredSS2_R.ct1Star{1} = R_Correct_2R.ct1Star{2} /\ G_StoredSS2_R.ct2Star{1} = R_Correct_2R.ct2Star{2} /\ R_Correct_2R.corr{2}.`3 = R_Correct_2R.corr{2}.`2 ].
  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    wp.
    rnd.
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

  lemma hop_21_decaps :
    equiv [ G_StoredSS2_R(KEM1, KEM2, F).decaps ~ R_Correct_2R(KEM1, KEM2, F, CK(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromEncaps(KEM2)).decaps :
            ={c} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2_R.sk1{1} = R_Correct_2R.sk1{2} /\ G_StoredSS2_R.sk2{1} = R_Correct_2R.sk2{2} /\ G_StoredSS2_R.pk2{1} = R_Correct_2R.pk2{2} /\ G_StoredSS2_R.ct1Star{1} = R_Correct_2R.ct1Star{2} /\ G_StoredSS2_R.ct2Star{1} = R_Correct_2R.ct2Star{2} /\ R_Correct_2R.corr{2}.`3 = R_Correct_2R.corr{2}.`2 ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2_R.sk1{1} = R_Correct_2R.sk1{2} /\ G_StoredSS2_R.sk2{1} = R_Correct_2R.sk2{2} /\ G_StoredSS2_R.pk2{1} = R_Correct_2R.pk2{2} /\ G_StoredSS2_R.ct1Star{1} = R_Correct_2R.ct1Star{2} /\ G_StoredSS2_R.ct2Star{1} = R_Correct_2R.ct2Star{2} /\ R_Correct_2R.corr{2}.`3 = R_Correct_2R.corr{2}.`2 ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 21, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_23_initialize :
    equiv [ R_Correct_2R(KEM1, KEM2, F, CK(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromDecaps(KEM2)).initialize ~ C_c.KEM_INDCCA_MultiChal_Random(CK(KEM1, KEM2, F)).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 23, oracle 'initialize': init equiv
       with a dead F.evaluate on one side (PRF-random hop). The shared
       backbone is keygen; encaps; <fresh sample>, but one wrapper still
       runs an F.evaluate whose result the sample overwrites. Drop it with a
       one-sided phoare, then peel the common backbone:
         proc. inline *.
         (* drop the dead F.evaluate on the side that has it: *)
         seq <k> <k+1> : (={glob K, glob F} /\ <live coupling>).
         + exists* (glob F){i}, <Fseedi>, <Finputi>; elim* => gf a0 a1;
           call{i} (F_evaluate_det gf a0 a1); auto.
         wp; rnd; wp; call (_: true); wp; call (_: true); skip => /#. *)
    admit.
    qed.

  lemma hop_23_decaps :
    equiv [ R_Correct_2R(KEM1, KEM2, F, CK(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromDecaps(KEM2)).decaps ~ C_c.KEM_INDCCA_MultiChal_Random(CK(KEM1, KEM2, F)).decaps :
            ={c} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 23, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F}).
    + conseq hop_0_decaps.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEMCorrectness_advantage axiom applied to R_Correct_2L_Adv. *)

  lemma hop_1_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEMCorrectness.
  proof.
    have hL : Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromDecaps(KEM2, R_Correct_2L_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromEncaps(KEM2, R_Correct_2L_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM2_c.KEMCorrectness_advantage KEM2 (R_Correct_2L_Adv(KEM1, KEM2, F, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2.sk1{2} = R_Correct_2L.sk1{1} /\ G_StoredSS2.sk2{2} = R_Correct_2L.sk2{1} /\ G_StoredSS2.pk2{2} = R_Correct_2L.pk2{1} /\ G_StoredSS2.ct1Star{2} = R_Correct_2L.ct1Star{1} /\ G_StoredSS2.ct2Star{2} = R_Correct_2L.ct2Star{1} /\ R_Correct_2L._tup_2{1}.`3 = R_Correct_2L._tup_2{1}.`2).
    + conseq hop_2_decaps.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_3_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2.ss2Star{1} = R_KEM2_L.ss2Star{2} /\ G_StoredSS2.sk1{1} = R_KEM2_L.sk1{2} /\ G_StoredSS2.pk2{1} = R_KEM2_L.pk2{2} /\ G_StoredSS2.ct1Star{1} = R_KEM2_L.ct1Star{2} /\ G_StoredSS2.ct2Star{1} = R_KEM2_L.ct2Star{2} /\ R_KEM2_L.ct2Star{2} = KEM2_c.KEM_INDCCA_MultiChal_Real.ctStar{2}).
    + conseq hop_3_decaps.
    call hop_3_initialize.
    auto.
    qed.

  (* Hop 4: assumption hop. Bounded by the KEM_INDCCA_MultiChal_advantage axiom applied to R_KEM2_L_Adv. *)

  lemma hop_4_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEM_INDCCA_MultiChal.
  proof.
    have hL : Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEM_INDCCA_MultiChal_Real(KEM2, R_KEM2_L_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM2_L, glob KEM2, glob KEM1, glob F, glob KEM2_c.KEM_INDCCA_MultiChal_Real}); [ proc; sim | wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); skip => /# ].
    have hR : Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEM_INDCCA_MultiChal_Random(KEM2, R_KEM2_L_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM2_L, glob KEM2, glob KEM1, glob F, glob KEM2_c.KEM_INDCCA_MultiChal_Random}); [ proc; sim | wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); skip => /# ].
    rewrite hL hR.
    apply (KEM2_c.KEM_INDCCA_MultiChal_advantage KEM2 (R_KEM2_L_Adv(KEM1, KEM2, F, A)) &m).
    qed.

  (* Hop 5: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_5_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_6(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_RandSS2.sk1{2} = R_KEM2_L.sk1{1} /\ G_RandSS2.pk2{2} = R_KEM2_L.pk2{1} /\ G_RandSS2.ct1Star{2} = R_KEM2_L.ct1Star{1} /\ G_RandSS2.ct2Star{2} = R_KEM2_L.ct2Star{1} /\ R_KEM2_L.ct2Star{1} = KEM2_c.KEM_INDCCA_MultiChal_Random.ctStar{1}).
    + conseq hop_5_decaps.
    call hop_5_initialize.
    auto.
    qed.

  (* Hop 6: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_6_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_6(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_7(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_RandSS2.ss2Star{1} = R_C2PRI_L.ss2Star{2} /\ G_RandSS2.sk1{1} = R_C2PRI_L.sk1{2} /\ G_RandSS2.sk2{1} = R_C2PRI_L.sk2{2} /\ G_RandSS2.pk2{1} = R_C2PRI_L.pk2{2} /\ G_RandSS2.ct1Star{1} = R_C2PRI_L.ct1Star{2} /\ G_RandSS2.ct2Star{1} = R_C2PRI_L.ct2Star{2} /\ R_C2PRI_L.ct1Star{2} = KEM1_c.KEM_C2PRI_Ideal.ctStar{2}).
    + conseq hop_6_decaps.
    call hop_6_initialize.
    auto.
    qed.

  (* Hop 7: assumption hop. Bounded by the KEM_C2PRI_advantage axiom applied to R_C2PRI_L_Adv. *)

  lemma hop_7_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_7(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_8(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM1_c.eps_KEM_C2PRI.
