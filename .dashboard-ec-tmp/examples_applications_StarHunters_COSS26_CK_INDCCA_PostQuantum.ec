    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS1_R.ss1Star{2} = R_KEM1_R.ss1Star{1} /\ G_StoredSS1_R.sk2{2} = R_KEM1_R.sk2{1} /\ G_StoredSS1_R.pk2{2} = R_KEM1_R.pk2{1} /\ G_StoredSS1_R.ct1Star{2} = R_KEM1_R.ct1Star{1} /\ G_StoredSS1_R.ct2Star{2} = R_KEM1_R.ct2Star{1} /\ R_KEM1_R.ct1Star{1} = KEM1_c.KEM_INDCCA_MultiChal_Real.ctStar{1}).
    + conseq hop_13_decaps.
    call hop_13_initialize.
    auto.
    qed.

  (* Hop 14: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_14_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFFirstKeySecurity_Random, -F_c.TwoKeyPRFFirstKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS1, -G_StoredSS1_R, -KEM1_c.KEM_INDCCA_MultiChal_Random, -KEM1_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM1_L, -R_KEM1_R, -R_PRF_L, -R_PRF_R}) &m :
    Pr[Game_step_14(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_15(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS1_R.sk1{1} = R_Correct_R.sk1{2} /\ G_StoredSS1_R.sk2{1} = R_Correct_R.sk2{2} /\ G_StoredSS1_R.pk2{1} = R_Correct_R.pk2{2} /\ G_StoredSS1_R.ct1Star{1} = R_Correct_R.ct1Star{2} /\ G_StoredSS1_R.ct2Star{1} = R_Correct_R.ct2Star{2} /\ R_Correct_R.corr{2}.`3 = R_Correct_R.corr{2}.`2).
    + conseq hop_14_decaps.
    call hop_14_initialize.
    auto.
    qed.

  (* Hop 15: assumption hop. Bounded by the KEMCorrectness_advantage axiom applied to R_Correct_R_Adv. *)

  lemma hop_15_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFFirstKeySecurity_Random, -F_c.TwoKeyPRFFirstKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS1, -G_StoredSS1_R, -KEM1_c.KEM_INDCCA_MultiChal_Random, -KEM1_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM1_L, -R_KEM1_R, -R_PRF_L, -R_PRF_R}) &m :
    `| Pr[Game_step_15(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_16(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM1_c.eps_KEMCorrectness.
  proof.
    have hL : Pr[Game_step_15(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM1_c.Game_KEMCorrectness_FromEncaps(KEM1, R_Correct_R_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_16(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM1_c.Game_KEMCorrectness_FromDecaps(KEM1, R_Correct_R_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    have H := KEM1_c.KEMCorrectness_advantage KEM1 (R_Correct_R_Adv(KEM1, KEM2, F, A)) &m.
    smt().
    qed.

  (* Hop 16: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_16_pr (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFFirstKeySecurity_Random, -F_c.TwoKeyPRFFirstKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS1, -G_StoredSS1_R, -KEM1_c.KEM_INDCCA_MultiChal_Random, -KEM1_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM1_L, -R_KEM1_R, -R_PRF_L, -R_PRF_R}) &m :
    Pr[Game_step_16(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_17(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F}).
    + conseq hop_16_decaps.
    call hop_16_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: C_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFFirstKeySecurity_Random, -F_c.TwoKeyPRFFirstKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS1, -G_StoredSS1_R, -KEM1_c.KEM_INDCCA_MultiChal_Random, -KEM1_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM1_L, -R_KEM1_R, -R_PRF_L, -R_PRF_R}) &m :
    `| Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_17(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM1_c.eps_KEMCorrectness + KEM1_c.eps_KEM_INDCCA_MultiChal + F_c.eps_TwoKeyPRFFirstKeySecurity + F_c.eps_TwoKeyPRFFirstKeySecurity + KEM1_c.eps_KEM_INDCCA_MultiChal + KEM1_c.eps_KEMCorrectness.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    have h6 := hop_6_pr A &m.
    have h7 := hop_7_pr A &m.
    have h8 := hop_8_pr A &m.
    have h9 := hop_9_pr A &m.
    have h10 := hop_10_pr A &m.
    have h11 := hop_11_pr A &m.
    have h12 := hop_12_pr A &m.
    have h13 := hop_13_pr A &m.
    have h14 := hop_14_pr A &m.
    have h15 := hop_15_pr A &m.
    have h16 := hop_16_pr A &m.
    smt(F_c.eps_TwoKeyPRFFirstKeySecurity_pos KEM1_c.eps_KEMCorrectness_pos KEM1_c.eps_KEM_INDCCA_MultiChal_pos).
    qed.
end section Main.
