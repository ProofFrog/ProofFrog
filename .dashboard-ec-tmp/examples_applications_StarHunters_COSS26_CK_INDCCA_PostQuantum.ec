    proc distinguish(pk : PK1Space * SS1Space * CT1Space) : bool = {
      var b : bool;
      var pk0 : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space);
      var _tup : PK1Space * SS1Space * CT1Space;
      var pk1 : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var _tup_1 : SS2Space * CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      _tup <- pk;
      pk1 <- _tup.`1;
      R_KEM1_L.ss1Star <- _tup.`2;
      R_KEM1_L.ct1Star <- _tup.`3;
      _tup_0 <@ KEM2.keygen();
      R_KEM1_L.pk2 <- _tup_0.`1;
      R_KEM1_L.sk2 <- _tup_0.`2;
      _tup_1 <@ KEM2.encaps(R_KEM1_L.pk2);
      ss2 <- _tup_1.`1;
      R_KEM1_L.ct2Star <- _tup_1.`2;
      bct2 <- R_KEM1_L.ct2Star;
      bpk2 <- R_KEM1_L.pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ F.evaluate(R_KEM1_L.ss1Star, ss2, label);
      pk0 <- ((pk1, R_KEM1_L.pk2), ss, (R_KEM1_L.ct1Star, R_KEM1_L.ct2Star));
      b <@ A(R_KEM1_L(KEM1, KEM2, F, CK(KEM1, KEM2, F), C)).distinguish(pk0);
      return b;
    }
  }.

