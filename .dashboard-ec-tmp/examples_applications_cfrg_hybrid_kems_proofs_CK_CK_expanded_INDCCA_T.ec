  concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss s 0 (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss)) (slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_nlabel s (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss + nlabel)) = s.
proof.
  move => s.
  have hs : size (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s) = kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss + nlabel by exact BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.size_word.
  rewrite /concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel /slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss /slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_nlabel drop0.
  have ->: (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) - 0 = (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) by smt().
  have ->: (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss + nlabel) - (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) = nlabel by smt().
  have h1 : size (take (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s)) = (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss)
    by rewrite size_take; smt(gt0_kem_pq_nss gt0_kem_t_nct gt0_kem_t_nek gt0_kem_t_nss gt0_nlabel).
  have hd : size (drop (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s)) = nlabel
    by rewrite size_drop; smt(gt0_kem_pq_nss gt0_kem_t_nct gt0_kem_t_nek gt0_kem_t_nss gt0_nlabel).
  have ht : take nlabel (drop (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s))
          = drop (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s)
    by rewrite take_oversize // hd.
  have h2 : size (take nlabel (drop (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.ofword s))) = nlabel
    by rewrite ht hd.
  rewrite (BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss.ofwordK _ h1) (BW_bs_nlabel.ofwordK _ h2) ht.
  by rewrite cat_take_drop BW_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.mkwordK.
