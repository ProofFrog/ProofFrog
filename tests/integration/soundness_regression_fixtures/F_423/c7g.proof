// Attack c7g (guard form) (see SetReq6G.scheme). UNSOUND if "Proof Succeeded": with
// so0 = {None}, Test returns true in Left and false in Right.
import 'Conv2.primitive';
import 'Src.primitive';
import 'SetReq6G.scheme';
import 'r3.game';
proof:
let:
    Set K;
    Src P = Src(K);
    Set<BitString<8>?> so0;
    SetReq6G C = SetReq6G(P, so0);
theorem:
    R3(C);
games:
    R3(C).Left against R3(C).Adversary;
    R3(C).Right against R3(C).Adversary;
