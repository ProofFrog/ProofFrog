// Calls.Get calls the game's own Inc oracle, so each Get raises c before
// returning it; NoCalls.Get returns c unchanged. An adversary calling Get
// twice sees 1, 2 against Calls and 0, 0 against NoCalls.

Game Calls() {
    Int c;
    Void Initialize() {
        c = 0;
    }
    Void Inc() {
        c = c + 1;
    }
    Int Get() {
        Calls.Inc();
        return c;
    }
}

Game NoCalls() {
    Int c;
    Void Initialize() {
        c = 0;
    }
    Void Inc() {
        c = c + 1;
    }
    Int Get() {
        return c;
    }
}

export as SelfCall;
