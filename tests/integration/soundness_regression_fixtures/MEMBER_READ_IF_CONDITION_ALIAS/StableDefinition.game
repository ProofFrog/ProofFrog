// Positive control for StaleDefinition.game: M is set once in Initialize
// and never written again, so f = c + |M.keys| holds in every call to O and
// inlining it inside `if (v == c)` is sound. O(v) returns v + |M.keys| in
// both games.
Game Left() {
    Map<Int, Bool> M;
    Int c;
    Int f;
    Void Initialize(Int x, Map<Int, Bool> N) {
        M = N;
        c = x;
        f = c + |M.keys|;
    }
    Int O(Int v) {
        if (v == c) {
            return f;
        }
        return v + |M.keys|;
    }
}

Game Right() {
    Map<Int, Bool> M;
    Int c;
    Int f;
    Void Initialize(Int x, Map<Int, Bool> N) {
        M = N;
        c = x;
        f = c + |M.keys|;
    }
    Int O(Int v) {
        return v + |M.keys|;
    }
}

export as StableDefinition;
