  lemma hop_0_initialize :
    equiv [ Hybrid_c.KEM_INDCCA_Real(CG_seedbased(KEM_PQ, NG, G, H, L)).initialize ~ R_PRG_L(KEM_PQ, NG, G, H, L, CG_seedbased(KEM_PQ, NG, G, H, L), G_c.PRGSec_Real(G)).initialize :
