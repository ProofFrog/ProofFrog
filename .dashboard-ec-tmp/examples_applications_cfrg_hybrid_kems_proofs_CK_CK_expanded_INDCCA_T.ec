      _tup_0 <@ KEM_T.encaps(ek_T);
      ss_T <- _tup_0.`1;
      kem_ct_T <- _tup_0.`2;
      ss_T_star <$ dbs_kem_t_nss;
      _r0 <@ KEM_PQ.encodesharedsecret(ss_PQ_star);
      _r1 <@ KEM_T.encodeciphertext(kem_ct_T);
      _r2 <@ KEM_T.encodeencapskey(ek_T);
