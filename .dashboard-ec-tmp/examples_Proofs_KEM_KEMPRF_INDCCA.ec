  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: KF_c.KEM_INDCCA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}) &m :
    Pr[Game_step_0(K, F, A).main() @ &m : res] = Pr[Game_step_1(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCCA_MultiChal_Real.ctStar{1} = R_KEM.ctStar{2} /\ R_KEM.ctStar{2} = K_c.KEM_INDCCA_MultiChal_Real.ctStar{2} /\ KF_c.KEM_INDCCA_MultiChal_Real.sk{1} = K_c.KEM_INDCCA_MultiChal_Real.sk{2}).
    + conseq hop_0_decaps.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEM_INDCCA_MultiChal_advantage axiom applied to R_KEM_Adv. *)

  lemma hop_1_pr (A <: KF_c.KEM_INDCCA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}) &m :
    `| Pr[Game_step_1(K, F, A).main() @ &m : res] - Pr[Game_step_2(K, F, A).main() @ &m : res] | <= K_c.eps_KEM_INDCCA_MultiChal.
  proof.
    have hL : Pr[Game_step_1(K, F, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCCA_MultiChal_Real(K, R_KEM_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM, glob K, glob F, glob K_c.KEM_INDCCA_MultiChal_Real}); [ proc; sim | wp; call (_: true); wp; call (_: true); wp; call (_: true); skip => /# ].
    have hR : Pr[Game_step_2(K, F, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCCA_MultiChal_Random(K, R_KEM_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM, glob K, glob F, glob K_c.KEM_INDCCA_MultiChal_Random}); [ proc; sim | wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); skip => /# ].
    rewrite hL hR.
    apply (K_c.KEM_INDCCA_MultiChal_advantage K (R_KEM_Adv(K, F, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: KF_c.KEM_INDCCA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}) &m :
    Pr[Game_step_2(K, F, A).main() @ &m : res] = Pr[Game_step_3(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ G_RandKey.ctStar{2} = R_KEM.ctStar{1} /\ R_KEM.ctStar{1} = K_c.KEM_INDCCA_MultiChal_Random.ctStar{1} /\ G_RandKey.sk{2} = K_c.KEM_INDCCA_MultiChal_Random.sk{1}).
    + conseq hop_2_decaps.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_3_pr (A <: KF_c.KEM_INDCCA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}) &m :
    Pr[Game_step_3(K, F, A).main() @ &m : res] = Pr[Game_step_4(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ G_RandKey.sk{1} = R_MultiPRF.sk{2}).
    + conseq hop_3_decaps.
    call hop_3_initialize.
    auto.
    qed.

  (* Hop 4: assumption hop. Bounded by the PRFSecurity_MultiKey_advantage axiom applied to R_MultiPRF_Adv. *)

  lemma hop_4_pr (A <: KF_c.KEM_INDCCA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}) &m :
    `| Pr[Game_step_4(K, F, A).main() @ &m : res] - Pr[Game_step_5(K, F, A).main() @ &m : res] | <= F_c.eps_PRFSecurity_MultiKey.
  proof.
    have hL : Pr[Game_step_4(K, F, A).main() @ &m : res]
            = Pr[F_c.Game_PRFSecurity_MultiKey_Real(F, R_MultiPRF_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_5(K, F, A).main() @ &m : res]
            = Pr[F_c.Game_PRFSecurity_MultiKey_Random(F, R_MultiPRF_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (F_c.PRFSecurity_MultiKey_advantage F (R_MultiPRF_Adv(K, F, A)) &m).
    qed.

  (* Hop 5: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_5_pr (A <: KF_c.KEM_INDCCA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}) &m :
    Pr[Game_step_5(K, F, A).main() @ &m : res] = Pr[Game_step_6(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ R_MultiPRF.sk{1} = KF_c.KEM_INDCCA_MultiChal_Random.sk{2}).
    + conseq hop_5_decaps.
    call hop_5_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: KF_c.KEM_INDCCA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}) &m :
    `| Pr[Game_step_0(K, F, A).main() @ &m : res] - Pr[Game_step_6(K, F, A).main() @ &m : res] | <= K_c.eps_KEM_INDCCA_MultiChal + F_c.eps_PRFSecurity_MultiKey.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    smt(F_c.eps_PRFSecurity_MultiKey_pos K_c.eps_KEM_INDCCA_MultiChal_pos).
    qed.
end section Main.
