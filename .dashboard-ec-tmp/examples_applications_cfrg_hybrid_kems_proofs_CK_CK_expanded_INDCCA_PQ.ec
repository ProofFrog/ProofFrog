lemma dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_split_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel :
  dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel =
  dmap (dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss `*` dbs_nlabel)
       (fun (p : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss * bs_nlabel) => concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel p.`1 p.`2).
proof.
  apply: eq_funi_ll.
  + exact dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_fu.
  + exact dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_ll.
  + apply: is_full_funiform.
    + apply: dmap_fu_in => w.
      exists (slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss w 0 (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss), slice_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel_to_bs_nlabel w (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss) (kem_pq_nss + kem_t_nct + kem_t_nek + kem_t_nss + nlabel)).
      rewrite supp_dprod /=; split.
      + by split; [exact dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_full | exact dbs_nlabel_full].
      by rewrite concat_slices_id_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel.
    apply: dmap_uni_in_inj.
    + move => [x1 y1] [x2 y2] _ _ /= heq.
      have hx : x1 = x2 by rewrite -(slice_concat_left_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x1 y1) -(slice_concat_left_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x2 y2) heq.
      have hy : y1 = y2 by rewrite -(slice_concat_right_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x1 y1) -(slice_concat_right_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel x2 y2) heq.
      by rewrite hx hy.
    by apply: dprod_uni; apply: funi_uni; [exact dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_fu | exact dbs_nlabel_fu].
  apply: dmap_ll; rewrite dprod_ll.
  by split; [exact dbs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_ll | exact dbs_nlabel_ll].
qed.

