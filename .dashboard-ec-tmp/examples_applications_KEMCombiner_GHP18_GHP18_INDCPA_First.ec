(* NOTE: the FrogLang scheme has `requires` clauses that are not enforced by the EC export. The scheme module below may fail EC type-checking because cross-clone type equalities implied by the `requires` are not expressed in the clones. Deferred to Phase 5D. *)

(* ===== Concrete scheme implementation ===== *)

module KEMCombiner (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : KC_c.Scheme = {
  proc keygen() : (PK1Space * PK2Space) * (SK1Space * SK2Space * PK1Space * PK2Space) = {
    var k1 : PK1Space * SK1Space;
    var k2 : PK2Space * SK2Space;
    k1 <@ KEM1.keygen();
    k2 <@ KEM2.keygen();
    return ((k1.`1, k2.`1), (k1.`2, k2.`2, k1.`1, k2.`1));
  }
  proc encaps(pk : PK1Space * PK2Space) : bs_outlen * (CT1Space * CT2Space) = {
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var _tup : SS1Space * CT1Space;
    var ss1 : SS1Space;
    var ct1 : CT1Space;
    var _tup_0 : SS2Space * CT2Space;
    var ss2 : SS2Space;
    var ct2 : CT2Space;
    var bpk1 : bs_pk1len;
    var bct1 : bs_ct1len;
    var bpk2 : bs_pk2len;
    var bct2 : bs_ct2len;
    var label : bs_ct1len_ct2len_pk1len_pk2len;
    var ss : bs_outlen;
    pk1 <- pk.`1;
    pk2 <- pk.`2;
    _tup <@ KEM1.encaps(pk1);
    ss1 <- _tup.`1;
    ct1 <- _tup.`2;
    _tup_0 <@ KEM2.encaps(pk2);
    ss2 <- _tup_0.`1;
    ct2 <- _tup_0.`2;
    bpk1 <- pk1;
    bct1 <- ct1;
    bpk2 <- pk2;
    bct2 <- ct2;
    label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
    ss <@ F.evaluate(ss1, ss2, label);
    return (ss, (ct1, ct2));
  }
  proc decaps(sk : SK1Space * SK2Space * PK1Space * PK2Space, c : CT1Space * CT2Space) : bs_outlen = {
    var sk1 : SK1Space;
    var sk2 : SK2Space;
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var ct1 : CT1Space;
    var ct2 : CT2Space;
    var ss1 : SS1Space;
    var ss2 : SS2Space;
    var bpk1 : bs_pk1len;
    var bct1 : bs_ct1len;
    var bpk2 : bs_pk2len;
    var bct2 : bs_ct2len;
    var label : bs_ct1len_ct2len_pk1len_pk2len;
    var _r0 : bs_outlen;
    sk1 <- sk.`1;
    sk2 <- sk.`2;
    pk1 <- sk.`3;
    pk2 <- sk.`4;
    ct1 <- c.`1;
    ct2 <- c.`2;
    ss1 <@ KEM1.decaps(sk1, ct1);
    ss2 <@ KEM2.decaps(sk2, ct2);
    bpk1 <- pk1;
    bct1 <- ct1;
    bpk2 <- pk2;
    bct2 <- ct2;
    label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
    _r0 <@ F.evaluate(ss1, ss2, label);
    return _r0;
  }
}.

section Main.
  (* ===== Reductions ===== *)

  module R_KEM1 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : KEM1_c.KEM_INDCPA_MultiChal_Oracle) = {
    var pk1 : PK1Space
    var pk2 : PK2Space
    proc initialize() : PK1Space * PK2Space = {
      var k2 : PK2Space * SK2Space;
      pk1 <@ Challenger.initialize();
      k2 <@ KEM2.keygen();
      pk2 <- k2.`1;
      return (pk1, pk2);
    }
    proc challenge() : bs_outlen * (CT1Space * CT2Space) = {
      var _tup : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var ct1 : CT1Space;
      var _tup_0 : SS2Space * CT2Space;
      var ss2 : SS2Space;
      var ct2 : CT2Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var ss : bs_outlen;
      _tup <@ Challenger.challenge();
      ss1 <- _tup.`1;
      ct1 <- _tup.`2;
      _tup_0 <@ KEM2.encaps(pk2);
      ss2 <- _tup_0.`1;
      ct2 <- _tup_0.`2;
      bpk1 <- pk1;
      bct1 <- ct1;
      bpk2 <- pk2;
      bct2 <- ct2;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      ss <@ F.evaluate(ss1, ss2, label);
      return (ss, (ct1, ct2));
    }
  }.

  module R_PRF1 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : F_c.TwoKeyPRFFirstKeyMultiKey_Oracle) = {
    var pk1 : PK1Space
    var pk2 : PK2Space
    proc initialize() : PK1Space * PK2Space = {
      var k1 : PK1Space * SK1Space;
      var k2 : PK2Space * SK2Space;
      k1 <@ KEM1.keygen();
      k2 <@ KEM2.keygen();
      pk1 <- k1.`1;
      pk2 <- k2.`1;
      return (pk1, pk2);
    }
    proc challenge() : bs_outlen * (CT1Space * CT2Space) = {
      var rsp1 : SS1Space * CT1Space;
      var ct1 : CT1Space;
      var _tup : SS2Space * CT2Space;
      var ss2 : SS2Space;
      var ct2 : CT2Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var ss : bs_outlen;
      rsp1 <@ KEM1.encaps(pk1);
      ct1 <- rsp1.`2;
      _tup <@ KEM2.encaps(pk2);
      ss2 <- _tup.`1;
      ct2 <- _tup.`2;
      bpk1 <- pk1;
      bct1 <- ct1;
      bpk2 <- pk2;
      bct2 <- ct2;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      ss <@ Challenger.lookup(ss2, label);
      return (ss, (ct1, ct2));
    }
  }.

  (* ===== Reductions lifted to assumption-adversaries ===== *)

  module R_KEM1_Adv (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv, C : KEM1_c.KEM_INDCPA_MultiChal_Oracle) = {
    proc distinguish(pk : PK1Space) : bool = {
      var b : bool;
      var pk0 : PK1Space * PK2Space;
      var k2 : PK2Space * SK2Space;
      R_KEM1.pk1 <- pk;
      k2 <@ KEM2.keygen();
      R_KEM1.pk2 <- k2.`1;
      pk0 <- (R_KEM1.pk1, R_KEM1.pk2);
      b <@ A(R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), C)).distinguish(pk0);
      return b;
    }
  }.

  module R_PRF1_Adv (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv, C : F_c.TwoKeyPRFFirstKeyMultiKey_Oracle) = {
    proc distinguish() : bool = {
      var b : bool;
      var pk0 : PK1Space * PK2Space;
      pk0 <@ R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), C).initialize();
      b <@ A(R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), C)).distinguish(pk0);
      return b;
    }
  }.

  (* ===== Intermediate games ===== *)

  module G1_RandKey (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : KC_c.KEM_INDCPA_MultiChal_Oracle = {
    var pk1 : PK1Space
    var pk2 : PK2Space
    proc initialize() : PK1Space * PK2Space = {
      var k1 : PK1Space * SK1Space;
      var k2 : PK2Space * SK2Space;
      k1 <@ KEM1.keygen();
      k2 <@ KEM2.keygen();
      pk1 <- k1.`1;
      pk2 <- k2.`1;
      return (pk1, pk2);
    }
    proc challenge() : bs_outlen * (CT1Space * CT2Space) = {
      var key1 : bs_ss1len;
      var rsp1 : SS1Space * CT1Space;
      var ct1 : CT1Space;
      var _tup : SS2Space * CT2Space;
      var ss2 : SS2Space;
      var ct2 : CT2Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var ss : bs_outlen;
      key1 <$ dbs_ss1len;
      rsp1 <@ KEM1.encaps(pk1);
      ct1 <- rsp1.`2;
      _tup <@ KEM2.encaps(pk2);
      ss2 <- _tup.`1;
      ct2 <- _tup.`2;
      bpk1 <- pk1;
      bct1 <- ct1;
      bpk2 <- pk2;
      bct2 <- ct2;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      ss <@ F.evaluate(key1, ss2, label);
      return (ss, (ct1, ct2));
    }
  }.

  (* ===== Game-step wrappers ===== *)

  (* Game_step_0: KEM_INDCPA_MultiChal.Real *)

  module Game_step_0 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : PK1Space * PK2Space;
      pk <@ KC_c.KEM_INDCPA_MultiChal_Real(KEMCombiner(KEM1, KEM2, F)).initialize();
      b <@ A(KC_c.KEM_INDCPA_MultiChal_Real(KEMCombiner(KEM1, KEM2, F))).distinguish(pk);
      return b;
    }
  }.

  (* Game_step_1: KEM_INDCPA_MultiChal.Real composed with reduction R_KEM1 *)

  module Game_step_1 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : PK1Space * PK2Space;
      pk <@ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Real(KEM1)).initialize();
      b <@ A(R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Real(KEM1))).distinguish(pk);
      return b;
    }
  }.

  (* Game_step_2: KEM_INDCPA_MultiChal.Random composed with reduction R_KEM1 *)

  module Game_step_2 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : PK1Space * PK2Space;
      pk <@ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Random(KEM1)).initialize();
      b <@ A(R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Random(KEM1))).distinguish(pk);
      return b;
    }
  }.

  (* Game_step_3 *)

  module Game_step_3 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : PK1Space * PK2Space;
      pk <@ G1_RandKey(KEM1, KEM2, F).initialize();
      b <@ A(G1_RandKey(KEM1, KEM2, F)).distinguish(pk);
      return b;
    }
  }.

  (* Game_step_4: TwoKeyPRFFirstKeyMultiKey.Real composed with reduction R_PRF1 *)

  module Game_step_4 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : PK1Space * PK2Space;
      pk <@ R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Real(F)).initialize();
      b <@ A(R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Real(F))).distinguish(pk);
      return b;
    }
  }.

  (* Game_step_5: TwoKeyPRFFirstKeyMultiKey.Random composed with reduction R_PRF1 *)

  module Game_step_5 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : PK1Space * PK2Space;
      pk <@ R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Random(F)).initialize();
      b <@ A(R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Random(F))).distinguish(pk);
      return b;
    }
  }.

  (* Game_step_6: KEM_INDCPA_MultiChal.Random *)

  module Game_step_6 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : PK1Space * PK2Space;
      pk <@ KC_c.KEM_INDCPA_MultiChal_Random(KEMCombiner(KEM1, KEM2, F)).initialize();
      b <@ A(KC_c.KEM_INDCPA_MultiChal_Random(KEMCombiner(KEM1, KEM2, F))).distinguish(pk);
      return b;
    }
  }.

  (* ===== Per-transform canonicalization chain ===== *)

  module Step_0L_state_0 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) = {
    var pk : PK1Space * PK2Space
    var sk : SK1Space * SK2Space * PK1Space * PK2Space
    proc initialize() : PK1Space * PK2Space = {
      var v_KC_KeyGen_k10 : PK1Space * SK1Space;
      var v_KC_KeyGen_k20 : PK2Space * SK2Space;
      var _tup : (PK1Space * PK2Space) * (SK1Space * SK2Space * PK1Space * PK2Space);
      v_KC_KeyGen_k10 <@ KEM1.keygen();
      v_KC_KeyGen_k20 <@ KEM2.keygen();
      _tup <- ((v_KC_KeyGen_k10.`1, v_KC_KeyGen_k20.`1), (v_KC_KeyGen_k10.`2, v_KC_KeyGen_k20.`2, v_KC_KeyGen_k10.`1, v_KC_KeyGen_k20.`1));
      pk <- _tup.`1;
      sk <- _tup.`2;
      return pk;
    }
    proc challenge() : bs_outlen * (CT1Space * CT2Space) = {
      var v_KC_Encaps_pk10 : PK1Space;
      var v_KC_Encaps_pk20 : PK2Space;
      var v_KC_Encaps__tup0 : SS1Space * CT1Space;
      var v_KC_Encaps_ss10 : SS1Space;
      var v_KC_Encaps_ct10 : CT1Space;
      var v_KC_Encaps__tup_00 : SS2Space * CT2Space;
      var v_KC_Encaps_ss20 : SS2Space;
      var v_KC_Encaps_ct20 : CT2Space;
      var v_KC_Encaps_bpk10 : bs_pk1len;
      var v_KC_Encaps_bct10 : bs_ct1len;
      var v_KC_Encaps_bpk20 : bs_pk2len;
      var v_KC_Encaps_bct20 : bs_ct2len;
      var v_KC_Encaps_label0 : bs_ct1len_ct2len_pk1len_pk2len;
      var v_KC_Encaps_ss0 : bs_outlen;
      var _tup : bs_outlen * (CT1Space * CT2Space);
      var ss : bs_outlen;
      var ctxt : CT1Space * CT2Space;
      v_KC_Encaps_pk10 <- pk.`1;
      v_KC_Encaps_pk20 <- pk.`2;
      v_KC_Encaps__tup0 <@ KEM1.encaps(v_KC_Encaps_pk10);
      v_KC_Encaps_ss10 <- v_KC_Encaps__tup0.`1;
      v_KC_Encaps_ct10 <- v_KC_Encaps__tup0.`2;
      v_KC_Encaps__tup_00 <@ KEM2.encaps(v_KC_Encaps_pk20);
      v_KC_Encaps_ss20 <- v_KC_Encaps__tup_00.`1;
      v_KC_Encaps_ct20 <- v_KC_Encaps__tup_00.`2;
      v_KC_Encaps_bpk10 <- v_KC_Encaps_pk10;
      v_KC_Encaps_bct10 <- v_KC_Encaps_ct10;
      v_KC_Encaps_bpk20 <- v_KC_Encaps_pk20;
      v_KC_Encaps_bct20 <- v_KC_Encaps_ct20;
      v_KC_Encaps_label0 <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len v_KC_Encaps_bpk10 v_KC_Encaps_bct10) v_KC_Encaps_bpk20) v_KC_Encaps_bct20;
      v_KC_Encaps_ss0 <@ F.evaluate(v_KC_Encaps_ss10, v_KC_Encaps_ss20, v_KC_Encaps_label0);
      _tup <- (v_KC_Encaps_ss0, (v_KC_Encaps_ct10, v_KC_Encaps_ct20));
      ss <- _tup.`1;
      ctxt <- _tup.`2;
      return (ss, ctxt);
    }
  }.

  module Step_0L_state_1 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) = {
    var pk : PK1Space * PK2Space
    var sk : SK1Space * SK2Space * PK1Space * PK2Space
    proc initialize() : PK1Space * PK2Space = {
      var __a0__ : PK1Space * SK1Space;
      var __a1__ : PK2Space * SK2Space;
      var __a2__ : (PK1Space * PK2Space) * (SK1Space * SK2Space * PK1Space * PK2Space);
      __a0__ <@ KEM1.keygen();
      __a1__ <@ KEM2.keygen();
      __a2__ <- ((__a0__.`1, __a1__.`1), (__a0__.`2, __a1__.`2, __a0__.`1, __a1__.`1));
      pk <- __a2__.`1;
      sk <- __a2__.`2;
      return pk;
    }
    proc challenge() : bs_outlen * (CT1Space * CT2Space) = {
      var __a3__ : PK1Space;
      var __a4__ : PK2Space;
      var __a5__ : SS1Space * CT1Space;
      var __a6__ : SS1Space;
      var __a7__ : CT1Space;
      var __a8__ : SS2Space * CT2Space;
      var __a9__ : SS2Space;
      var __a10__ : CT2Space;
      var __a11__ : bs_pk1len;
      var __a12__ : bs_ct1len;
      var __a13__ : bs_pk2len;
      var __a14__ : bs_ct2len;
      var __a15__ : bs_ct1len_ct2len_pk1len_pk2len;
      var __a16__ : bs_outlen;
      var __a17__ : bs_outlen * (CT1Space * CT2Space);
      var __a18__ : bs_outlen;
      var __a19__ : CT1Space * CT2Space;
      __a3__ <- pk.`1;
      __a4__ <- pk.`2;
      __a5__ <@ KEM1.encaps(__a3__);
      __a6__ <- __a5__.`1;
      __a7__ <- __a5__.`2;
      __a8__ <@ KEM2.encaps(__a4__);
      __a9__ <- __a8__.`1;
      __a10__ <- __a8__.`2;
      __a11__ <- __a3__;
      __a12__ <- __a7__;
      __a13__ <- __a4__;
