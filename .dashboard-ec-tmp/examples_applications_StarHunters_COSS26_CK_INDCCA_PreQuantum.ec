      var ct2 : CT2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss1 : SS1Space;
      var r : bs_outlen;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        if (ct2 = ct2Star) {
          if (ss1 = ss1Star) {
            r <$ dbs_outlen;
            _r0 <- Some (r);
          } else {
            _r1 <@ Challenger.lookup(ss1, label);
            _r0 <- Some (_r1);
          }
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

