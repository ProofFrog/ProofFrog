import 'HLeak.primitive';
import 'a2.game';

proof:

let:
    Int m;
    Function<BitString<1>, BitString<m>> H <- Function<BitString<1>, BitString<m>>;
    HLeak L = HLeak(m, H);

theorem:
    A2(m, H, L);

games:
    A2(m, H, L).Real against A2(m, H, L).Adversary;
    A2(m, H, L).Random against A2(m, H, L).Adversary;
