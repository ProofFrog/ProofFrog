  (* Hop 11: assumption hop. Bounded by the KEM_INDCCA_advantage axiom applied to RC_Adv. *)

  lemma hop_11_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_11(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_12(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEM_INDCCA.
  proof.
    have hL : Pr[Game_step_11(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEM_INDCCA_Random(KEM_PQ, RC_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob RC, glob KEM_PQ, glob NG, glob G, glob H, glob L, glob KEM_PQ_c.KEM_INDCCA_Random}); [ proc; sim | wp; rnd; wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; rnd; wp; call (_: true); wp; call (_: true); skip => /# ].
    have hR : Pr[Game_step_12(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEM_INDCCA_Real(KEM_PQ, RC_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob RC, glob KEM_PQ, glob NG, glob G, glob H, glob L, glob KEM_PQ_c.KEM_INDCCA_Real}); [ proc; sim | wp; rnd; wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); skip => /# ].
    rewrite hL hR.
    have H := KEM_PQ_c.KEM_INDCCA_advantage KEM_PQ (RC_Adv(KEM_PQ, NG, G, H, L, A)) &m.
    smt().
    qed.

  (* Hop 12: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_12_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_12(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_13(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameCaseSplitIdeal.pq_keys.`1{2} = RC.ek_PQ{1} /\ GameCaseSplitIdeal.seed_T{2} = RC.seed_T{1} /\ GameCaseSplitIdeal.kem_ct{2} = RC.kem_ct{1} /\ GameCaseSplitIdeal.ss_PQ{2} = RC.ss_PQ{1} /\ GameCaseSplitIdeal.ctStar{2} = RC.ctStar{1} /\ RC.ctStar.`1{1} = KEM_PQ_c.KEM_INDCCA_Real.ctStar{1} /\ RC.kem_ct{1} = KEM_PQ_c.KEM_INDCCA_Real.ctStar{1}).
    + conseq hop_12_decaps.
    call hop_12_initialize.
    auto.
    qed.

  (* Hop 13: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_13_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_13(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_14(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameCaseSplitIdeal.pq_keys.`1{1} = R_Correct_Ideal.corr.`1{2} /\ GameCaseSplitIdeal.pq_keys.`2{1} = R_Correct_Ideal.corr.`2{2} /\ GameCaseSplitIdeal.seed_T{1} = R_Correct_Ideal.seed_T{2} /\ GameCaseSplitIdeal.kem_ct{1} = R_Correct_Ideal.corr.`3{2} /\ GameCaseSplitIdeal.ss_PQ{1} = R_Correct_Ideal.corr.`4{2} /\ GameCaseSplitIdeal.ctStar{1} = R_Correct_Ideal.ctStar{2} /\ R_Correct_Ideal.corr{2}.`5 = R_Correct_Ideal.corr{2}.`4).
    + conseq hop_13_decaps.
    call hop_13_initialize.
    auto.
    qed.

  (* Hop 14: assumption hop. Bounded by the KEMCorrectnessWithDK_advantage axiom applied to R_Correct_Ideal_Adv. *)

  lemma hop_14_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_14(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_15(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEMCorrectnessWithDK.
  proof.
    have hL : Pr[Game_step_14(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromEncaps(KEM_PQ, R_Correct_Ideal_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_15(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromDecaps(KEM_PQ, R_Correct_Ideal_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    have H := KEM_PQ_c.KEMCorrectnessWithDK_advantage KEM_PQ (R_Correct_Ideal_Adv(KEM_PQ, NG, G, H, L, A)) &m.
    smt().
    qed.

  (* Hop 15: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_15_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_15(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_16(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.dk.`1{2} = R_Correct_Ideal.corr.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`3{2} = NG_c.ev_exp (NG_c.ev_generator) (Hybrid_c.KEM_INDCCA_Random.dk.`2{2}) /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_Correct_Ideal.ctStar{1} /\ R_Correct_Ideal.corr{1}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Ideal.corr{1}.`2) (R_Correct_Ideal.corr{1}.`3)).
    + conseq hop_15_decaps.
    call hop_15_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_0(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_16(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEMCorrectnessWithDK + KEM_PQ_c.eps_KEM_INDCCA + H_c.eps_KDFPRFSec + H_c.eps_KDFPRFSec + KEM_PQ_c.eps_KEM_INDCCA + KEM_PQ_c.eps_KEMCorrectnessWithDK.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    have h6 := hop_6_pr A &m.
    have h7 := hop_7_pr A &m.
    have h8 := hop_8_pr A &m.
    have h9 := hop_9_pr A &m.
    have h10 := hop_10_pr A &m.
    have h11 := hop_11_pr A &m.
    have h12 := hop_12_pr A &m.
    have h13 := hop_13_pr A &m.
    have h14 := hop_14_pr A &m.
    have h15 := hop_15_pr A &m.
    smt(H_c.eps_KDFPRFSec_pos KEM_PQ_c.eps_KEMCorrectnessWithDK_pos KEM_PQ_c.eps_KEM_INDCCA_pos).
    qed.
end section Main.
