      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      rF <$ dfun_bs_lambda_bs_ct2len_pk2len_to_bs_outlen;
      _tup <@ KEM1.keygen();
      pk <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ KEM1.encaps(pk);
