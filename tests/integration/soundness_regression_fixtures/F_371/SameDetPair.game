// Positive control: a deterministic method call read twice is one value.
import 'Caller.primitive';

Game Left(Caller T, Int n) {
    Bool O(BitString<n> y) {
        return T.SameDet(y);
    }
}

Game Right(Caller T, Int n) {
    Bool O(BitString<n> y) {
        return true;
    }
}

export as SameDetPair;
