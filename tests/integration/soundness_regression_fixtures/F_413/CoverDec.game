// F-413: Dec tests whether c was encrypted, then tests the complement, both
// returning None, so the final return is unreachable and Left.Dec always
// returns None, as Right.Dec does. Interchangeable.

Game Left(Int n) {
    Set<BitString<n>> S;
    BitString<n> Enc(BitString<n> m) {
        S = S union {m};
        return m;
    }
    BitString<n>? Dec(BitString<n> c) {
        if (c in S) {
            return None;
        }
        if (!(c in S)) {
            return None;
        }
        return c;
    }
}

Game Right(Int n) {
    Set<BitString<n>> S;
    BitString<n> Enc(BitString<n> m) {
        S = S union {m};
        return m;
    }
    BitString<n>? Dec(BitString<n> c) {
        return None;
    }
}

export as CoverDec;
