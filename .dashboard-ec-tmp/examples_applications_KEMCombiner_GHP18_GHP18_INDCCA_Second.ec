  declare module KEM1 <: KEM1_c.Scheme {-F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS2, -G_StoredSS2_R, -KC_c.KEM_INDCCA_MultiChal_Random, -KC_c.KEM_INDCCA_MultiChal_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM2_L, -R_KEM2_R, -R_PRF_L, -R_PRF_R}.

