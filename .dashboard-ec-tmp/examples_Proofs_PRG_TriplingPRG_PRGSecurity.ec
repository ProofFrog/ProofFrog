    transitivity Step_0R_state_7(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply canon_bridge_0 |].
    transitivity Step_0R_state_6(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_0_right_6_rev |].
