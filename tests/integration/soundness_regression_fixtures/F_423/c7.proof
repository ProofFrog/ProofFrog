// Attack c7 (see SetReq6.scheme). UNSOUND if "Proof Succeeded": with
// so0 = {None}, Test returns true in Left and false in Right.
import 'Conv2.primitive';
import 'Src.primitive';
import 'SetReq6.scheme';
import 'r3.game';
proof:
let:
    Set K;
    Src P = Src(K);
    Set<BitString<8>?> so0;
    SetReq6 C = SetReq6(P, so0);
theorem:
    R3(C);
games:
    R3(C).Left against R3(C).Adversary;
    R3(C).Right against R3(C).Adversary;
