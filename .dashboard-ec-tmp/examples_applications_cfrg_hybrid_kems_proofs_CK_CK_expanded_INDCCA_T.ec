          _r11 <@ H.evaluate(kdf_in);
          _r5 <- Some (_r11);
        }
      }
      return _r5;
    }
  }.

  module R_PRF_Rev (KEM_PQ : KEM_PQ_c.Scheme, KEM_T : KEM_T_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme, Hybrid : Hybrid_c.Scheme, Challenger : H_c.KDFSecondKeyPRF_Oracle) = {
    var pq_keys : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace
    var t_keys : KEMTEncapsKeySpace * KEMTDecapsKeySpace
    var kem_ct_T : KEMTCiphertextSpace
