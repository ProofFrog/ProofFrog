  module G_AllRand (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : C_c.KEM_INDCCA_MultiChal_Oracle = {
    var rF : bs_lambda * bs_ct2len_pk2len -> bs_outlen
    var ss1Star : SS1Space
    var sk1 : SK1Space
    var sk2 : SK2Space
