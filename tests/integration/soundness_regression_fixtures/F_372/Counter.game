// A stateful oracle: Q counts its calls, Count reveals the count.
Game Left() {
    Int c;
    Void Initialize() { c = 0; }
    Bool Q() { c = c + 1; return true; }
    Int Count() { return c; }
}
Game Right() {
    Int c;
    Void Initialize() { c = 0; }
    Bool Q() { c = c + 1; return true; }
    Int Count() { return c; }
}
export as Counter;
