// Left updates pk only when b is true, so pk == g^sk fails after
// Upd(d, false) for d != 0. Right recomputes g^sk.
Game Left(Group G) {
    GroupElem<G> pk;
    ModInt<G.order> sk;

    GroupElem<G> Initialize() {
        ModInt<G.order> x <- ModInt<G.order>;
        pk = G.generator ^ x;
        sk = x;
        return pk;
    }

    GroupElem<G> Upd(ModInt<G.order> d, Bool b) {
        if (b) {
            pk = pk * G.generator ^ d;
            sk = sk + d;
        } else {
            sk = sk + d;
        }
        return pk;
    }
}

Game Right(Group G) {
    ModInt<G.order> sk;

    GroupElem<G> Initialize() {
        sk <- ModInt<G.order>;
        return G.generator ^ sk;
    }

    GroupElem<G> Upd(ModInt<G.order> d, Bool b) {
        sk = sk + d;
        return G.generator ^ sk;
    }
}

export as BranchInvariant;
