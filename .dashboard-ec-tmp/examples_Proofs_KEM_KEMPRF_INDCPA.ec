    proc initialize() : PKeySpace = {
      var __a0__ : PKeySpace * SKeySpace;
      __a0__ <@ K.keygen();
      pk <- __a0__.`1;
      sk <- __a0__.`2;
      return pk;
    }
    proc challenge() : bs_out * CiphertextSpace = {
      var __a1__ : SharedSecretSpace * CiphertextSpace;
      var __a3__ : CiphertextSpace;
      var _r0 : bs_out;
      var __a5__ : bs_out * CiphertextSpace;
      var __a6__ : bs_out;
      __a1__ <@ K.encaps(pk);
      __a3__ <- __a1__.`2;
      _r0 <@ F.evaluate(__a1__.`1, __a3__);
      __a5__ <- (_r0, __a3__);
      __a6__ <$ dbs_out;
      return (__a6__, __a5__.`2);
    }
  }.

