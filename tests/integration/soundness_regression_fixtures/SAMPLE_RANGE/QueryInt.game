// Both sides answer queries with a function given as a parameter.
Game Left(Int n, Function<BitString<n>, Int> H) {
    Int Query(BitString<n> x) {
        return H(x);
    }
}

Game Right(Int n, Function<BitString<n>, Int> H) {
    Int Query(BitString<n> x) {
        return H(x);
    }
}

export as QueryInt;
