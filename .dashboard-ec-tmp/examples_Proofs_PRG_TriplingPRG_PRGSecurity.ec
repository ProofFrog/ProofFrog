  lemma hop_4_chain :
    equiv [ Step_4L_state_0(G).query ~ Step_4R_state_0(G).query :
            ={glob G} ==> ={res, glob G} ].
  proof.
    (* Chain through per-transform micro-lemmas. *)
    transitivity Step_4L_state_1(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_0 |].
    transitivity Step_4L_state_2(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_1 |].
    transitivity Step_4L_state_3(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_2 |].
    transitivity Step_4L_state_4(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_3 |].
    transitivity Step_4L_state_5(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_4 |].
    transitivity Step_4L_state_6(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_5 |].
    transitivity Step_4L_state_7(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_6 |].
    transitivity Step_4L_state_8(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_7 |].
    transitivity Step_4L_state_9(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_8 |].
    transitivity Step_4L_state_10(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_left_9 |].
    transitivity Step_4R_state_6(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply canon_bridge_4 |].
    transitivity Step_4R_state_5(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_right_5_rev |].
    transitivity Step_4R_state_4(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_right_4_rev |].
    transitivity Step_4R_state_3(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_right_3_rev |].
    transitivity Step_4R_state_2(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_right_2_rev |].
    transitivity Step_4R_state_1(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply micro_4_right_1_rev |].
    apply micro_4_right_0_rev.
  qed.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0 :
    equiv [ T_c.PRGSecurity_Real(TriplingPRG(G)).query ~ R1(G, TriplingPRG(G), G_c.PRGSecurity_Real(G)).query :
            ={glob G} ==> ={res, glob G} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_0L_state_0(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_0R_state_0(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply hop_0_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  lemma hop_2 :
    equiv [ R1(G, TriplingPRG(G), G_c.PRGSecurity_Random(G)).query ~ R3(G, TriplingPRG(G), G_c.PRGSecurity_Real(G)).query :
            ={glob G} ==> ={res, glob G} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_2L_state_0(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_2R_state_0(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply hop_2_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  lemma hop_4 :
    equiv [ R3(G, TriplingPRG(G), G_c.PRGSecurity_Random(G)).query ~ T_c.PRGSecurity_Random(TriplingPRG(G)).query :
            ={glob G} ==> ={res, glob G} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_4L_state_0(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_4R_state_0(G).query (={glob G} ==> ={res, glob G}) (={glob G} ==> ={res, glob G}); [ smt() | smt() | apply hop_4_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: T_c.PRGSecurity_Adv {-G}) &m :
    Pr[Game_step_0(G, A).main() @ &m : res] = Pr[Game_step_1(G, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob G} ==> ={res}) => //; proc.
    call (_: ={glob G}); first by conseq hop_0.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the PRGSecurity_advantage axiom applied to R1_Adv. *)

  lemma hop_1_pr (A <: T_c.PRGSecurity_Adv {-G}) &m :
    `| Pr[Game_step_1(G, A).main() @ &m : res] - Pr[Game_step_2(G, A).main() @ &m : res] | <= G_c.eps_PRGSecurity.
  proof.
    have hL : Pr[Game_step_1(G, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSecurity_Real(G, R1_Adv(G, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(G, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSecurity_Random(G, R1_Adv(G, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    rewrite hL hR.
    apply (G_c.PRGSecurity_advantage G (R1_Adv(G, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: T_c.PRGSecurity_Adv {-G}) &m :
    Pr[Game_step_2(G, A).main() @ &m : res] = Pr[Game_step_3(G, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob G} ==> ={res}) => //; proc.
    call (_: ={glob G}); first by conseq hop_2.
    auto.
    qed.

  (* Hop 3: assumption hop. Bounded by the PRGSecurity_advantage axiom applied to R3_Adv. *)

  lemma hop_3_pr (A <: T_c.PRGSecurity_Adv {-G}) &m :
    `| Pr[Game_step_3(G, A).main() @ &m : res] - Pr[Game_step_4(G, A).main() @ &m : res] | <= G_c.eps_PRGSecurity.
  proof.
    have hL : Pr[Game_step_3(G, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSecurity_Real(G, R3_Adv(G, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    have hR : Pr[Game_step_4(G, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSecurity_Random(G, R3_Adv(G, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    rewrite hL hR.
    apply (G_c.PRGSecurity_advantage G (R3_Adv(G, A)) &m).
    qed.

  (* Hop 4: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_4_pr (A <: T_c.PRGSecurity_Adv {-G}) &m :
    Pr[Game_step_4(G, A).main() @ &m : res] = Pr[Game_step_5(G, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob G} ==> ={res}) => //; proc.
    call (_: ={glob G}); first by conseq hop_4.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: T_c.PRGSecurity_Adv {-G}) &m :
    `| Pr[Game_step_0(G, A).main() @ &m : res] - Pr[Game_step_5(G, A).main() @ &m : res] | <= G_c.eps_PRGSecurity + G_c.eps_PRGSecurity.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    smt(G_c.eps_PRGSecurity_pos).
    qed.
end section Main.
