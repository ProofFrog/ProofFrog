// Left runs Test with modulus c before counting c up, Right after.
// First call f(2, true): Left uses ModInt<2>, stores 2 = 0, returns true;
// Right uses ModInt<3>, 2 + 2 = 1 != 2, returns false. Advantage 1.
import 'ModQ.primitive';

Game Left(ModQ E) {
    Int c = 2;
    Bool f(Int a, Bool b) {
        Bool r = E.Test(c, a, b);
        c = c + 1;
        return r;
    }
}

Game Right(ModQ E) {
    Int c = 2;
    Bool f(Int a, Bool b) {
        c = c + 1;
        Bool r = E.Test(c, a, b);
        return r;
    }
}

export as ModQPair;
