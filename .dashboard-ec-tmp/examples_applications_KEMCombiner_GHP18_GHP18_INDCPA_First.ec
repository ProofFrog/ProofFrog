  declare module KEM1 <: KEM1_c.Scheme {-G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}.

  declare module KEM2 <: KEM2_c.Scheme {-KEM1, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}.

  declare module F <: F_c.Scheme {-KEM1, -KEM2, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}.

  (* ===== Deterministic-method specs ===== *)

  declare axiom KEM1_decaps_det (g : (glob KEM1)) (a0 : SK1Space) (a1 : CT1Space) : phoare[ KEM1.decaps : (glob KEM1) = g /\ sk = a0 /\ m = a1 ==> (glob KEM1) = g /\ res = KEM1_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom KEM2_decaps_det (g : (glob KEM2)) (a0 : SK2Space) (a1 : CT2Space) : phoare[ KEM2.decaps : (glob KEM2) = g /\ sk = a0 /\ m = a1 ==> (glob KEM2) = g /\ res = KEM2_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom F_evaluate_det (g : (glob F)) (a0 : bs_ss1len) (a1 : bs_ss2len) (a2 : bs_ct1len_ct2len_pk1len_pk2len) : phoare[ F.evaluate : (glob F) = g /\ key1 = a0 /\ key2 = a1 /\ input = a2 ==> (glob F) = g /\ res = F_c.ev_evaluate a0 a1 a2 ] = 1%r.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0_initialize :
    equiv [ KC_c.KEM_INDCPA_MultiChal_Real(KEMCombiner(KEM1, KEM2, F)).initialize ~ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Real(KEM1)).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`1{1} = R_KEM1.pk1{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`2{1} = R_KEM1.pk2{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk{1} = KEM1_c.KEM_INDCPA_MultiChal_Real.pk{2} ].
  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

  lemma hop_0_challenge :
    equiv [ KC_c.KEM_INDCPA_MultiChal_Real(KEMCombiner(KEM1, KEM2, F)).challenge ~ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Real(KEM1)).challenge :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`1{1} = R_KEM1.pk1{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`2{1} = R_KEM1.pk2{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk{1} = KEM1_c.KEM_INDCPA_MultiChal_Real.pk{2} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`1{1} = R_KEM1.pk1{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`2{1} = R_KEM1.pk2{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk{1} = KEM1_c.KEM_INDCPA_MultiChal_Real.pk{2} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 0, oracle 'challenge': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_2_initialize :
    equiv [ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Random(KEM1)).initialize ~ G1_RandKey(KEM1, KEM2, F).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{2} = R_KEM1.pk1{1} /\ G1_RandKey.pk2{2} = R_KEM1.pk2{1} ].
  proof.
    (* resolution: synth-static *)
    proc; inline *; sim.
    qed.

  lemma hop_2_challenge :
    equiv [ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEM_INDCPA_MultiChal_Random(KEM1)).challenge ~ G1_RandKey(KEM1, KEM2, F).challenge :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{2} = R_KEM1.pk1{1} /\ G1_RandKey.pk2{2} = R_KEM1.pk2{1} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{2} = R_KEM1.pk1{1} /\ G1_RandKey.pk2{2} = R_KEM1.pk2{1} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 2, oracle 'challenge': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_3_initialize :
    equiv [ G1_RandKey(KEM1, KEM2, F).initialize ~ R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Real(F)).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{1} = R_PRF1.pk1{2} /\ G1_RandKey.pk2{1} = R_PRF1.pk2{2} ].
  proof.
    (* resolution: synth-static *)
    proc; inline *; sim.
    qed.

  lemma hop_3_challenge :
    equiv [ G1_RandKey(KEM1, KEM2, F).challenge ~ R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Real(F)).challenge :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{1} = R_PRF1.pk1{2} /\ G1_RandKey.pk2{1} = R_PRF1.pk2{2} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{1} = R_PRF1.pk1{2} /\ G1_RandKey.pk2{1} = R_PRF1.pk2{2} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 3, oracle 'challenge': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_5_initialize :
    equiv [ R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Random(F)).initialize ~ KC_c.KEM_INDCPA_MultiChal_Random(KEMCombiner(KEM1, KEM2, F)).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ].
  proof.
    (* resolution: synth-static *)
    proc; inline *; sim.
    qed.

  lemma hop_5_challenge :
    equiv [ R_PRF1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), F_c.TwoKeyPRFFirstKeyMultiKey_Random(F)).challenge ~ KC_c.KEM_INDCPA_MultiChal_Random(KEMCombiner(KEM1, KEM2, F)).challenge :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 5, oracle 'challenge': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: KC_c.KEM_INDCPA_MultiChal_Adv {-KEM1, -KEM2, -F, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}) &m :
    Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`1{1} = R_KEM1.pk1{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk.`2{1} = R_KEM1.pk2{2} /\ KC_c.KEM_INDCPA_MultiChal_Real.pk{1} = KEM1_c.KEM_INDCPA_MultiChal_Real.pk{2}).
    + conseq hop_0_challenge.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEM_INDCPA_MultiChal_advantage axiom applied to R_KEM1_Adv. *)

  lemma hop_1_pr (A <: KC_c.KEM_INDCPA_MultiChal_Adv {-KEM1, -KEM2, -F, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}) &m :
    `| Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM1_c.eps_KEM_INDCPA_MultiChal.
  proof.
    have hL : Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM1_c.Game_KEM_INDCPA_MultiChal_Real(KEM1, R_KEM1_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM1, glob KEM1, glob KEM2, glob F, glob KEM1_c.KEM_INDCPA_MultiChal_Real}); [ proc; sim | wp; call (_: true); wp; call (_: true); skip => /# ].
    have hR : Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM1_c.Game_KEM_INDCPA_MultiChal_Random(KEM1, R_KEM1_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob R_KEM1, glob KEM1, glob KEM2, glob F, glob KEM1_c.KEM_INDCPA_MultiChal_Random}); [ proc; sim | wp; call (_: true); wp; call (_: true); skip => /# ].
    rewrite hL hR.
    apply (KEM1_c.KEM_INDCPA_MultiChal_advantage KEM1 (R_KEM1_Adv(KEM1, KEM2, F, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: KC_c.KEM_INDCPA_MultiChal_Adv {-KEM1, -KEM2, -F, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}) &m :
    Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{2} = R_KEM1.pk1{1} /\ G1_RandKey.pk2{2} = R_KEM1.pk2{1}).
    + conseq hop_2_challenge.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_3_pr (A <: KC_c.KEM_INDCPA_MultiChal_Adv {-KEM1, -KEM2, -F, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}) &m :
    Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G1_RandKey.pk1{1} = R_PRF1.pk1{2} /\ G1_RandKey.pk2{1} = R_PRF1.pk2{2}).
    + conseq hop_3_challenge.
    call hop_3_initialize.
    auto.
    qed.

  (* Hop 4: assumption hop. Bounded by the TwoKeyPRFFirstKeyMultiKey_advantage axiom applied to R_PRF1_Adv. *)

  lemma hop_4_pr (A <: KC_c.KEM_INDCPA_MultiChal_Adv {-KEM1, -KEM2, -F, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}) &m :
    `| Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res] | <= F_c.eps_TwoKeyPRFFirstKeyMultiKey.
  proof.
    have hL : Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[F_c.Game_TwoKeyPRFFirstKeyMultiKey_Real(F, R_PRF1_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[F_c.Game_TwoKeyPRFFirstKeyMultiKey_Random(F, R_PRF1_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (F_c.TwoKeyPRFFirstKeyMultiKey_advantage F (R_PRF1_Adv(KEM1, KEM2, F, A)) &m).
    qed.

  (* Hop 5: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_5_pr (A <: KC_c.KEM_INDCPA_MultiChal_Adv {-KEM1, -KEM2, -F, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}) &m :
    Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_6(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F}).
    + conseq hop_5_challenge.
    call hop_5_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: KC_c.KEM_INDCPA_MultiChal_Adv {-KEM1, -KEM2, -F, -G1_RandKey, -KC_c.KEM_INDCPA_MultiChal_Random, -KC_c.KEM_INDCPA_MultiChal_Real, -KEM1_c.KEM_INDCPA_MultiChal_Random, -KEM1_c.KEM_INDCPA_MultiChal_Real, -R_KEM1, -R_PRF1}) &m :
    `| Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_6(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM1_c.eps_KEM_INDCPA_MultiChal + F_c.eps_TwoKeyPRFFirstKeyMultiKey.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    smt(F_c.eps_TwoKeyPRFFirstKeyMultiKey_pos KEM1_c.eps_KEM_INDCPA_MultiChal_pos).
    qed.
end section Main.
