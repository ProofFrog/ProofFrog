      return (__a4__, __a5__, __a5__);
    }
  }.

  module Step_2L_state_7_fdet (K : K_c.Scheme, F : F_c.Scheme) = {
    proc compute(pk : PKeySpace, sk : SKeySpace) : bs_in * bs_out * bs_out = {
      var __a0__ : bs_lambda * bs_in;
      var __a4__ : bs_in;
      var __a5__ : bs_out;
      __a0__ <@ K.encaps(pk);
      __a4__ <- __a0__.`2;
      __a5__ <- F_c.ev_evaluate (__a0__.`1) (__a4__);
      return (__a4__, __a5__, __a5__);
    }
  }.

  (* transform: Inline Single-Use Variables (bucket=canned) *)
  lemma micro_2_left_6 :
    equiv [ Step_2L_state_6(K, F).compute ~ Step_2L_state_7(K, F).compute :
            ={pk, sk, glob K, glob F} ==> ={res, glob K, glob F} ].
  proof.
    (* resolution: synth-param *)
    transitivity Step_2L_state_6_fdet(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}).
    smt().
    smt().
    proc.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__}).
    call (_: true); auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__, __a4__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__, __a4__, __a5__}).
    wp.
    exists* (glob F){1}, (__a1__){1}, (__a4__){1}; elim* => g0 a0_0 a0_1.
    call{1} (F_evaluate_det g0 a0_0 a0_1).
    auto.
    skip => /#.
    transitivity Step_2L_state_7_fdet(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}).
    smt().
    smt().
    proc.
    wp.
    call (_: true).
    skip => /#.
    proc.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__}).
    call (_: true); auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a4__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a4__, __a5__}).
    wp.
    exists* (glob F){2}, (__a0__.`1){2}, (__a4__){2}; elim* => g1 a1_0 a1_1.
    call{2} (F_evaluate_det g1 a1_0 a1_1).
    auto.
    skip => /#.
  qed.

