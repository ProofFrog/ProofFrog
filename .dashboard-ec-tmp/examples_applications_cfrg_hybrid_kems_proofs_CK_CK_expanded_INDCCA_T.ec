    proc initialize() : (KEMPQEncapsKeySpace * KEMTEncapsKeySpace) * bs_kdf_nout * (KEMPQCiphertextSpace * KEMTCiphertextSpace) = {
      var ek_PQ : KEMPQEncapsKeySpace;
      var ek_T : KEMTEncapsKeySpace;
      var _tup : KEMPQSharedSecretSpace * KEMPQCiphertextSpace;
      var ss_PQ : KEMPQSharedSecretSpace;
