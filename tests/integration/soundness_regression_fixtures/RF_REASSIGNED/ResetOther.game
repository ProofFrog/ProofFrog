// Positive control: Reset writes the field G, not H, so H stays the random
// function sampled in Initialize and every Q query is a fresh <-uniq[T] draw.
import 'P.primitive';

Game Left(P S) {
    Function<BitString<2>, BitString<2>> H;
    Function<BitString<2>, BitString<2>> G;
    Set<BitString<2>> T;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
    }
    Void Reset(Function<BitString<2>, BitString<2>> F) {
        G = F;
    }
    BitString<2> Q() {
        BitString<2> r <-uniq[T] BitString<2>;
        BitString<2> z = H(r);
        return z;
    }
}

Game Right(P S) {
    Function<BitString<2>, BitString<2>> H;
    Function<BitString<2>, BitString<2>> G;
    Set<BitString<2>> T;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
    }
    Void Reset(Function<BitString<2>, BitString<2>> F) {
        G = F;
    }
    BitString<2> Q() {
        BitString<2> r <-uniq[T] BitString<2>;
        BitString<2> z <- BitString<2>;
        return z;
    }
}

export as ResetOther;
