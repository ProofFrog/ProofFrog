      var v5 : bs_ct2len;
      var _r0 : SS1Space;
      var _r1 : SS2Space;
      var _r3 : bs_outlen;
      if (c = (field3, field1)) {
        _r2 <- None;
      } else {
        v5 <- c.`2;
        _r0 <@ KEM1.decaps(field4, c.`1);
        _r1 <@ KEM2.decaps(field5, v5);
        _r3 <@ F.evaluate(_r0, _r1, concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len v5 field2);
        _r2 <- Some (_r3);
      }
      return _r2;
    }
  }.

  declare module KEM1 <: KEM1_c.Scheme {-C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}.

  declare module KEM2 <: KEM2_c.Scheme {-KEM1, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}.

  declare module F <: F_c.Scheme {-KEM1, -KEM2, -C_c.KEM_INDCCA_MultiChal_Random, -C_c.KEM_INDCCA_MultiChal_Real, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS2, -G_StoredSS2, -G_StoredSS2_R, -G_Unwound, -KEM1_c.KEM_C2PRI_Ideal, -KEM1_c.KEM_C2PRI_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_2L, -R_Correct_2R, -R_KEM2_L, -R_KEM2_R, -R_PRF_Fwd, -R_PRF_Rev}.

  (* ===== Deterministic-method specs ===== *)

  declare axiom KEM1_decaps_det (g : (glob KEM1)) (a0 : SK1Space) (a1 : CT1Space) : phoare[ KEM1.decaps : (glob KEM1) = g /\ sk = a0 /\ m = a1 ==> (glob KEM1) = g /\ res = KEM1_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom KEM2_decaps_det (g : (glob KEM2)) (a0 : SK2Space) (a1 : CT2Space) : phoare[ KEM2.decaps : (glob KEM2) = g /\ sk = a0 /\ m = a1 ==> (glob KEM2) = g /\ res = KEM2_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom F_evaluate_det (g : (glob F)) (a0 : bs_lambda) (a1 : bs_ss2len) (a2 : bs_ct2len_pk2len) : phoare[ F.evaluate : (glob F) = g /\ key1 = a0 /\ key2 = a1 /\ input = a2 ==> (glob F) = g /\ res = F_c.ev_evaluate a0 a1 a2 ] = 1%r.

  (* ===== Glob-preservation specs (dead-call drop) ===== *)

  declare axiom KEM2_decaps_pres (g : (glob KEM2)) : phoare[ KEM2.decaps : (glob KEM2) = g ==> (glob KEM2) = g ] = 1%r.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0_initialize :
    equiv [ C_c.KEM_INDCCA_MultiChal_Real(CK(KEM1, KEM2, F)).initialize ~ R_Correct_2L(KEM1, KEM2, F, CK(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromDecaps(KEM2)).initialize :
            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ].
  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    wp.
    call (_: true).
    wp.
    exists* (glob KEM2){2}; elim* => gf0.
    call{2} (KEM2_decaps_pres gf0).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

  lemma hop_0_decaps :
    equiv [ C_c.KEM_INDCCA_MultiChal_Real(CK(KEM1, KEM2, F)).decaps ~ R_Correct_2L(KEM1, KEM2, F, CK(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromDecaps(KEM2)).decaps :
            ={c} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 0, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

