  module R_Correct_Real_Adv (KEM_PQ : KEM_PQ_c.Scheme, KEM_T : KEM_T_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme, A : Hybrid_c.KEM_INDCCA_Adv, C : KEM_PQ_c.KEMCorrectnessWithDK_Oracle) = {
    proc distinguish() : bool = {
      var b : bool;
      var pk0 : (KEMPQEncapsKeySpace * KEMTEncapsKeySpace) * bs_kdf_nout * (KEMPQCiphertextSpace * KEMTCiphertextSpace);
      pk0 <@ R_Correct_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), C).initialize();
      b <@ A(R_Correct_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), C)).distinguish(pk0);
      return b;
    }
  }.

