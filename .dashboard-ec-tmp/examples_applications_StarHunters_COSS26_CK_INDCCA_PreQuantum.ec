      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct2 = ct2Star) {
          isSecondPreimage <@ Challenger.submit(ct1);
          if (isSecondPreimage) {
            r <$ dbs_outlen;
            _r0 <- Some (r);
          } else {
            _r1 <@ F.evaluate(ss1, ss2Star, label);
            _r0 <- Some (_r1);
          }
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

