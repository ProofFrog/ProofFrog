// F-406 positive control: BitString<1> \ {0b0} keeps the element 0b1, so the
// unused draw always completes and is dead code.
Game Left() {
    Bool Test() {
        BitString<1> x <- BitString<1> \ {0b0};
        return true;
    }
}
Game Right() {
    Bool Test() {
        return true;
    }
}
export as G1d;
