  (* ===== Reductions lifted to assumption-adversaries ===== *)

  module R_Correct_L_Adv (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : C_c.KEM_INDCCA_MultiChal_Adv, C : KEM1_c.KEMCorrectness_Oracle) = {
    proc distinguish() : bool = {
      var b : bool;
      var pk0 : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space);
      pk0 <@ R_Correct_L(KEM1, KEM2, F, CK(KEM1, KEM2, F), C).initialize();
      b <@ A(R_Correct_L(KEM1, KEM2, F, CK(KEM1, KEM2, F), C)).distinguish(pk0);
      return b;
    }
  }.

  module R_Correct_R_Adv (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : C_c.KEM_INDCCA_MultiChal_Adv, C : KEM1_c.KEMCorrectness_Oracle) = {
