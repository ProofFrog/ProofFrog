    qed.

  (* Hop 23: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_23_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -KEM_T, -G, -H, -L, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_23(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] = Pr[Game_step_24(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.dk.`1{2} = R_Correct_T_Ideal.pq_keys.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`2{2} = R_Correct_T_Ideal.corr.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`3{2} = R_Correct_T_Ideal.corr.`1{1} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_Correct_T_Ideal.ctStar{1} /\ R_Correct_T_Ideal.corr{1}.`5 = KEM_T_c.ev_decaps (R_Correct_T_Ideal.corr{1}.`2) (R_Correct_T_Ideal.corr{1}.`3)).
    + conseq hop_23_decaps.
    call hop_23_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -KEM_T, -G, -H, -L, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_0(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] - Pr[Game_step_24(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] | <= KEM_T_c.eps_KEMCorrectnessWithDK + KEM_T_c.eps_KEM_INDCCA + KEM_PQ_c.eps_KEM_C2PRI + H_c.eps_KDFSecondKeyPRF + H_c.eps_KDFSecondKeyPRF + KEM_PQ_c.eps_KEM_C2PRI + KEM_T_c.eps_KEM_INDCCA + KEM_T_c.eps_KEMCorrectnessWithDK.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    have h6 := hop_6_pr A &m.
    have h7 := hop_7_pr A &m.
    have h8 := hop_8_pr A &m.
    have h9 := hop_9_pr A &m.
    have h10 := hop_10_pr A &m.
    have h11 := hop_11_pr A &m.
    have h12 := hop_12_pr A &m.
    have h13 := hop_13_pr A &m.
    have h14 := hop_14_pr A &m.
    have h15 := hop_15_pr A &m.
    have h16 := hop_16_pr A &m.
    have h17 := hop_17_pr A &m.
    have h18 := hop_18_pr A &m.
    have h19 := hop_19_pr A &m.
    have h20 := hop_20_pr A &m.
    have h21 := hop_21_pr A &m.
    have h22 := hop_22_pr A &m.
    have h23 := hop_23_pr A &m.
    smt(H_c.eps_KDFSecondKeyPRF_pos KEM_PQ_c.eps_KEM_C2PRI_pos KEM_T_c.eps_KEMCorrectnessWithDK_pos KEM_T_c.eps_KEM_INDCCA_pos).
    qed.
end section Main.
