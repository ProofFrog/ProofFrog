// Target: method inliner (visitors.InlineTransformer), the returned
// expression of a callee replaced into the call site.
// Hypothesis: the inliner replaces a call by the callee's returned
// expression in place, unbound, so a field read in it is evaluated after
// every later call in the same statement, whose body the inliner puts in
// front of the statement: `challenger.Read() + challenger.Inc()` reads the
// counter after Inc's increment.
// Sound engine: fails at hop 3. Hop 1 is true, but the engine does not fold
// the `+ 0` of Inc's result there (read_then_inc_plus_zero.proof writes
// Left with it).
// Unsound engine: fails at hop 1 only; hop 3 (false) accepted.
import 'Cnt.game';
import 'RO.game';

// challenger.Read() is evaluated before challenger.Inc(), so the reduction
// returns the count before the increment: composed with Cnt it is
// RO().Left (hop 1 true, hop 3 false).
Reduction R() compose Cnt() against RO().Adversary {
    Void Initialize() { challenger.Initialize(); }
    Int Test() { return challenger.Read() + challenger.Inc(); }
}

proof:
let:
assume:
    Cnt();
theorem:
    RO();
games:
    RO().Left against RO().Adversary;
    Cnt().Left compose R() against RO().Adversary;
    Cnt().Right compose R() against RO().Adversary;
    RO().Right against RO().Adversary;
