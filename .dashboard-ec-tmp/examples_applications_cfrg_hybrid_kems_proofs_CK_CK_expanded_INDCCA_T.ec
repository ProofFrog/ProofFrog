      var _r0 : bs_kem_pq_nss;
      var _r1 : bs_kem_t_nss;
      var _r2 : bs_kem_t_nct;
      var _r3 : bs_kem_t_nek;
      var _r4 : bs_nlabel;
      var kdf_in : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel;
      var ss : bs_kdf_nout;
      pq_keys <@ KEM_PQ.keygen();
      t_keys <@ KEM_T.keygen();
      ek_PQ <- pq_keys.`1;
      ek_T <- t_keys.`1;
      _tup <@ KEM_PQ.encaps(ek_PQ);
      ss_PQ <- _tup.`1;
      ct_PQ <- _tup.`2;
      _tup_0 <@ KEM_T.encaps(ek_T);
      ss_T_star <- _tup_0.`1;
      kem_ct_T <- _tup_0.`2;
