// Check(x) reports whether x is None, through a helper that takes an optional Elem.
// For an abstract K the comparison only type checks through the helper's Elem? parameter.
import 'Checker.primitive';

Scheme NoneCheck(Set K) extends Checker {
    Set Elem = K;

    Bool Check(Elem x) {
        return this.IsNone(x);
    }

    Bool IsNone(Elem? v) {
        return v == None;
    }
}
