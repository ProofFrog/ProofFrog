            ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} ==> ={res} /\ ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2.sk1{2} = R_Correct_2L.sk1{1} /\ G_StoredSS2.sk2{2} = R_Correct_2L.sk2{1} /\ G_StoredSS2.pk2{2} = R_Correct_2L.pk2{1} /\ G_StoredSS2.ct1Star{2} = R_Correct_2L.ct1Star{1} /\ G_StoredSS2.ct2Star{2} = R_Correct_2L.ct2Star{1} /\ R_Correct_2L._tup_2{1}.`3 = R_Correct_2L._tup_2{1}.`2 ].
