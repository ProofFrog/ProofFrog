proof.
  move => a b.
  rewrite /slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss /concat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofwordK _ (size_cat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel a b)) drop0.
  have ->: kem_pq_nss - 0 = kem_pq_nss by smt().
  by rewrite (take_size_cat _ _ _ (BW_bs_kem_pq_nss.size_word a)) BW_bs_kem_pq_nss.mkwordK.
qed.

lemma slice_concat_right_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel :
  forall (a : bs_kem_pq_nss) (b : bs_2_ng_nelem_ng_nss_nlabel),
  slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_2_ng_nelem_ng_nss_nlabel (concat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel a b) kem_pq_nss (kem_pq_nss + 2*ng_nelem + ng_nss + nlabel) = b.
proof.
  move => a b.
  rewrite /slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_2_ng_nelem_ng_nss_nlabel /concat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofwordK _ (size_cat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel a b)).
  have ->: (kem_pq_nss + 2*ng_nelem + ng_nss + nlabel) - kem_pq_nss = (2*ng_nelem + ng_nss + nlabel) by smt().
  rewrite (drop_size_cat _ _ _ (BW_bs_kem_pq_nss.size_word a)).
  have hb : size (BW_bs_2_ng_nelem_ng_nss_nlabel.ofword b) = (2*ng_nelem + ng_nss + nlabel) by exact BW_bs_2_ng_nelem_ng_nss_nlabel.size_word.
  by rewrite -hb take_size BW_bs_2_ng_nelem_ng_nss_nlabel.mkwordK.
qed.

lemma concat_slices_id_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel :
  forall (s : bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel),
  concat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel (slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss s 0 kem_pq_nss) (slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_2_ng_nelem_ng_nss_nlabel s kem_pq_nss (kem_pq_nss + 2*ng_nelem + ng_nss + nlabel)) = s.
proof.
  move => s.
  have hs : size (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofword s) = kem_pq_nss + 2*ng_nelem + ng_nss + nlabel by exact BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.size_word.
  rewrite /concat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel /slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss /slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_2_ng_nelem_ng_nss_nlabel drop0.
  have ->: kem_pq_nss - 0 = kem_pq_nss by smt().
  have ->: (kem_pq_nss + 2*ng_nelem + ng_nss + nlabel) - kem_pq_nss = (2*ng_nelem + ng_nss + nlabel) by smt().
  have h1 : size (take kem_pq_nss (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofword s)) = kem_pq_nss
    by rewrite size_take; smt(gt0_kem_pq_nss gt0_ng_nelem gt0_ng_nss gt0_nlabel).
  have hd : size (drop kem_pq_nss (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofword s)) = (2*ng_nelem + ng_nss + nlabel)
    by rewrite size_drop; smt(gt0_kem_pq_nss gt0_ng_nelem gt0_ng_nss gt0_nlabel).
  have ht : take (2*ng_nelem + ng_nss + nlabel) (drop kem_pq_nss (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofword s))
          = drop kem_pq_nss (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofword s)
    by rewrite take_oversize // hd.
  have h2 : size (take (2*ng_nelem + ng_nss + nlabel) (drop kem_pq_nss (BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.ofword s))) = (2*ng_nelem + ng_nss + nlabel)
    by rewrite ht hd.
  rewrite (BW_bs_kem_pq_nss.ofwordK _ h1) (BW_bs_2_ng_nelem_ng_nss_nlabel.ofwordK _ h2) ht.
  by rewrite cat_take_drop BW_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.mkwordK.
qed.

lemma dbs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_split_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel :
  dbs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel =
  dmap (dbs_kem_pq_nss `*` dbs_2_ng_nelem_ng_nss_nlabel)
       (fun (p : bs_kem_pq_nss * bs_2_ng_nelem_ng_nss_nlabel) => concat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel p.`1 p.`2).
proof.
  apply: eq_funi_ll.
  + exact dbs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_fu.
  + exact dbs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_ll.
  + apply: is_full_funiform.
    + apply: dmap_fu_in => w.
      exists (slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss w 0 kem_pq_nss, slice_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel_to_bs_2_ng_nelem_ng_nss_nlabel w kem_pq_nss (kem_pq_nss + 2*ng_nelem + ng_nss + nlabel)).
      rewrite supp_dprod /=; split.
      + by split; [exact dbs_kem_pq_nss_full | exact dbs_2_ng_nelem_ng_nss_nlabel_full].
      by rewrite concat_slices_id_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.
    apply: dmap_uni_in_inj.
    + move => [x1 y1] [x2 y2] _ _ /= heq.
      have hx : x1 = x2 by rewrite -(slice_concat_left_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel x1 y1) -(slice_concat_left_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel x2 y2) heq.
      have hy : y1 = y2 by rewrite -(slice_concat_right_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel x1 y1) -(slice_concat_right_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel x2 y2) heq.
      by rewrite hx hy.
    by apply: dprod_uni; apply: funi_uni; [exact dbs_kem_pq_nss_fu | exact dbs_2_ng_nelem_ng_nss_nlabel_fu].
  apply: dmap_ll; rewrite dprod_ll.
  by split; [exact dbs_kem_pq_nss_ll | exact dbs_2_ng_nelem_ng_nss_nlabel_ll].
qed.

(* ===== Abstract theory: primitive + security games + assumption ===== *)

abstract theory KEM_Theory.
  type encapskey.

  type decapskey.

  type sharedsecret.

  type ciphertext.

  type bs_Nseed_t.

  op zero_Nseed_t : bs_Nseed_t.

  type bs_Nss_t.

  op zero_Nss_t : bs_Nss_t.

  type bs_Nct_t.

  op zero_Nct_t : bs_Nct_t.

  type bs_Nek_t.

  op zero_Nek_t : bs_Nek_t.

  op dsharedsecret : sharedsecret distr.

  axiom dsharedsecret_ll : is_lossless dsharedsecret.

  axiom dsharedsecret_fu : is_funiform dsharedsecret.

  axiom dsharedsecret_full : is_full dsharedsecret.

  op dbs_Nseed_t : bs_Nseed_t distr.

  axiom dbs_Nseed_t_ll : is_lossless dbs_Nseed_t.

  axiom dbs_Nseed_t_fu : is_funiform dbs_Nseed_t.

  axiom dbs_Nseed_t_full : is_full dbs_Nseed_t.

  module type Scheme = {
    proc keygen() : encapskey * decapskey
    proc derivekeypair(seed : bs_Nseed_t) : encapskey * decapskey
    proc encaps(ek : encapskey) : sharedsecret * ciphertext
    proc decaps(dk : decapskey, ct : ciphertext) : sharedsecret
    proc encodesharedsecret(ss : sharedsecret) : bs_Nss_t
    proc encodeciphertext(ct : ciphertext) : bs_Nct_t
    proc encodeencapskey(ek : encapskey) : bs_Nek_t
  }.

  op ev_derivekeypair : bs_Nseed_t -> encapskey * decapskey.

  op ev_decaps : decapskey -> ciphertext -> sharedsecret.

  op ev_encodesharedsecret : sharedsecret -> bs_Nss_t.

  op ev_encodeciphertext : ciphertext -> bs_Nct_t.

  op ev_encodeencapskey : encapskey -> bs_Nek_t.

  module type KEM_INDCCA_Oracle = {
    proc initialize() : encapskey * sharedsecret * ciphertext
    proc decaps(ct : ciphertext) : sharedsecret option
  }.

  module KEM_INDCCA_Real (K : Scheme) : KEM_INDCCA_Oracle = {
    var dk : decapskey
    var ctStar : ciphertext
    proc initialize() : encapskey * sharedsecret * ciphertext = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ssStar : sharedsecret;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ssStar <- _tup_0.`1;
      ctStar <- _tup_0.`2;
      return (ek, ssStar, ctStar);
    }
    proc decaps(ct : ciphertext) : sharedsecret option = {
      var _r0 : sharedsecret option;
      var _r1 : sharedsecret;
      if (ct = ctStar) {
        _r0 <- None;
      } else {
        _r1 <@ K.decaps(dk, ct);
        _r0 <- Some (_r1);
      }
      return _r0;
    }
  }.

  module KEM_INDCCA_Random (K : Scheme) : KEM_INDCCA_Oracle = {
    var dk : decapskey
    var ctStar : ciphertext
    proc initialize() : encapskey * sharedsecret * ciphertext = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss_unused : sharedsecret;
      var ssStar : sharedsecret;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ss_unused <- _tup_0.`1;
      ctStar <- _tup_0.`2;
      ssStar <$ dsharedsecret;
      return (ek, ssStar, ctStar);
    }
    proc decaps(ct : ciphertext) : sharedsecret option = {
      var _r0 : sharedsecret option;
      var _r1 : sharedsecret;
      if (ct = ctStar) {
        _r0 <- None;
      } else {
        _r1 <@ K.decaps(dk, ct);
        _r0 <- Some (_r1);
      }
      return _r0;
    }
  }.

  module type KEM_INDCCA_Adv (O : KEM_INDCCA_Oracle) = {
    proc distinguish(pk : encapskey * sharedsecret * ciphertext) : bool {O.decaps}
  }.

  module type KEMCorrectnessWithDK_Oracle = {
    proc compute() : encapskey * decapskey * ciphertext * sharedsecret * sharedsecret
  }.

  module KEMCorrectnessWithDK_FromDecaps (K : Scheme) : KEMCorrectnessWithDK_Oracle = {
    proc compute() : encapskey * decapskey * ciphertext * sharedsecret * sharedsecret = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var dk : decapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ct : ciphertext;
      var ss_d : sharedsecret;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ss <- _tup_0.`1;
      ct <- _tup_0.`2;
      ss_d <@ K.decaps(dk, ct);
      return (ek, dk, ct, ss, ss_d);
    }
  }.

  module KEMCorrectnessWithDK_FromEncaps (K : Scheme) : KEMCorrectnessWithDK_Oracle = {
    proc compute() : encapskey * decapskey * ciphertext * sharedsecret * sharedsecret = {
      var _tup : encapskey * decapskey;
      var ek : encapskey;
      var dk : decapskey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ct : ciphertext;
      _tup <@ K.keygen();
      ek <- _tup.`1;
      dk <- _tup.`2;
      _tup_0 <@ K.encaps(ek);
      ss <- _tup_0.`1;
      ct <- _tup_0.`2;
      return (ek, dk, ct, ss, ss);
    }
  }.

  module type KEMCorrectnessWithDK_Adv (O : KEMCorrectnessWithDK_Oracle) = {
    proc distinguish() : bool
  }.

  module type KeyGenEquiv_Oracle = {
    proc generate() : encapskey * decapskey
  }.

  module KeyGenEquiv_FromDeriveKeyPair (K : Scheme) : KeyGenEquiv_Oracle = {
    proc generate() : encapskey * decapskey = {
      var seed : bs_Nseed_t;
      var _r0 : encapskey * decapskey;
      seed <$ dbs_Nseed_t;
      _r0 <@ K.derivekeypair(seed);
      return _r0;
    }
  }.

  module KeyGenEquiv_FromKeyGen (K : Scheme) : KeyGenEquiv_Oracle = {
    proc generate() : encapskey * decapskey = {
      var _r0 : encapskey * decapskey;
      _r0 <@ K.keygen();
      return _r0;
    }
  }.

  module type KeyGenEquiv_Adv (O : KeyGenEquiv_Oracle) = {
    proc distinguish() : bool
  }.

  module Game_KEM_INDCCA_Real (Em : Scheme, A : KEM_INDCCA_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : encapskey * sharedsecret * ciphertext;
      pk <@ KEM_INDCCA_Real(Em).initialize();
      b <@ A(KEM_INDCCA_Real(Em)).distinguish(pk);
      return b;
    }
  }.

  module Game_KEM_INDCCA_Random (Em : Scheme, A : KEM_INDCCA_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : encapskey * sharedsecret * ciphertext;
      pk <@ KEM_INDCCA_Random(Em).initialize();
      b <@ A(KEM_INDCCA_Random(Em)).distinguish(pk);
      return b;
    }
  }.

  op eps_KEM_INDCCA : real.

  axiom eps_KEM_INDCCA_pos : 0%r <= eps_KEM_INDCCA.

  axiom KEM_INDCCA_advantage (Em <: Scheme) (A <: KEM_INDCCA_Adv) &m :
    `| Pr[Game_KEM_INDCCA_Real(Em, A).main() @ &m : res] - Pr[Game_KEM_INDCCA_Random(Em, A).main() @ &m : res] | <= eps_KEM_INDCCA.

  module Game_KEMCorrectnessWithDK_FromDecaps (Em : Scheme, A : KEMCorrectnessWithDK_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectnessWithDK_FromDecaps(Em)).distinguish();
      return b;
    }
  }.

  module Game_KEMCorrectnessWithDK_FromEncaps (Em : Scheme, A : KEMCorrectnessWithDK_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectnessWithDK_FromEncaps(Em)).distinguish();
      return b;
    }
  }.

  op eps_KEMCorrectnessWithDK : real.

  axiom eps_KEMCorrectnessWithDK_pos : 0%r <= eps_KEMCorrectnessWithDK.

  axiom KEMCorrectnessWithDK_advantage (Em <: Scheme) (A <: KEMCorrectnessWithDK_Adv) &m :
    `| Pr[Game_KEMCorrectnessWithDK_FromDecaps(Em, A).main() @ &m : res] - Pr[Game_KEMCorrectnessWithDK_FromEncaps(Em, A).main() @ &m : res] | <= eps_KEMCorrectnessWithDK.

  module Game_KeyGenEquiv_FromDeriveKeyPair (Em : Scheme, A : KeyGenEquiv_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KeyGenEquiv_FromDeriveKeyPair(Em)).distinguish();
      return b;
    }
  }.

  module Game_KeyGenEquiv_FromKeyGen (Em : Scheme, A : KeyGenEquiv_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KeyGenEquiv_FromKeyGen(Em)).distinguish();
      return b;
    }
  }.

  op eps_KeyGenEquiv : real.

  axiom eps_KeyGenEquiv_pos : 0%r <= eps_KeyGenEquiv.

  axiom KeyGenEquiv_advantage (Em <: Scheme) (A <: KeyGenEquiv_Adv) &m :
    `| Pr[Game_KeyGenEquiv_FromDeriveKeyPair(Em, A).main() @ &m : res] - Pr[Game_KeyGenEquiv_FromKeyGen(Em, A).main() @ &m : res] | <= eps_KeyGenEquiv.
end KEM_Theory.

(* ===== Foreign primitive theory: NominalGroup_Theory ===== *)

abstract theory NominalGroup_Theory.
  type element.

  type scalar.

  type bs_Nseed_t.

  op zero_Nseed_t : bs_Nseed_t.

  type bs_Nelem_t.

  op zero_Nelem_t : bs_Nelem_t.

  type bs_Nss_t.

  op zero_Nss_t : bs_Nss_t.

  module type Scheme = {
    proc exp(base : element, exp : scalar) : element
    proc generator() : element
    proc randomscalar(seed : bs_Nseed_t) : scalar
    proc encode(elem : element) : bs_Nelem_t
    proc elementtosharedsecret(elem : element) : bs_Nss_t
  }.

  op ev_exp : element -> scalar -> element.

  op ev_generator : element.

  op ev_randomscalar : bs_Nseed_t -> scalar.

  op ev_encode : element -> bs_Nelem_t.

  op ev_elementtosharedsecret : element -> bs_Nss_t.
end NominalGroup_Theory.

(* ===== Foreign primitive theory: PRG_Theory ===== *)

abstract theory PRG_Theory.
  type bs_lambda_t.

  op zero_lambda_t : bs_lambda_t.

  type bs_lambda_stretch_t.

  op zero_lambda_stretch_t : bs_lambda_stretch_t.

  op dbs_lambda_t : bs_lambda_t distr.

  axiom dbs_lambda_t_ll : is_lossless dbs_lambda_t.

  axiom dbs_lambda_t_fu : is_funiform dbs_lambda_t.

  axiom dbs_lambda_t_full : is_full dbs_lambda_t.

  op dbs_lambda_stretch_t : bs_lambda_stretch_t distr.

  axiom dbs_lambda_stretch_t_ll : is_lossless dbs_lambda_stretch_t.

  axiom dbs_lambda_stretch_t_fu : is_funiform dbs_lambda_stretch_t.

  axiom dbs_lambda_stretch_t_full : is_full dbs_lambda_stretch_t.

  module type Scheme = {
    proc evaluate(x : bs_lambda_t) : bs_lambda_stretch_t
  }.

  op ev_evaluate : bs_lambda_t -> bs_lambda_stretch_t.

  module type PRGSec_Oracle = {
    proc query() : bs_lambda_stretch_t
  }.

  module PRGSec_Real (G : Scheme) : PRGSec_Oracle = {
    proc query() : bs_lambda_stretch_t = {
      var s : bs_lambda_t;
      var _r0 : bs_lambda_stretch_t;
      s <$ dbs_lambda_t;
      _r0 <@ G.evaluate(s);
      return _r0;
    }
  }.

  module PRGSec_Random (G : Scheme) : PRGSec_Oracle = {
    proc query() : bs_lambda_stretch_t = {
      var r : bs_lambda_stretch_t;
      r <$ dbs_lambda_stretch_t;
      return r;
    }
  }.

  module type PRGSec_Adv (O : PRGSec_Oracle) = {
    proc distinguish() : bool
  }.

  module Game_PRGSec_Real (Em : Scheme, A : PRGSec_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(PRGSec_Real(Em)).distinguish();
      return b;
    }
  }.

  module Game_PRGSec_Random (Em : Scheme, A : PRGSec_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(PRGSec_Random(Em)).distinguish();
      return b;
    }
  }.

  op eps_PRGSec : real.

  axiom eps_PRGSec_pos : 0%r <= eps_PRGSec.

  axiom PRGSec_advantage (Em <: Scheme) (A <: PRGSec_Adv) &m :
    `| Pr[Game_PRGSec_Real(Em, A).main() @ &m : res] - Pr[Game_PRGSec_Random(Em, A).main() @ &m : res] | <= eps_PRGSec.
end PRG_Theory.

(* ===== Foreign primitive theory: KDF_Theory ===== *)

abstract theory KDF_Theory.
  type bs_Nin_t.

  op zero_Nin_t : bs_Nin_t.

  type bs_Nout_t.

  op zero_Nout_t : bs_Nout_t.

  type bs_Nin_Nkey_t.

  op zero_Nin_Nkey_t : bs_Nin_Nkey_t.

  type bs_Nkey_t.

  op zero_Nkey_t : bs_Nkey_t.

  op dbs_Nkey_t : bs_Nkey_t distr.

  axiom dbs_Nkey_t_ll : is_lossless dbs_Nkey_t.

  axiom dbs_Nkey_t_fu : is_funiform dbs_Nkey_t.

  axiom dbs_Nkey_t_full : is_full dbs_Nkey_t.

  op dfun_bs_Nin_Nkey_t_to_bs_Nout_t : (bs_Nin_Nkey_t -> bs_Nout_t) distr.

  axiom dfun_bs_Nin_Nkey_t_to_bs_Nout_t_ll : is_lossless dfun_bs_Nin_Nkey_t_to_bs_Nout_t.

  axiom dfun_bs_Nin_Nkey_t_to_bs_Nout_t_fu : is_funiform dfun_bs_Nin_Nkey_t_to_bs_Nout_t.

  axiom dfun_bs_Nin_Nkey_t_to_bs_Nout_t_full : is_full dfun_bs_Nin_Nkey_t_to_bs_Nout_t.

  op slice_bs_Nin_t_to_bs_Nkey_t : bs_Nin_t -> int -> int -> bs_Nkey_t.

  op slice_bs_Nin_t_to_bs_Nin_Nkey_t : bs_Nin_t -> int -> int -> bs_Nin_Nkey_t.

  op concat_bs_Nkey_t_bs_Nin_Nkey_t_to_bs_Nin_t : bs_Nkey_t -> bs_Nin_Nkey_t -> bs_Nin_t.

  module type Scheme = {
    proc evaluate(input : bs_Nin_t) : bs_Nout_t
  }.

  op ev_evaluate : bs_Nin_t -> bs_Nout_t.

  module type KDFPRFSec_Oracle = {
    proc initialize() : unit
    proc lookup(rest : bs_Nin_Nkey_t) : bs_Nout_t
  }.

  module KDFPRFSec_Real (H : Scheme) : KDFPRFSec_Oracle = {
    var k : bs_Nkey_t
    proc initialize() : unit = {
      k <$ dbs_Nkey_t;
    }
    proc lookup(rest : bs_Nin_Nkey_t) : bs_Nout_t = {
      var _r0 : bs_Nout_t;
      _r0 <@ H.evaluate(concat_bs_Nkey_t_bs_Nin_Nkey_t_to_bs_Nin_t k rest);
      return _r0;
    }
  }.

  module KDFPRFSec_Random (H : Scheme) : KDFPRFSec_Oracle = {
    var rF : bs_Nin_Nkey_t -> bs_Nout_t
    proc initialize() : unit = {
      rF <$ dfun_bs_Nin_Nkey_t_to_bs_Nout_t;
    }
    proc lookup(rest : bs_Nin_Nkey_t) : bs_Nout_t = {
      return rF rest;
    }
  }.

  module type KDFPRFSec_Adv (O : KDFPRFSec_Oracle) = {
    proc distinguish() : bool {O.lookup}
  }.

  module Game_KDFPRFSec_Real (Em : Scheme, A : KDFPRFSec_Adv) = {
    proc main() : bool = {
      var b : bool;
      KDFPRFSec_Real(Em).initialize();
      b <@ A(KDFPRFSec_Real(Em)).distinguish();
      return b;
    }
  }.

  module Game_KDFPRFSec_Random (Em : Scheme, A : KDFPRFSec_Adv) = {
    proc main() : bool = {
      var b : bool;
      KDFPRFSec_Random(Em).initialize();
      b <@ A(KDFPRFSec_Random(Em)).distinguish();
      return b;
    }
  }.

  op eps_KDFPRFSec : real.

  axiom eps_KDFPRFSec_pos : 0%r <= eps_KDFPRFSec.

  axiom KDFPRFSec_advantage (Em <: Scheme) (A <: KDFPRFSec_Adv) &m :
    `| Pr[Game_KDFPRFSec_Real(Em, A).main() @ &m : res] - Pr[Game_KDFPRFSec_Random(Em, A).main() @ &m : res] | <= eps_KDFPRFSec.
end KDF_Theory.

(* ===== Foreign primitive theory: Label_Theory ===== *)

abstract theory Label_Theory.
  type bs_Nlabel_t.

  op zero_Nlabel_t : bs_Nlabel_t.

  module type Scheme = {
    proc get() : bs_Nlabel_t
  }.

  op ev_get : bs_Nlabel_t.
end Label_Theory.

(* ===== Theory instantiation ===== *)

clone KEM_Theory as KEM_PQ_c with
  type sharedsecret <- bs_kem_pq_nss,
  type ciphertext <- KEMPQCiphertextSpace,
  type encapskey <- KEMPQEncapsKeySpace,
  type decapskey <- KEMPQDecapsKeySpace,
  type bs_Nseed_t <- bs_kem_pq_nseed,
  type bs_Nss_t <- bs_kem_pq_nss,
  type bs_Nct_t <- bs_kem_pq_nct,
  type bs_Nek_t <- bs_kem_pq_nek,
  op dsharedsecret <- dbs_kem_pq_nss,
  op dbs_Nseed_t <- dbs_kem_pq_nseed.

clone NominalGroup_Theory as NG_c with
  type element <- NGElementSpace,
  type scalar <- NGScalarSpace,
  type bs_Nseed_t <- bs_ng_nseed,
  type bs_Nelem_t <- bs_ng_nelem,
  type bs_Nss_t <- bs_ng_nss.

clone PRG_Theory as G_c with
  type bs_lambda_t <- bs_kem_pq_nseed,
  type bs_lambda_stretch_t <- bs_kem_pq_nseed_ng_nseed,
  op dbs_lambda_t <- dbs_kem_pq_nseed,
  op dbs_lambda_stretch_t <- dbs_kem_pq_nseed_ng_nseed.

clone KDF_Theory as H_c with
  type bs_Nin_t <- bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel,
  type bs_Nout_t <- bs_kdf_nout,
  type bs_Nin_Nkey_t <- bs_2_ng_nelem_ng_nss_nlabel,
  type bs_Nkey_t <- bs_kem_pq_nss,
  op dbs_Nkey_t <- dbs_kem_pq_nss,
  op dfun_bs_Nin_Nkey_t_to_bs_Nout_t <- dfun_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kdf_nout,
  op concat_bs_Nkey_t_bs_Nin_Nkey_t_to_bs_Nin_t <- concat_bs_kem_pq_nss_bs_2_ng_nelem_ng_nss_nlabel_to_bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel.

clone Label_Theory as L_c with
  type bs_Nlabel_t <- bs_nlabel.

clone KEM_Theory as Hybrid_c with
  type sharedsecret <- bs_kdf_nout,
  type ciphertext <- KEMPQCiphertextSpace * NGElementSpace,
  type encapskey <- KEMPQEncapsKeySpace * NGElementSpace,
  type decapskey <- bs_kem_pq_nseed,
  type bs_Nseed_t <- bs_kem_pq_nseed,
  type bs_Nss_t <- bs_kdf_nout,
  type bs_Nct_t <- bs_kem_pq_nct_ng_nelem,
  type bs_Nek_t <- bs_kem_pq_nek_ng_nelem,
  op dsharedsecret <- dbs_kdf_nout,
  op dbs_Nseed_t <- dbs_kem_pq_nseed.

