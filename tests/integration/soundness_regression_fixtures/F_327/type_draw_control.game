// Positive control for F-327: the same reordering with the draw from the type
// BitString<1>, which is never empty. The draw always completes and is
// independent of `guard`, so drawing r before or after the early return makes
// no difference, and the games are interchangeable.

Game Real() {
    Bool guard = false;

    Void SetGuard() {
        guard = true;
    }

    BitString<1> Draw() {
        BitString<1> r <- BitString<1>;
        if (guard) {
            return 0b0;
        }
        return r;
    }
}

Game Ideal() {
    Bool guard = false;

    Void SetGuard() {
        guard = true;
    }

    BitString<1> Draw() {
        if (guard) {
            return 0b0;
        }
        BitString<1> r <- BitString<1>;
        return r;
    }
}

export as TypeDrawControl;
