(* NOTE: the FrogLang scheme has `requires` clauses that are not enforced by the EC export. The scheme module below may fail EC type-checking because cross-clone type equalities implied by the `requires` are not expressed in the clones. Deferred to Phase 5D. *)

(* ===== Concrete scheme implementation ===== *)

module TriplingPRG (G : G_c.Scheme) : T_c.Scheme = {
  proc evaluate(s : bs_lambda) : bs_3_lambda = {
    var result1 : bs_2_lambda;
    var x : bs_lambda;
    var y : bs_lambda;
    var result2 : bs_2_lambda;
    result1 <@ G.evaluate(s);
    x <- slice_bs_2_lambda_to_bs_lambda result1 0 lambda;
    y <- slice_bs_2_lambda_to_bs_lambda result1 lambda (2*lambda);
    result2 <@ G.evaluate(y);
    return concat_bs_lambda_bs_2_lambda_to_bs_3_lambda x result2;
  }
}.

section Main.
  declare module G <: G_c.Scheme.

  (* ===== Deterministic-method specs ===== *)

  declare axiom G_evaluate_det (g : (glob G)) (a0 : bs_lambda) : phoare[ G.evaluate : (glob G) = g /\ x = a0 ==> (glob G) = g /\ res = G_c.ev_evaluate a0 ] = 1%r.

  (* ===== Reductions ===== *)

  module R1 (G : G_c.Scheme, T : T_c.Scheme, Challenger : G_c.PRGSecurity_Oracle) = {
    proc query() : bs_3_lambda = {
      var result1 : bs_2_lambda;
      var x : bs_lambda;
      var y : bs_lambda;
      var result2 : bs_2_lambda;
      result1 <@ Challenger.query();
      x <- slice_bs_2_lambda_to_bs_lambda result1 0 lambda;
      y <- slice_bs_2_lambda_to_bs_lambda result1 lambda (2*lambda);
      result2 <@ G.evaluate(y);
      return concat_bs_lambda_bs_2_lambda_to_bs_3_lambda x result2;
    }
  }.

  module R3 (G : G_c.Scheme, T : T_c.Scheme, Challenger : G_c.PRGSecurity_Oracle) = {
    proc query() : bs_3_lambda = {
      var x : bs_lambda;
      var result2 : bs_2_lambda;
      x <$ dbs_lambda;
      result2 <@ Challenger.query();
      return concat_bs_lambda_bs_2_lambda_to_bs_3_lambda x result2;
    }
  }.

  (* ===== Reductions lifted to assumption-adversaries ===== *)

  module R1_Adv (G : G_c.Scheme, A : T_c.PRGSecurity_Adv, C : G_c.PRGSecurity_Oracle) = {
    proc distinguish() : bool = {
      var b : bool;
      b <@ A(R1(G, TriplingPRG(G), C)).distinguish();
      return b;
    }
  }.

  module R3_Adv (G : G_c.Scheme, A : T_c.PRGSecurity_Adv, C : G_c.PRGSecurity_Oracle) = {
    proc distinguish() : bool = {
      var b : bool;
      b <@ A(R3(G, TriplingPRG(G), C)).distinguish();
      return b;
    }
  }.

  (* ===== Game-step wrappers ===== *)

  (* Game_step_0: PRGSecurity.Real *)

  module Game_step_0 (G : G_c.Scheme, A : T_c.PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(T_c.PRGSecurity_Real(TriplingPRG(G))).distinguish();
      return b;
    }
  }.

  (* Game_step_1: PRGSecurity.Real composed with reduction R1 *)

  module Game_step_1 (G : G_c.Scheme, A : T_c.PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R1(G, TriplingPRG(G), G_c.PRGSecurity_Real(G))).distinguish();
      return b;
    }
  }.

  (* Game_step_2: PRGSecurity.Random composed with reduction R1 *)

  module Game_step_2 (G : G_c.Scheme, A : T_c.PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R1(G, TriplingPRG(G), G_c.PRGSecurity_Random(G))).distinguish();
      return b;
    }
  }.

  (* Game_step_3: PRGSecurity.Real composed with reduction R3 *)

  module Game_step_3 (G : G_c.Scheme, A : T_c.PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R3(G, TriplingPRG(G), G_c.PRGSecurity_Real(G))).distinguish();
      return b;
    }
  }.

  (* Game_step_4: PRGSecurity.Random composed with reduction R3 *)

  module Game_step_4 (G : G_c.Scheme, A : T_c.PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R3(G, TriplingPRG(G), G_c.PRGSecurity_Random(G))).distinguish();
      return b;
    }
  }.

  (* Game_step_5: PRGSecurity.Random *)

  module Game_step_5 (G : G_c.Scheme, A : T_c.PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(T_c.PRGSecurity_Random(TriplingPRG(G))).distinguish();
      return b;
    }
  }.

  (* ===== Per-transform canonicalization chain ===== *)

  module Step_0L_state_0 (G : G_c.Scheme) = {
    proc query() : bs_3_lambda = {
      var s : bs_lambda;
      var v_T_evaluate_result11 : bs_2_lambda;
      var v_T_evaluate_x1 : bs_lambda;
      var v_T_evaluate_y1 : bs_lambda;
      var v_T_evaluate_result21 : bs_2_lambda;
      s <$ dbs_lambda;
      v_T_evaluate_result11 <@ G.evaluate(s);
      v_T_evaluate_x1 <- slice_bs_2_lambda_to_bs_lambda v_T_evaluate_result11 0 lambda;
