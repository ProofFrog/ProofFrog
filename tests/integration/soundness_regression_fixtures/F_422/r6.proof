// Attack r6: as r5, with the optional member reached through a forwarding
// scheme (W.Elem = Q.Elem = BitString<8>?). UNSOUND if "Proof Succeeded".
import 'Conv2.primitive';
import 'Src.primitive';
import 'Holder.primitive';
import 'OptHolder.scheme';
import 'Wrap.scheme';
import 'ReqH.scheme';
import 'r3.game';
proof:
let:
    Set K;
    Src P = Src(K);
    OptHolder Q = OptHolder();
    Wrap W = Wrap(Q);
    ReqH C = ReqH(P, W);
theorem:
    R3(C);
games:
    R3(C).Left against R3(C).Adversary;
    R3(C).Right against R3(C).Adversary;
