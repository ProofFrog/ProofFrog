       (fun (p : bs_kem_pq_nss_kem_t_nct_kem_t_nss * bs_kem_t_nek) => concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss p.`1 p.`2).
