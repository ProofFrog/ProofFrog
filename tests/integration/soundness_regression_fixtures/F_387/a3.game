import 'Leaker.primitive';

Game Real(Int m, Leaker L, Function<BitString<1>, BitString<m>> H) {
    [BitString<m>, BitString<m>] Peek() {
        return L.Leak();
    }
    BitString<m> Fresh() {
        BitString<1> v <-uniq[H.domain] BitString<1>;
        return H(v);
    }
}

Game Random(Int m, Leaker L, Function<BitString<1>, BitString<m>> H) {
    [BitString<m>, BitString<m>] Peek() {
        return L.Leak();
    }
    BitString<m> Fresh() {
        BitString<1> v <-uniq[H.domain] BitString<1>;
        BitString<m> u <- BitString<m>;
        return u;
    }
}

export as A3;
