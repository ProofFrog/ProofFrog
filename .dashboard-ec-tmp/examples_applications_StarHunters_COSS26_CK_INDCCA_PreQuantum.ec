  module G_StoredSS2 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : C_c.KEM_INDCCA_MultiChal_Oracle = {
    var ss2Star : SS2Space
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var pk : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var _tup_1 : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var _tup_2 : SS2Space * CT2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ KEM1.encaps(pk);
      ss1 <- _tup_1.`1;
      ct1Star <- _tup_1.`2;
      _tup_2 <@ KEM2.encaps(pk2);
      ss2Star <- _tup_2.`1;
      ct2Star <- _tup_2.`2;
      bct2 <- ct2Star;
      bpk2 <- pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ F.evaluate(ss1, ss2Star, label);
      return ((pk, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct2 = ct2Star) {
          _r1 <@ F.evaluate(ss1, ss2Star, label);
          _r0 <- Some (_r1);
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

