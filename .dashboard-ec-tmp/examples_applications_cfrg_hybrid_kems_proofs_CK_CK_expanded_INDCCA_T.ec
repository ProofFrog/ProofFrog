      pk0 <@ R_Correct_T_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), C).initialize();
      b <@ A(R_Correct_T_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), C)).distinguish(pk0);
      return b;
    }
  }.

