(* ===== Per-clone distribution axioms ===== *)

lemma KEM1_dSS1Space_funi :
  is_funiform dSS1Space.
proof.
  exact dSS1Space_fu.
qed.

lemma KEM1_dSS1Space_ll :
  is_lossless dSS1Space.
proof.
  exact dSS1Space_ll.
qed.

lemma KEM2_dSS2Space_funi :
  is_funiform dSS2Space.
proof.
  exact dSS2Space_fu.
qed.

lemma KEM2_dSS2Space_ll :
  is_lossless dSS2Space.
proof.
  exact dSS2Space_ll.
qed.

