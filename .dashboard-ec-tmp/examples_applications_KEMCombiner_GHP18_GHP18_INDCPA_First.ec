(* ===== Abstract theory: primitive + security games + assumption ===== *)

abstract theory KEM_Theory.
  type publickey.

  type secretkey.

  type sharedsecret.

  type ciphertext.

  op dsharedsecret : sharedsecret distr.

  axiom dsharedsecret_ll : is_lossless dsharedsecret.

  axiom dsharedsecret_fu : is_funiform dsharedsecret.

  axiom dsharedsecret_full : is_full dsharedsecret.

  module type Scheme = {
    proc keygen() : publickey * secretkey
    proc encaps(pk : publickey) : sharedsecret * ciphertext
    proc decaps(sk : secretkey, m : ciphertext) : sharedsecret
  }.

  op ev_decaps : secretkey -> ciphertext -> sharedsecret.

  module type KEM_INDCPA_MultiChal_Oracle = {
    proc initialize() : publickey
    proc challenge() : sharedsecret * ciphertext
  }.

  module KEM_INDCPA_MultiChal_Real (K : Scheme) : KEM_INDCPA_MultiChal_Oracle = {
    var pk : publickey
    var sk : secretkey
    proc initialize() : publickey = {
      var _tup : publickey * secretkey;
      _tup <@ K.keygen();
      pk <- _tup.`1;
      sk <- _tup.`2;
      return pk;
    }
    proc challenge() : sharedsecret * ciphertext = {
      var _tup : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ctxt : ciphertext;
      _tup <@ K.encaps(pk);
      ss <- _tup.`1;
      ctxt <- _tup.`2;
      return (ss, ctxt);
    }
  }.

  module KEM_INDCPA_MultiChal_Random (K : Scheme) : KEM_INDCPA_MultiChal_Oracle = {
    var pk : publickey
    var sk : secretkey
    proc initialize() : publickey = {
      var _tup : publickey * secretkey;
      _tup <@ K.keygen();
      pk <- _tup.`1;
      sk <- _tup.`2;
      return pk;
    }
    proc challenge() : sharedsecret * ciphertext = {
      var rsp : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ctxt : ciphertext;
      rsp <@ K.encaps(pk);
      ss <$ dsharedsecret;
      ctxt <- rsp.`2;
      return (ss, ctxt);
    }
  }.

  module type KEM_INDCPA_MultiChal_Adv (O : KEM_INDCPA_MultiChal_Oracle) = {
    proc distinguish(pk : publickey) : bool {O.challenge}
  }.

  module Game_KEM_INDCPA_MultiChal_Real (Em : Scheme, A : KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : publickey;
      pk <@ KEM_INDCPA_MultiChal_Real(Em).initialize();
      b <@ A(KEM_INDCPA_MultiChal_Real(Em)).distinguish(pk);
      return b;
    }
  }.

  module Game_KEM_INDCPA_MultiChal_Random (Em : Scheme, A : KEM_INDCPA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : publickey;
      pk <@ KEM_INDCPA_MultiChal_Random(Em).initialize();
      b <@ A(KEM_INDCPA_MultiChal_Random(Em)).distinguish(pk);
      return b;
    }
  }.

  op eps_KEM_INDCPA_MultiChal : real.

  axiom eps_KEM_INDCPA_MultiChal_pos : 0%r <= eps_KEM_INDCPA_MultiChal.

  axiom KEM_INDCPA_MultiChal_advantage (Em <: Scheme) (A <: KEM_INDCPA_MultiChal_Adv) &m :
    `| Pr[Game_KEM_INDCPA_MultiChal_Real(Em, A).main() @ &m : res] - Pr[Game_KEM_INDCPA_MultiChal_Random(Em, A).main() @ &m : res] | <= eps_KEM_INDCPA_MultiChal.
end KEM_Theory.

(* ===== Foreign primitive theory: TwoKeyPRF_Theory ===== *)

abstract theory TwoKeyPRF_Theory.
  type bs_lambda1_t.

  op zero_lambda1_t : bs_lambda1_t.

  type bs_lambda2_t.

  op zero_lambda2_t : bs_lambda2_t.

  type bs_in_t.

  op zero_in_t : bs_in_t.

  type bs_out_t.

  op zero_out_t : bs_out_t.

  op dbs_lambda1_t : bs_lambda1_t distr.

  axiom dbs_lambda1_t_ll : is_lossless dbs_lambda1_t.

  axiom dbs_lambda1_t_fu : is_funiform dbs_lambda1_t.

  axiom dbs_lambda1_t_full : is_full dbs_lambda1_t.

  op dbs_out_t : bs_out_t distr.

  axiom dbs_out_t_ll : is_lossless dbs_out_t.

  axiom dbs_out_t_fu : is_funiform dbs_out_t.

  axiom dbs_out_t_full : is_full dbs_out_t.

  module type Scheme = {
    proc evaluate(key1 : bs_lambda1_t, key2 : bs_lambda2_t, input : bs_in_t) : bs_out_t
  }.

  op ev_evaluate : bs_lambda1_t -> bs_lambda2_t -> bs_in_t -> bs_out_t.

  module type TwoKeyPRFFirstKeyMultiKey_Oracle = {
    proc lookup(key2 : bs_lambda2_t, x : bs_in_t) : bs_out_t
  }.

  module TwoKeyPRFFirstKeyMultiKey_Real (F : Scheme) : TwoKeyPRFFirstKeyMultiKey_Oracle = {
    proc lookup(key2 : bs_lambda2_t, x : bs_in_t) : bs_out_t = {
      var k : bs_lambda1_t;
      var _r0 : bs_out_t;
      k <$ dbs_lambda1_t;
      _r0 <@ F.evaluate(k, key2, x);
      return _r0;
    }
  }.

  module TwoKeyPRFFirstKeyMultiKey_Random (F : Scheme) : TwoKeyPRFFirstKeyMultiKey_Oracle = {
    proc lookup(key2 : bs_lambda2_t, x : bs_in_t) : bs_out_t = {
      var r : bs_out_t;
      r <$ dbs_out_t;
      return r;
    }
  }.

  module type TwoKeyPRFFirstKeyMultiKey_Adv (O : TwoKeyPRFFirstKeyMultiKey_Oracle) = {
    proc distinguish() : bool
  }.

  module Game_TwoKeyPRFFirstKeyMultiKey_Real (Em : Scheme, A : TwoKeyPRFFirstKeyMultiKey_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(TwoKeyPRFFirstKeyMultiKey_Real(Em)).distinguish();
      return b;
    }
  }.

  module Game_TwoKeyPRFFirstKeyMultiKey_Random (Em : Scheme, A : TwoKeyPRFFirstKeyMultiKey_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(TwoKeyPRFFirstKeyMultiKey_Random(Em)).distinguish();
      return b;
    }
  }.

  op eps_TwoKeyPRFFirstKeyMultiKey : real.

  axiom eps_TwoKeyPRFFirstKeyMultiKey_pos : 0%r <= eps_TwoKeyPRFFirstKeyMultiKey.

  axiom TwoKeyPRFFirstKeyMultiKey_advantage (Em <: Scheme) (A <: TwoKeyPRFFirstKeyMultiKey_Adv) &m :
    `| Pr[Game_TwoKeyPRFFirstKeyMultiKey_Real(Em, A).main() @ &m : res] - Pr[Game_TwoKeyPRFFirstKeyMultiKey_Random(Em, A).main() @ &m : res] | <= eps_TwoKeyPRFFirstKeyMultiKey.
end TwoKeyPRF_Theory.

