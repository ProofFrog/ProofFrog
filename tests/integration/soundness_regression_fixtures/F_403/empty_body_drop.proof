// Proof Failed!
import 'Picker.primitive';
import 'PickImpl.scheme';
import 'Taker.primitive';
import 'TakeNothing.scheme';
import 'ED.game';

proof:

let:
    PickImpl P = PickImpl();
    TakeNothing T = TakeNothing();

assume:

theorem:
    ED(P, T);

games:
    ED(P, T).Left against ED(P, T).Adversary;
    ED(P, T).Right against ED(P, T).Adversary;
