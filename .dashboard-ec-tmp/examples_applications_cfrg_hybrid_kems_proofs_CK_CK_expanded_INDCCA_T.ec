  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -KEM_T, -G, -H, -L, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_0(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] = Pr[Game_step_1(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Real.dk.`1{1} = R_Correct_T_Real.pq_keys.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`2{1} = R_Correct_T_Real.corr.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`3{1} = R_Correct_T_Real.corr.`1{2} /\ Hybrid_c.KEM_INDCCA_Real.ctStar{1} = R_Correct_T_Real.ctStar{2} /\ R_Correct_T_Real.corr{2}.`5 = KEM_T_c.ev_decaps (R_Correct_T_Real.corr{2}.`2) (R_Correct_T_Real.corr{2}.`3)).
    + conseq hop_0_decaps.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEMCorrectnessWithDK_advantage axiom applied to R_Correct_T_Real_Adv. *)

  lemma hop_1_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -KEM_T, -G, -H, -L, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    `| Pr[Game_step_1(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] - Pr[Game_step_2(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] | <= KEM_T_c.eps_KEMCorrectnessWithDK.
  proof.
    have hL : Pr[Game_step_1(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res]
            = Pr[KEM_T_c.Game_KEMCorrectnessWithDK_FromDecaps(KEM_T, R_Correct_T_Real_Adv(KEM_PQ, KEM_T, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res]
            = Pr[KEM_T_c.Game_KEMCorrectnessWithDK_FromEncaps(KEM_T, R_Correct_T_Real_Adv(KEM_PQ, KEM_T, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM_T_c.KEMCorrectnessWithDK_advantage KEM_T (R_Correct_T_Real_Adv(KEM_PQ, KEM_T, G, H, L, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -KEM_T, -G, -H, -L, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}) &m :
    Pr[Game_step_2(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res] = Pr[Game_step_3(KEM_PQ, KEM_T, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob KEM_T, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ G_StoredSS_T.pq_keys{2} = R_Correct_T_Real.pq_keys{1} /\ G_StoredSS_T.t_keys.`1{2} = R_Correct_T_Real.corr.`1{1} /\ G_StoredSS_T.t_keys.`2{2} = R_Correct_T_Real.corr.`2{1} /\ G_StoredSS_T.kem_ct_T{2} = R_Correct_T_Real.corr.`3{1} /\ G_StoredSS_T.ss_T_star{2} = R_Correct_T_Real.corr.`4{1} /\ G_StoredSS_T.ctStar{2} = R_Correct_T_Real.ctStar{1} /\ R_Correct_T_Real.corr{1}.`5 = R_Correct_T_Real.corr{1}.`4).
    + conseq hop_2_decaps.
    call hop_2_initialize.
    auto.
