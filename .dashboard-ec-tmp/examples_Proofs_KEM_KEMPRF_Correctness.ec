    (* resolution: synth-param *)
    transitivity Step_2R_state_1_fdet(K, F).compute (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}) (={pk, sk, glob K, glob F} ==> ={res, glob K, glob F}).
    smt().
    smt().
    proc.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__}).
    call (_: true); auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__, __a2__}).
    auto.
    seq 1 1 : (={pk, sk, glob K, glob F, __a0__, __a1__, __a2__, __a3__}).
