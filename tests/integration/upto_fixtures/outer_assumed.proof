// TargetGuess via an assumed event whose bound is the clause on the pair.
import 'TargetGuess.game';
import 'BadGuessClause.game';

proof:

let:
    Set S;

assume:
    event bad of BadGuessClause(S);

theorem:
    TargetGuess(S);

games:
    TargetGuess(S).Left against TargetGuess(S).Adversary;
    BadGuessClause(S).Left compose R(S) against TargetGuess(S).Adversary;
    BadGuessClause(S).Right compose R(S) against TargetGuess(S).Adversary;
    TargetGuess(S).Right against TargetGuess(S).Adversary;

// R: forwards every guess to the pair.
Reduction R(Set S) compose BadGuessClause(S) against TargetGuess(S).Adversary {
    Void Initialize() {
        challenger.Initialize();
    }

    Bool Eq(S c) {
        return challenger.Eq(c);
    }
}
