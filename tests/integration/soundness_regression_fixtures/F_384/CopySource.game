// F-384 (snapshot): a copies n's starting value, 7 on the left and 9 on
// the right; SetN changes n afterwards, which no Get reads. Get returns 7
// on the left and 9 on the right. a stays a field holding n's starting
// value, but no method reads n, so a pass that decides from the method
// bodies alone that n is unused must not drop it and leave a's initializer
// naming nothing: both sides would then canonicalize to the same game.
Game Left() {
    Int n = 7;
    Int a = n;

    Void SetN(Int x) {
        n = x;
    }

    Int Get() {
        return a;
    }
}

Game Right() {
    Int n = 9;
    Int a = n;

    Void SetN(Int x) {
        n = x;
    }

    Int Get() {
        return a;
    }
}

export as CopySource;
