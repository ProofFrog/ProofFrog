  declare module G <: G_c.Scheme {-KEM_PQ, -KEM_T, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}.

  declare module H <: H_c.Scheme {-KEM_PQ, -KEM_T, -G, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}.

  declare module L <: L_c.Scheme {-KEM_PQ, -KEM_T, -G, -H, -G_Abort, -G_AllRand, -G_Consolidated, -G_RandSS_T, -G_StoredSS_T, -G_StoredSS_T_R, -G_Unwound, -H_c.KDFSecondKeyPRF_Random, -H_c.KDFSecondKeyPRF_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_C2PRI_Ideal, -KEM_PQ_c.KEM_C2PRI_Real, -KEM_T_c.KEM_INDCCA_Random, -KEM_T_c.KEM_INDCCA_Real, -R_C2PRI_L, -R_C2PRI_R, -R_Correct_T_Ideal, -R_Correct_T_Real, -R_KEM_T_L, -R_KEM_T_R, -R_PRF_Fwd, -R_PRF_Rev}.

  (* ===== Deterministic-method specs ===== *)

  declare axiom KEM_PQ_derivekeypair_det (g : (glob KEM_PQ)) (a0 : bs_kem_pq_nseed) : phoare[ KEM_PQ.derivekeypair : (glob KEM_PQ) = g /\ seed = a0 ==> (glob KEM_PQ) = g /\ res = KEM_PQ_c.ev_derivekeypair a0 ] = 1%r.

  declare axiom KEM_PQ_decaps_det (g : (glob KEM_PQ)) (a0 : KEMPQDecapsKeySpace) (a1 : KEMPQCiphertextSpace) : phoare[ KEM_PQ.decaps : (glob KEM_PQ) = g /\ dk = a0 /\ ct = a1 ==> (glob KEM_PQ) = g /\ res = KEM_PQ_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom KEM_PQ_encodesharedsecret_det (g : (glob KEM_PQ)) (a0 : KEMPQSharedSecretSpace) : phoare[ KEM_PQ.encodesharedsecret : (glob KEM_PQ) = g /\ ss = a0 ==> (glob KEM_PQ) = g /\ res = KEM_PQ_c.ev_encodesharedsecret a0 ] = 1%r.

  declare axiom KEM_PQ_encodeciphertext_det (g : (glob KEM_PQ)) (a0 : KEMPQCiphertextSpace) : phoare[ KEM_PQ.encodeciphertext : (glob KEM_PQ) = g /\ ct = a0 ==> (glob KEM_PQ) = g /\ res = KEM_PQ_c.ev_encodeciphertext a0 ] = 1%r.

  declare axiom KEM_PQ_encodeencapskey_det (g : (glob KEM_PQ)) (a0 : KEMPQEncapsKeySpace) : phoare[ KEM_PQ.encodeencapskey : (glob KEM_PQ) = g /\ ek = a0 ==> (glob KEM_PQ) = g /\ res = KEM_PQ_c.ev_encodeencapskey a0 ] = 1%r.

  declare axiom KEM_T_derivekeypair_det (g : (glob KEM_T)) (a0 : bs_kem_t_nseed) : phoare[ KEM_T.derivekeypair : (glob KEM_T) = g /\ seed = a0 ==> (glob KEM_T) = g /\ res = KEM_T_c.ev_derivekeypair a0 ] = 1%r.

  declare axiom KEM_T_decaps_det (g : (glob KEM_T)) (a0 : KEMTDecapsKeySpace) (a1 : KEMTCiphertextSpace) : phoare[ KEM_T.decaps : (glob KEM_T) = g /\ dk = a0 /\ ct = a1 ==> (glob KEM_T) = g /\ res = KEM_T_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom KEM_T_encodesharedsecret_det (g : (glob KEM_T)) (a0 : bs_kem_t_nss) : phoare[ KEM_T.encodesharedsecret : (glob KEM_T) = g /\ ss = a0 ==> (glob KEM_T) = g /\ res = KEM_T_c.ev_encodesharedsecret a0 ] = 1%r.

  declare axiom KEM_T_encodeciphertext_det (g : (glob KEM_T)) (a0 : KEMTCiphertextSpace) : phoare[ KEM_T.encodeciphertext : (glob KEM_T) = g /\ ct = a0 ==> (glob KEM_T) = g /\ res = KEM_T_c.ev_encodeciphertext a0 ] = 1%r.

  declare axiom KEM_T_encodeencapskey_det (g : (glob KEM_T)) (a0 : KEMTEncapsKeySpace) : phoare[ KEM_T.encodeencapskey : (glob KEM_T) = g /\ ek = a0 ==> (glob KEM_T) = g /\ res = KEM_T_c.ev_encodeencapskey a0 ] = 1%r.

  declare axiom G_evaluate_det (g : (glob G)) (a0 : bs_kem_pq_nseed) : phoare[ G.evaluate : (glob G) = g /\ x = a0 ==> (glob G) = g /\ res = G_c.ev_evaluate a0 ] = 1%r.

  declare axiom H_evaluate_det (g : (glob H)) (a0 : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel) : phoare[ H.evaluate : (glob H) = g /\ input = a0 ==> (glob H) = g /\ res = H_c.ev_evaluate a0 ] = 1%r.

  declare axiom L_get_det (g : (glob L)) : phoare[ L.get : (glob L) = g ==> (glob L) = g /\ res = L_c.ev_get ] = 1%r.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0_initialize :
    equiv [ Hybrid_c.KEM_INDCCA_Real(CK_expanded(KEM_PQ, KEM_T, G, H, L)).initialize ~ R_Correct_T_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), KEM_T_c.KEMCorrectnessWithDK_FromDecaps(KEM_T)).initialize :
            ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Real.dk.`1{1} = R_Correct_T_Real.pq_keys.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`2{1} = R_Correct_T_Real.corr.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`3{1} = R_Correct_T_Real.corr.`1{2} /\ Hybrid_c.KEM_INDCCA_Real.ctStar{1} = R_Correct_T_Real.ctStar{2} /\ R_Correct_T_Real.corr{2}.`5 = KEM_T_c.ev_decaps (R_Correct_T_Real.corr{2}.`2) (R_Correct_T_Real.corr{2}.`3) ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 0, oracle 'initialize': init equiv
       with a dead F.evaluate on one side (PRF-random hop). The shared
       backbone is keygen; encaps; <fresh sample>, but one wrapper still
       runs an F.evaluate whose result the sample overwrites. Drop it with a
       one-sided phoare, then peel the common backbone:
         proc. inline *.
         (* drop the dead F.evaluate on the side that has it: *)
         seq <k> <k+1> : (={glob K, glob F} /\ <live coupling>).
         + exists* (glob F){i}, <Fseedi>, <Finputi>; elim* => gf a0 a1;
           call{i} (F_evaluate_det gf a0 a1); auto.
         wp; rnd; wp; call (_: true); wp; call (_: true); skip => /#. *)
    admit.
    qed.

  lemma hop_0_decaps :
    equiv [ Hybrid_c.KEM_INDCCA_Real(CK_expanded(KEM_PQ, KEM_T, G, H, L)).decaps ~ R_Correct_T_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), KEM_T_c.KEMCorrectnessWithDK_FromDecaps(KEM_T)).decaps :
            ={ct} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Real.dk.`1{1} = R_Correct_T_Real.pq_keys.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`2{1} = R_Correct_T_Real.corr.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`3{1} = R_Correct_T_Real.corr.`1{2} /\ Hybrid_c.KEM_INDCCA_Real.ctStar{1} = R_Correct_T_Real.ctStar{2} /\ R_Correct_T_Real.corr{2}.`5 = KEM_T_c.ev_decaps (R_Correct_T_Real.corr{2}.`2) (R_Correct_T_Real.corr{2}.`3) ==> ={res} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Real.dk.`1{1} = R_Correct_T_Real.pq_keys.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`2{1} = R_Correct_T_Real.corr.`2{2} /\ Hybrid_c.KEM_INDCCA_Real.dk.`3{1} = R_Correct_T_Real.corr.`1{2} /\ Hybrid_c.KEM_INDCCA_Real.ctStar{1} = R_Correct_T_Real.ctStar{2} /\ R_Correct_T_Real.corr{2}.`5 = KEM_T_c.ev_decaps (R_Correct_T_Real.corr{2}.`2) (R_Correct_T_Real.corr{2}.`3) ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 0, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_2_initialize :
    equiv [ R_Correct_T_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), KEM_T_c.KEMCorrectnessWithDK_FromEncaps(KEM_T)).initialize ~ G_StoredSS_T(KEM_PQ, KEM_T, G, H, L).initialize :
            ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ G_StoredSS_T.pq_keys{2} = R_Correct_T_Real.pq_keys{1} /\ G_StoredSS_T.t_keys.`1{2} = R_Correct_T_Real.corr.`1{1} /\ G_StoredSS_T.t_keys.`2{2} = R_Correct_T_Real.corr.`2{1} /\ G_StoredSS_T.kem_ct_T{2} = R_Correct_T_Real.corr.`3{1} /\ G_StoredSS_T.ss_T_star{2} = R_Correct_T_Real.corr.`4{1} /\ G_StoredSS_T.ctStar{2} = R_Correct_T_Real.ctStar{1} /\ R_Correct_T_Real.corr{1}.`5 = R_Correct_T_Real.corr{1}.`4 ].
  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    swap{1} [8..8] -7.
    swap{1} [12..15] -9.
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

  lemma hop_2_decaps :
    equiv [ R_Correct_T_Real(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), KEM_T_c.KEMCorrectnessWithDK_FromEncaps(KEM_T)).decaps ~ G_StoredSS_T(KEM_PQ, KEM_T, G, H, L).decaps :
            ={ct} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ G_StoredSS_T.pq_keys{2} = R_Correct_T_Real.pq_keys{1} /\ G_StoredSS_T.t_keys.`1{2} = R_Correct_T_Real.corr.`1{1} /\ G_StoredSS_T.t_keys.`2{2} = R_Correct_T_Real.corr.`2{1} /\ G_StoredSS_T.kem_ct_T{2} = R_Correct_T_Real.corr.`3{1} /\ G_StoredSS_T.ss_T_star{2} = R_Correct_T_Real.corr.`4{1} /\ G_StoredSS_T.ctStar{2} = R_Correct_T_Real.ctStar{1} /\ R_Correct_T_Real.corr{1}.`5 = R_Correct_T_Real.corr{1}.`4 ==> ={res} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ G_StoredSS_T.pq_keys{2} = R_Correct_T_Real.pq_keys{1} /\ G_StoredSS_T.t_keys.`1{2} = R_Correct_T_Real.corr.`1{1} /\ G_StoredSS_T.t_keys.`2{2} = R_Correct_T_Real.corr.`2{1} /\ G_StoredSS_T.kem_ct_T{2} = R_Correct_T_Real.corr.`3{1} /\ G_StoredSS_T.ss_T_star{2} = R_Correct_T_Real.corr.`4{1} /\ G_StoredSS_T.ctStar{2} = R_Correct_T_Real.ctStar{1} /\ R_Correct_T_Real.corr{1}.`5 = R_Correct_T_Real.corr{1}.`4 ].
