import 'Cl.primitive';
// Both: (a + 1) + (b + 1) when d holds, else 0.
Game Left(Cl P) {
    Int Test(Int a, Int b, Bool d) {
        return P.Bump(a, d) + P.Bump(b, d);
    }
}
Game Right(Cl P) {
    Int Test(Int a, Int b, Bool d) {
        Int x = a;
        x = x + 1;
        if (d) {
            Int y = b;
            y = y + 1;
            return x + y;
        }
        return 0;
    }
}
export as GBumpCtl;
