  module R_Correct_T_Real_Adv (KEM_PQ : KEM_PQ_c.Scheme, KEM_T : KEM_T_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme, A : Hybrid_c.KEM_INDCCA_Adv, C : KEM_T_c.KEMCorrectnessWithDK_Oracle) = {
