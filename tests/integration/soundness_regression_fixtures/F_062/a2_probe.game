import 'drift.primitive';

Game Real(Drift D) {
    [BitString<4>, BitString<4>] O() {
        BitString<4> a <- BitString<4>;
        BitString<4> b <- BitString<4>;
        BitString<4> a;
        return [a, b];
    }
}

Game Random(Drift D) {
    [BitString<4>, BitString<4>] O() {
        BitString<4> a <- BitString<4>;
        BitString<4> b <- BitString<4>;
        return [a, b];
    }
}

export as A2Probe;
