    apply: dmap_uni_in_inj.
    + move => [x1 y1] [x2 y2] _ _ /= heq.
      have hx : x1 = x2 by rewrite -(slice_concat_left_bs_kem_pq_nct_bs_kem_t_nct_bs_kem_pq_nct_kem_t_nct x1 y1) -(slice_concat_left_bs_kem_pq_nct_bs_kem_t_nct_bs_kem_pq_nct_kem_t_nct x2 y2) heq.
