// The two sides behave identically. Left's DZero also makes a dead read of
// c (Int z = c;), which changes nothing it returns or stores.
Game Left() {
    Int c;
    Int d;
    Void Initialize() { c = 0; d = 0; }
    Int IncC() { c = c + 1; return 0; }
    Int CopyCtoD() { d = c; return 0; }
    Bool DZero() { Int z = c; return d == 0; }
    Bool ThirdB(Int a, Int b, Bool v) { return v; }
}
Game Right() {
    Int c;
    Int d;
    Void Initialize() { c = 0; d = 0; }
    Int IncC() { c = c + 1; return 0; }
    Int CopyCtoD() { d = c; return 0; }
    Bool DZero() { return d == 0; }
    Bool ThirdB(Int a, Int b, Bool v) { return v; }
}
export as CDB;
