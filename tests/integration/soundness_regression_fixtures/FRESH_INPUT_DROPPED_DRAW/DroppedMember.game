// Call Fresh, then Member on all four points. Initialize inserted 0b00
// and Fresh's draw inserted v, so two points are members in Left and
// one in Right, which never draws.
import 'P.primitive';

Game Left(P S) {
    Function<BitString<2>, BitString<2>> H;
    Set<BitString<2>> seen;
    BitString<2> y;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
        seen = seen union {0b00};
        y = H(0b00);
    }
    BitString<2> Reveal() {
        return y;
    }
    Bool Member(BitString<2> x) {
        return x in seen;
    }
    BitString<2> Fresh() {
        BitString<2> v <-uniq[seen] BitString<2>;
        return H(v);
    }
}

Game Right(P S) {
    Function<BitString<2>, BitString<2>> H;
    Set<BitString<2>> seen;
    BitString<2> y;
    Void Initialize() {
        H <- Function<BitString<2>, BitString<2>>;
        seen = seen union {0b00};
        y = H(0b00);
    }
    BitString<2> Reveal() {
        return y;
    }
    Bool Member(BitString<2> x) {
        return x in seen;
    }
    BitString<2> Fresh() {
        BitString<2> z <- BitString<2>;
        return z;
    }
}

export as DroppedMember;
