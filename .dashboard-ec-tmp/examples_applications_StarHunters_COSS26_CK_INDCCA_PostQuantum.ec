      pk0 <@ R_Correct_R(KEM1, KEM2, F, CK(KEM1, KEM2, F), C).initialize();
      b <@ A(R_Correct_R(KEM1, KEM2, F, CK(KEM1, KEM2, F), C)).distinguish(pk0);
