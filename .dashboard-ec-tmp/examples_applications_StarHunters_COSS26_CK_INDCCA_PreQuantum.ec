  (* Game_step_0: KEM_INDCCA_MultiChal.Real *)

  module Game_step_0 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : C_c.KEM_INDCCA_MultiChal_Adv) = {
    proc main() : bool = {
