      pk <@ C_c.KEM_INDCCA_MultiChal_Real(CK(KEM1, KEM2, F)).initialize();
      b <@ A(C_c.KEM_INDCCA_MultiChal_Real(CK(KEM1, KEM2, F))).distinguish(pk);
      return b;
    }
  }.

