      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var isSecondPreimage : bool;
      var r : bs_outlen;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
