  (* transform: Merge Uniform Samples (bucket=canned) *)
  lemma micro_4_left_5 :
    equiv [ Step_4L_state_5(G).query ~ Step_4L_state_6(G).query :
            ={glob G} ==> ={res, glob G} ].
  proof.
    (* resolution: synth-param *)
    proc.
    transitivity {2}
      { __a0__ <$ dmap (dbs_lambda `*` dbs_2_lambda)
                              (fun (p : bs_lambda * bs_2_lambda) =>
                                 concat_bs_lambda_bs_2_lambda_to_bs_3_lambda p.`1 p.`2); }
      (={glob G} ==>
       ={glob G} /\ concat_bs_lambda_bs_2_lambda_to_bs_3_lambda __a0__{1} __a1__{1} = __a0__{2})
      (={glob G} ==> ={glob G} /\ ={__a0__}).
    - by smt().
    - by smt().
    - seq 2 1 : (={glob G} /\
                 __a0__{2} = concat_bs_lambda_bs_2_lambda_to_bs_3_lambda __a0__{1} __a1__{1}); last by auto.
      rndsem*{1} 0.
      rnd (fun (p : bs_lambda * bs_2_lambda) => concat_bs_lambda_bs_2_lambda_to_bs_3_lambda p.`1 p.`2)
          (fun (z : bs_3_lambda) =>
             (slice_bs_3_lambda_to_bs_lambda z 0 lambda,
              slice_bs_3_lambda_to_bs_2_lambda z lambda (3*lambda))).
      skip => />.
      split; first by smt(concat_slices_id_bs_lambda_bs_2_lambda_bs_3_lambda).
      move => _.
      split.
      + move => xR HxR.
        rewrite dmap1E /(\o) /pred1 /=.
        rewrite -(dmap_dprodE dbs_lambda dbs_2_lambda
                              (fun p : bs_lambda * bs_2_lambda => p)) dmap_id.
        apply mu_eq => p /=.
        smt(concat_slices_id_bs_lambda_bs_2_lambda_bs_3_lambda slice_concat_left_bs_lambda_bs_2_lambda_bs_3_lambda slice_concat_right_bs_lambda_bs_2_lambda_bs_3_lambda).
      + move => _ p Hp; split.
        * smt(supp_dmap supp_dprod dprod_dlet dmap_dprodE dmap_id).
        * by smt(slice_concat_left_bs_lambda_bs_2_lambda_bs_3_lambda slice_concat_right_bs_lambda_bs_2_lambda_bs_3_lambda).
    - rnd (fun (z : bs_3_lambda) => z) (fun (z : bs_3_lambda) => z).
      skip => />.
      smt(dbs_3_lambda_split_bs_lambda_bs_2_lambda).
  qed.

