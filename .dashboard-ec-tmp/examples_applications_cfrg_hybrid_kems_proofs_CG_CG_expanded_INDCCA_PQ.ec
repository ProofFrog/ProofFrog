  (* Hop 4: assumption hop. Bounded by the KEM_INDCCA_advantage axiom applied to RB_Adv. *)

  lemma hop_4_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_4(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_5(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEM_INDCCA.
  proof.
    have hL : Pr[Game_step_4(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEM_INDCCA_Real(KEM_PQ, RB_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob RB, glob KEM_PQ, glob NG, glob G, glob H, glob L, glob KEM_PQ_c.KEM_INDCCA_Real}); [ proc; sim | wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); skip => /# ].
    have hR : Pr[Game_step_5(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEM_INDCCA_Random(KEM_PQ, RB_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; wp; call (_: ={glob RB, glob KEM_PQ, glob NG, glob G, glob H, glob L, glob KEM_PQ_c.KEM_INDCCA_Random}); [ proc; sim | wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; call (_: true); wp; call (_: true); wp; call (_: true); wp; rnd; wp; rnd; wp; call (_: true); wp; call (_: true); skip => /# ].
    rewrite hL hR.
    apply (KEM_PQ_c.KEM_INDCCA_advantage KEM_PQ (RB_Adv(KEM_PQ, NG, G, H, L, A)) &m).
    qed.

  (* Hop 5: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_5_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_5(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_6(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ RD.seed_T{2} = RB.seed_T{1} /\ RD.kem_ct{2} = RB.kem_ct{1} /\ RD.ctStar{2} = RB.ctStar{1} /\ RB.ctStar.`1{1} = KEM_PQ_c.KEM_INDCCA_Random.ctStar{1} /\ RB.kem_ct{1} = KEM_PQ_c.KEM_INDCCA_Random.ctStar{1}).
    + conseq hop_5_decaps.
    call hop_5_initialize.
    auto.
    qed.

  (* Hop 6: assumption hop. Bounded by the KDFPRFSec_advantage axiom applied to RD_Adv. *)

  lemma hop_6_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_6(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_7(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= H_c.eps_KDFPRFSec.
  proof.
    have hL : Pr[Game_step_6(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[H_c.Game_KDFPRFSec_Real(H, RD_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_7(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[H_c.Game_KDFPRFSec_Random(H, RD_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (H_c.KDFPRFSec_advantage H (RD_Adv(KEM_PQ, NG, G, H, L, A)) &m).
    qed.

  (* Hop 7: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_7_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    Pr[Game_step_7(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_8(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameFreshSS.pq_keys{2} = RD.pq_keys{1} /\ GameFreshSS.seed_T{2} = RD.seed_T{1} /\ GameFreshSS.kem_ct{2} = RD.kem_ct{1} /\ GameFreshSS.ctStar{2} = RD.ctStar{1} /\ GameFreshSS.rF{2} = H_c.KDFPRFSec_Random.rF{1}).
    + conseq hop_7_decaps.
    call hop_7_initialize.
    auto.
    qed.

  (* Hop 8: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_8_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
