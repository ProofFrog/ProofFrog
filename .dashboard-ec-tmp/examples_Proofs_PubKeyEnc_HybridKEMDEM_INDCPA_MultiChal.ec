  lemma hop_10_pr (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
    Pr[Game_step_10(E, K, A).main() @ &m : res] = Pr[Game_step_11(E, K, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob E, glob K} ==> ={res}) => //.
    proc.
    call (_: ={glob E} /\ ={glob K} /\ K_c.KEM_INDCPA_MultiChal_Real.pk{1} = KD_c.INDCPA_MultiChal_Right.pk{2}).
    + conseq hop_10_challenge.
    call hop_10_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: KD_c.INDCPA_MultiChal_Adv {-K, -E, -KD_c.INDCPA_MultiChal_Left, -KD_c.INDCPA_MultiChal_Right, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R2, -R3, -R4}) &m :
    `| Pr[Game_step_0(E, K, A).main() @ &m : res] - Pr[Game_step_11(E, K, A).main() @ &m : res] | <= K_c.eps_KEM_INDCPA_MultiChal + E_c.eps_KeyUniformity + E_c.eps_INDOT + E_c.eps_KeyUniformity + K_c.eps_KEM_INDCPA_MultiChal.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    have h6 := hop_6_pr A &m.
    have h7 := hop_7_pr A &m.
    have h8 := hop_8_pr A &m.
    have h9 := hop_9_pr A &m.
    have h10 := hop_10_pr A &m.
    smt(E_c.eps_INDOT_pos E_c.eps_KeyUniformity_pos K_c.eps_KEM_INDCPA_MultiChal_pos).
    qed.
end section Main.
