// Positive control for FalseInvariant: here every update keeps pk == g^sk,
// so keeping pk or recomputing it as g^sk is the same game.
Game Left(Group G) {
    GroupElem<G> pk;
    ModInt<G.order> sk;

    GroupElem<G> Initialize() {
        ModInt<G.order> x <- ModInt<G.order>;
        pk = G.generator ^ x;
        sk = x;
        return pk;
    }

    GroupElem<G> Upd(ModInt<G.order> d) {
        pk = pk * G.generator ^ d;
        sk = sk + d;
        return pk;
    }

    ModInt<G.order> Reveal() {
        return sk;
    }
}

Game Right(Group G) {
    ModInt<G.order> sk;

    GroupElem<G> Initialize() {
        sk <- ModInt<G.order>;
        return G.generator ^ sk;
    }

    GroupElem<G> Upd(ModInt<G.order> d) {
        sk = sk + d;
        return G.generator ^ sk;
    }

    ModInt<G.order> Reveal() {
        return sk;
    }
}

export as TrueInvariant;
