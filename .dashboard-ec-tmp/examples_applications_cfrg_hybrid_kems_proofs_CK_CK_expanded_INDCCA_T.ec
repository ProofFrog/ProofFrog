      exists (slice_bs_kem_pq_nct_kem_t_nct_to_bs_kem_pq_nct w 0 kem_pq_nct, slice_bs_kem_pq_nct_kem_t_nct_to_bs_kem_t_nct w kem_pq_nct (kem_pq_nct + kem_t_nct)).
