// A type length that names a written field is ill-formed.
import 'WrittenFieldLength.game';

proof:

let:
    Int n;

assume:

theorem:
    WrittenFieldLength(n);

games:
    WrittenFieldLength(n).Left against WrittenFieldLength(n).Adversary;
    WrittenFieldLength(n).Right against WrittenFieldLength(n).Adversary;
