(* ===== Abstract theory: primitive + security games + assumption ===== *)

abstract theory PRG_Theory.
  type bs_lambda_t.

  op zero_lambda_t : bs_lambda_t.

  type bs_lambda_stretch_t.

  op zero_lambda_stretch_t : bs_lambda_stretch_t.

  op dbs_lambda_t : bs_lambda_t distr.

  axiom dbs_lambda_t_ll : is_lossless dbs_lambda_t.

  axiom dbs_lambda_t_fu : is_funiform dbs_lambda_t.

  axiom dbs_lambda_t_full : is_full dbs_lambda_t.

  op dbs_lambda_stretch_t : bs_lambda_stretch_t distr.

  axiom dbs_lambda_stretch_t_ll : is_lossless dbs_lambda_stretch_t.

  axiom dbs_lambda_stretch_t_fu : is_funiform dbs_lambda_stretch_t.

  axiom dbs_lambda_stretch_t_full : is_full dbs_lambda_stretch_t.

  module type Scheme = {
    proc evaluate(x : bs_lambda_t) : bs_lambda_stretch_t
  }.

  op ev_evaluate : bs_lambda_t -> bs_lambda_stretch_t.

  module type PRGSecurity_Oracle = {
    proc query() : bs_lambda_stretch_t
  }.

  module PRGSecurity_Real (G : Scheme) : PRGSecurity_Oracle = {
    proc query() : bs_lambda_stretch_t = {
      var s : bs_lambda_t;
      var _r0 : bs_lambda_stretch_t;
      s <$ dbs_lambda_t;
      _r0 <@ G.evaluate(s);
      return _r0;
    }
  }.

  module PRGSecurity_Random (G : Scheme) : PRGSecurity_Oracle = {
    proc query() : bs_lambda_stretch_t = {
      var r : bs_lambda_stretch_t;
      r <$ dbs_lambda_stretch_t;
      return r;
    }
  }.

  module type PRGSecurity_Adv (O : PRGSecurity_Oracle) = {
    proc distinguish() : bool
  }.

  module Game_PRGSecurity_Real (Em : Scheme, A : PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(PRGSecurity_Real(Em)).distinguish();
      return b;
    }
  }.

  module Game_PRGSecurity_Random (Em : Scheme, A : PRGSecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(PRGSecurity_Random(Em)).distinguish();
      return b;
    }
  }.

  op eps_PRGSecurity : real.

  axiom eps_PRGSecurity_pos : 0%r <= eps_PRGSecurity.

  axiom PRGSecurity_advantage (Em <: Scheme) (A <: PRGSecurity_Adv) &m :
    `| Pr[Game_PRGSecurity_Real(Em, A).main() @ &m : res] - Pr[Game_PRGSecurity_Random(Em, A).main() @ &m : res] | <= eps_PRGSecurity.
end PRG_Theory.

(* ===== Theory instantiation ===== *)

clone PRG_Theory as G_c with
  type bs_lambda_t <- bs_lambda,
  type bs_lambda_stretch_t <- bs_2_lambda,
  op dbs_lambda_t <- dbs_lambda,
  op dbs_lambda_stretch_t <- dbs_2_lambda.

