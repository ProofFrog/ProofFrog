    transitivity Step_4R_state_4(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | apply micro_4_right_4_rev |].
    transitivity Step_4R_state_3(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | apply micro_4_right_3_rev |].
    transitivity Step_4R_state_2(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | apply micro_4_right_2_rev |].
    transitivity Step_4R_state_1(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | apply micro_4_right_1_rev |].
    apply micro_4_right_0_rev.
  qed.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0 :
    equiv [ KC_c.KEMCorrectnessKG_FromDecaps(KEMCombiner(KEM1, KEM2, F)).compute ~ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEMCorrectness_FromDecaps(KEM1)).compute :
            ={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_0L_state_0(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_0R_state_0(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | apply hop_0_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  lemma hop_2 :
    equiv [ R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEMCorrectness_FromEncaps(KEM1)).compute ~ R_KEM2(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromDecaps(KEM2)).compute :
            ={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_2L_state_0(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_2R_state_0(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | apply hop_2_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  lemma hop_4 :
    equiv [ R_KEM2(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromEncaps(KEM2)).compute ~ KC_c.KEMCorrectnessKG_FromEncaps(KEMCombiner(KEM1, KEM2, F)).compute :
            ={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F} ].
  proof.
    (* Per-transform: bridge wrappers to flat states, chain through. *)
    transitivity Step_4L_state_0(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | proc; inline *; ((sp; wp; sim) || sim) |].
    transitivity Step_4R_state_0(KEM1, KEM2, F).compute (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}) (={glob KEM1, glob KEM2, glob F} ==> ={res, glob KEM1, glob KEM2, glob F}); [ smt() | smt() | apply hop_4_chain | proc; inline *; ((sp; wp; sim) || sim) ].
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: KC_c.KEMCorrectnessKG_Adv {-KEM1, -KEM2, -F}) &m :
    Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc.
    call (_: ={glob KEM1, glob KEM2, glob F}); first by conseq hop_0.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEMCorrectness_advantage axiom applied to R_KEM1_Adv. *)

  lemma hop_1_pr (A <: KC_c.KEMCorrectnessKG_Adv {-KEM1, -KEM2, -F}) &m :
    `| Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM1_c.eps_KEMCorrectness.
  proof.
    have hL : Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM1_c.Game_KEMCorrectness_FromDecaps(KEM1, R_KEM1_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM1_c.Game_KEMCorrectness_FromEncaps(KEM1, R_KEM1_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM1_c.KEMCorrectness_advantage KEM1 (R_KEM1_Adv(KEM1, KEM2, F, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: KC_c.KEMCorrectnessKG_Adv {-KEM1, -KEM2, -F}) &m :
    Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc.
    call (_: ={glob KEM1, glob KEM2, glob F}); first by conseq hop_2.
    auto.
    qed.

  (* Hop 3: assumption hop. Bounded by the KEMCorrectness_advantage axiom applied to R_KEM2_Adv. *)

  lemma hop_3_pr (A <: KC_c.KEMCorrectnessKG_Adv {-KEM1, -KEM2, -F}) &m :
    `| Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEMCorrectness.
  proof.
    have hL : Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromDecaps(KEM2, R_KEM2_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    have hR : Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromEncaps(KEM2, R_KEM2_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM2_c.KEMCorrectness_advantage KEM2 (R_KEM2_Adv(KEM1, KEM2, F, A)) &m).
    qed.

  (* Hop 4: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_4_pr (A <: KC_c.KEMCorrectnessKG_Adv {-KEM1, -KEM2, -F}) &m :
    Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc.
    call (_: ={glob KEM1, glob KEM2, glob F}); first by conseq hop_4.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: KC_c.KEMCorrectnessKG_Adv {-KEM1, -KEM2, -F}) &m :
    `| Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM1_c.eps_KEMCorrectness + KEM2_c.eps_KEMCorrectness.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    smt(KEM1_c.eps_KEMCorrectness_pos KEM2_c.eps_KEMCorrectness_pos).
    qed.
end section Main.
