import 'Picker.primitive';

// Pick draws outside S (the draw cannot complete when S is all of
// BitString<1>) and returns false. Its local is named `cond`.
Scheme PickCond() extends Picker {
    Bool Pick(Set<BitString<1>> S) {
        Bool cond = false;
        BitString<1> x <- BitString<1> \ S;
        return cond;
    }
}
