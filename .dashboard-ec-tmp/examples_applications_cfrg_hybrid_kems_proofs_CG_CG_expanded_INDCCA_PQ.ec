  module RB (KEM_PQ : KEM_PQ_c.Scheme, NG : NG_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme, Hybrid : Hybrid_c.Scheme, Challenger : KEM_PQ_c.KEM_INDCCA_Oracle) = {
