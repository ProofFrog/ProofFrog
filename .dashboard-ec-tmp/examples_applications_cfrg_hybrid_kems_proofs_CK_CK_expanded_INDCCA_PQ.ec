  lemma hop_13_decaps :
    equiv [ GameCaseSplitIdeal(KEM_PQ, KEM_T, G, H, L).decaps ~ R_Correct_Ideal(KEM_PQ, KEM_T, G, H, L, CK_expanded(KEM_PQ, KEM_T, G, H, L), KEM_PQ_c.KEMCorrectnessWithDK_FromEncaps(KEM_PQ)).decaps :
            ={ct} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameCaseSplitIdeal.pq_keys.`1{1} = R_Correct_Ideal.corr.`1{2} /\ GameCaseSplitIdeal.pq_keys.`2{1} = R_Correct_Ideal.corr.`2{2} /\ GameCaseSplitIdeal.t_keys{1} = R_Correct_Ideal.t_keys{2} /\ GameCaseSplitIdeal.kem_ct{1} = R_Correct_Ideal.corr.`3{2} /\ GameCaseSplitIdeal.ss_PQ{1} = R_Correct_Ideal.corr.`4{2} /\ GameCaseSplitIdeal.ctStar{1} = R_Correct_Ideal.ctStar{2} /\ R_Correct_Ideal.corr{2}.`5 = R_Correct_Ideal.corr{2}.`4 ==> ={res} /\ ={glob KEM_PQ} /\ ={glob KEM_T} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameCaseSplitIdeal.pq_keys.`1{1} = R_Correct_Ideal.corr.`1{2} /\ GameCaseSplitIdeal.pq_keys.`2{1} = R_Correct_Ideal.corr.`2{2} /\ GameCaseSplitIdeal.t_keys{1} = R_Correct_Ideal.t_keys{2} /\ GameCaseSplitIdeal.kem_ct{1} = R_Correct_Ideal.corr.`3{2} /\ GameCaseSplitIdeal.ss_PQ{1} = R_Correct_Ideal.corr.`4{2} /\ GameCaseSplitIdeal.ctStar{1} = R_Correct_Ideal.ctStar{2} /\ R_Correct_Ideal.corr{2}.`5 = R_Correct_Ideal.corr{2}.`4 ].
  proof.
    (* resolution: synth-param *)
    proc.
    if; 1: smt().
    auto.
