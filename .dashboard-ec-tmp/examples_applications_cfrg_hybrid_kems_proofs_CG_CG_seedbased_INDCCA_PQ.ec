         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_21_initialize :
    equiv [ R_KG_R(KEM_PQ, NG, G, H, L, CG_seedbased(KEM_PQ, NG, G, H, L), KEM_PQ_c.KeyGenEquiv_FromDeriveKeyPair(KEM_PQ)).initialize ~ R_PRG_R(KEM_PQ, NG, G, H, L, CG_seedbased(KEM_PQ, NG, G, H, L), G_c.PRGSec_Random(G)).initialize :
            ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 21, oracle 'initialize': init equiv
       with a dead F.evaluate on one side (PRF-random hop). The shared
       backbone is keygen; encaps; <fresh sample>, but one wrapper still
       runs an F.evaluate whose result the sample overwrites. Drop it with a
       one-sided phoare, then peel the common backbone:
         proc. inline *.
         (* drop the dead F.evaluate on the side that has it: *)
         seq <k> <k+1> : (={glob K, glob F} /\ <live coupling>).
         + exists* (glob F){i}, <Fseedi>, <Finputi>; elim* => gf a0 a1;
           call{i} (F_evaluate_det gf a0 a1); auto.
         wp; rnd; wp; call (_: true); wp; call (_: true); skip => /#. *)
    admit.
    qed.

  lemma hop_21_decaps :
    equiv [ R_KG_R(KEM_PQ, NG, G, H, L, CG_seedbased(KEM_PQ, NG, G, H, L), KEM_PQ_c.KeyGenEquiv_FromDeriveKeyPair(KEM_PQ)).decaps ~ R_PRG_R(KEM_PQ, NG, G, H, L, CG_seedbased(KEM_PQ, NG, G, H, L), G_c.PRGSec_Random(G)).decaps :
            ={ct} /\ ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 21, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  lemma hop_23_initialize :
    equiv [ R_PRG_R(KEM_PQ, NG, G, H, L, CG_seedbased(KEM_PQ, NG, G, H, L), G_c.PRGSec_Real(G)).initialize ~ Hybrid_c.KEM_INDCCA_Random(CG_seedbased(KEM_PQ, NG, G, H, L)).initialize :
            ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_PRG_R.ctStar{1} ].
  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    wp.
    rnd.
    wp.
    exists* (glob H){2}; elim* => gf0.
    call{2} (H_evaluate_pres gf0).
    wp.
    exists* (glob L){2}; elim* => gf1.
    call{2} (L_get_pres gf1).
    wp.
    exists* (glob NG){2}; elim* => gf2.
    call{2} (NG_encode_pres gf2).
    wp.
    exists* (glob NG){2}; elim* => gf3.
    call{2} (NG_encode_pres gf3).
    wp.
    exists* (glob KEM_PQ){2}; elim* => gf4.
    call{2} (KEM_PQ_encodesharedsecret_pres gf4).
    wp.
    exists* (glob NG){2}; elim* => gf5.
    call{2} (NG_elementtosharedsecret_pres gf5).
    wp.
    call (_: true).
    wp.
    exists* (glob NG){2}; elim* => gf6.
    call{2} (NG_exp_pres gf6).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    rnd.
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    rnd.
    skip => /#.
    qed.

  lemma hop_23_decaps :
    equiv [ R_PRG_R(KEM_PQ, NG, G, H, L, CG_seedbased(KEM_PQ, NG, G, H, L), G_c.PRGSec_Real(G)).decaps ~ Hybrid_c.KEM_INDCCA_Random(CG_seedbased(KEM_PQ, NG, G, H, L)).decaps :
            ={ct} /\ ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_PRG_R.ctStar{1} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_PRG_R.ctStar{1} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 23, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    Pr[Game_step_0(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_1(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Real.ctStar{1} = R_PRG_L.ctStar{2}).
    + conseq hop_0_decaps.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the PRGSec_advantage axiom applied to R_PRG_L_Adv. *)

  lemma hop_1_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    `| Pr[Game_step_1(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_2(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= G_c.eps_PRGSec.
  proof.
    have hL : Pr[Game_step_1(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSec_Real(G, R_PRG_L_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSec_Random(G, R_PRG_L_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (G_c.PRGSec_advantage G (R_PRG_L_Adv(KEM_PQ, NG, G, H, L, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    Pr[Game_step_2(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_3(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L}).
    + conseq hop_2_decaps.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: assumption hop. Bounded by the KeyGenEquiv_advantage axiom applied to R_KG_L_Adv. *)

  lemma hop_3_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    `| Pr[Game_step_3(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_4(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KeyGenEquiv.
  proof.
    have hL : Pr[Game_step_3(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KeyGenEquiv_FromDeriveKeyPair(KEM_PQ, R_KG_L_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_4(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KeyGenEquiv_FromKeyGen(KEM_PQ, R_KG_L_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM_PQ_c.KeyGenEquiv_advantage KEM_PQ (R_KG_L_Adv(KEM_PQ, NG, G, H, L, A)) &m).
    qed.

  (* Hop 4: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_4_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    Pr[Game_step_4(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_5(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ R_Correct_Real.corr{2}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Real.corr{2}.`2) (R_Correct_Real.corr{2}.`3)).
    + conseq hop_4_decaps.
    call hop_4_initialize.
    auto.
    qed.

  (* Hop 5: assumption hop. Bounded by the KEMCorrectnessWithDK_advantage axiom applied to R_Correct_Real_Adv. *)

  lemma hop_5_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    `| Pr[Game_step_5(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_6(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEMCorrectnessWithDK.
  proof.
    have hL : Pr[Game_step_5(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromDecaps(KEM_PQ, R_Correct_Real_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_6(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[KEM_PQ_c.Game_KEMCorrectnessWithDK_FromEncaps(KEM_PQ, R_Correct_Real_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM_PQ_c.KEMCorrectnessWithDK_advantage KEM_PQ (R_Correct_Real_Adv(KEM_PQ, NG, G, H, L, A)) &m).
    qed.

  (* Hop 6: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_6_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    Pr[Game_step_6(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_7(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameCaseSplitReal.pq_keys.`1{2} = R_Correct_Real.corr.`1{1} /\ GameCaseSplitReal.pq_keys.`2{2} = R_Correct_Real.corr.`2{1} /\ GameCaseSplitReal.seed_T{2} = R_Correct_Real.seed_T{1} /\ GameCaseSplitReal.kem_ct{2} = R_Correct_Real.corr.`3{1} /\ GameCaseSplitReal.ss_PQ{2} = R_Correct_Real.corr.`4{1} /\ GameCaseSplitReal.ctStar{2} = R_Correct_Real.ctStar{1} /\ R_Correct_Real.corr{1}.`5 = R_Correct_Real.corr{1}.`4).
    + conseq hop_6_decaps.
    call hop_6_initialize.
    auto.
    qed.

  (* Hop 7: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_7_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    Pr[Game_step_7(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_8(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ GameCaseSplitReal.pq_keys.`1{1} = RB.ek_PQ{2} /\ GameCaseSplitReal.seed_T{1} = RB.seed_T{2} /\ GameCaseSplitReal.kem_ct{1} = RB.kem_ct{2} /\ GameCaseSplitReal.ss_PQ{1} = RB.ss_PQ{2} /\ GameCaseSplitReal.ctStar{1} = RB.ctStar{2} /\ RB.ctStar.`1{2} = KEM_PQ_c.KEM_INDCCA_Real.ctStar{2} /\ RB.kem_ct{2} = KEM_PQ_c.KEM_INDCCA_Real.ctStar{2}).
    + conseq hop_7_decaps.
    call hop_7_initialize.
    auto.
    qed.

  (* Hop 8: assumption hop. Bounded by the KEM_INDCCA_advantage axiom applied to RB_Adv. *)

  lemma hop_8_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    `| Pr[Game_step_8(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_9(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= KEM_PQ_c.eps_KEM_INDCCA.
