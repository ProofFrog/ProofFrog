(* ===== Abstract theory: primitive + security games + assumption ===== *)

abstract theory KEM_Theory.
  type publickey.

  type secretkey.

  type sharedsecret.

  type ciphertext.

  module type Scheme = {
    proc keygen() : publickey * secretkey
    proc encaps(pk : publickey) : sharedsecret * ciphertext
    proc decaps(sk : secretkey, m : ciphertext) : sharedsecret
  }.

  op ev_decaps : secretkey -> ciphertext -> sharedsecret.

  module type KEMCorrectness_Oracle = {
    proc compute(pk : publickey, sk : secretkey) : ciphertext * sharedsecret * sharedsecret
  }.

  module KEMCorrectness_FromDecaps (K : Scheme) : KEMCorrectness_Oracle = {
    proc compute(pk : publickey, sk : secretkey) : ciphertext * sharedsecret * sharedsecret = {
      var _tup : sharedsecret * ciphertext;
      var ss_e : sharedsecret;
      var ct : ciphertext;
      var ss_d : sharedsecret;
      _tup <@ K.encaps(pk);
      ss_e <- _tup.`1;
      ct <- _tup.`2;
      ss_d <@ K.decaps(sk, ct);
      return (ct, ss_e, ss_d);
    }
  }.

  module KEMCorrectness_FromEncaps (K : Scheme) : KEMCorrectness_Oracle = {
    proc compute(pk : publickey, sk : secretkey) : ciphertext * sharedsecret * sharedsecret = {
      var _tup : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ct : ciphertext;
      _tup <@ K.encaps(pk);
      ss <- _tup.`1;
      ct <- _tup.`2;
      return (ct, ss, ss);
    }
  }.

  module type KEMCorrectness_Adv (O : KEMCorrectness_Oracle) = {
    proc distinguish() : bool
  }.

  module type KEMCorrectnessKG_Oracle = {
    proc compute() : ciphertext * sharedsecret * sharedsecret
  }.

  module KEMCorrectnessKG_FromDecaps (K : Scheme) : KEMCorrectnessKG_Oracle = {
    proc compute() : ciphertext * sharedsecret * sharedsecret = {
      var _tup : publickey * secretkey;
      var pk : publickey;
      var sk : secretkey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss_e : sharedsecret;
      var ct : ciphertext;
      var ss_d : sharedsecret;
      _tup <@ K.keygen();
      pk <- _tup.`1;
      sk <- _tup.`2;
      _tup_0 <@ K.encaps(pk);
      ss_e <- _tup_0.`1;
      ct <- _tup_0.`2;
      ss_d <@ K.decaps(sk, ct);
      return (ct, ss_e, ss_d);
    }
  }.

  module KEMCorrectnessKG_FromEncaps (K : Scheme) : KEMCorrectnessKG_Oracle = {
    proc compute() : ciphertext * sharedsecret * sharedsecret = {
      var _tup : publickey * secretkey;
      var pk : publickey;
      var sk : secretkey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ct : ciphertext;
      _tup <@ K.keygen();
      pk <- _tup.`1;
      sk <- _tup.`2;
      _tup_0 <@ K.encaps(pk);
      ss <- _tup_0.`1;
      ct <- _tup_0.`2;
      return (ct, ss, ss);
    }
  }.

  module type KEMCorrectnessKG_Adv (O : KEMCorrectnessKG_Oracle) = {
    proc distinguish() : bool
  }.

  module Game_KEMCorrectness_FromDecaps (Em : Scheme, A : KEMCorrectness_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectness_FromDecaps(Em)).distinguish();
      return b;
    }
  }.

  module Game_KEMCorrectness_FromEncaps (Em : Scheme, A : KEMCorrectness_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectness_FromEncaps(Em)).distinguish();
      return b;
    }
  }.

  op eps_KEMCorrectness : real.

  axiom eps_KEMCorrectness_pos : 0%r <= eps_KEMCorrectness.

  axiom KEMCorrectness_advantage (Em <: Scheme) (A <: KEMCorrectness_Adv) &m :
    `| Pr[Game_KEMCorrectness_FromDecaps(Em, A).main() @ &m : res] - Pr[Game_KEMCorrectness_FromEncaps(Em, A).main() @ &m : res] | <= eps_KEMCorrectness.
end KEM_Theory.

