(* NOTE: the FrogLang scheme has `requires` clauses that are not enforced by the EC export. The scheme module below may fail EC type-checking because cross-clone type equalities implied by the `requires` are not expressed in the clones. Deferred to Phase 5D. *)

(* ===== Concrete scheme implementation ===== *)

module CK (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : C_c.Scheme = {
  proc keygen() : (PK1Space * PK2Space) * (SK1Space * SK2Space * PK2Space) = {
    var k1 : PK1Space * SK1Space;
    var k2 : PK2Space * SK2Space;
    k1 <@ KEM1.keygen();
    k2 <@ KEM2.keygen();
    return ((k1.`1, k2.`1), (k1.`2, k2.`2, k2.`1));
  }
  proc encaps(pk : PK1Space * PK2Space) : bs_outlen * (CT1Space * CT2Space) = {
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var _tup : SS1Space * CT1Space;
    var ss1 : SS1Space;
    var ct1 : CT1Space;
    var _tup_0 : SS2Space * CT2Space;
    var ss2 : SS2Space;
    var ct2 : CT2Space;
    var bct2 : bs_ct2len;
    var bpk2 : bs_pk2len;
    var label : bs_ct2len_pk2len;
    var ss : bs_outlen;
    pk1 <- pk.`1;
    pk2 <- pk.`2;
    _tup <@ KEM1.encaps(pk1);
    ss1 <- _tup.`1;
    ct1 <- _tup.`2;
    _tup_0 <@ KEM2.encaps(pk2);
    ss2 <- _tup_0.`1;
    ct2 <- _tup_0.`2;
    bct2 <- ct2;
    bpk2 <- pk2;
    label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
    ss <@ F.evaluate(ss1, ss2, label);
    return (ss, (ct1, ct2));
  }
  proc decaps(sk : SK1Space * SK2Space * PK2Space, c : CT1Space * CT2Space) : bs_outlen = {
    var sk1 : SK1Space;
    var sk2 : SK2Space;
    var pk2 : PK2Space;
    var ct1 : CT1Space;
    var ct2 : CT2Space;
    var ss1 : SS1Space;
    var ss2 : SS2Space;
    var bct2 : bs_ct2len;
    var bpk2 : bs_pk2len;
    var label : bs_ct2len_pk2len;
    var _r0 : bs_outlen;
    sk1 <- sk.`1;
    sk2 <- sk.`2;
    pk2 <- sk.`3;
    ct1 <- c.`1;
    ct2 <- c.`2;
    ss1 <@ KEM1.decaps(sk1, ct1);
    ss2 <@ KEM2.decaps(sk2, ct2);
    bct2 <- ct2;
    bpk2 <- pk2;
    label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
    _r0 <@ F.evaluate(ss1, ss2, label);
    return _r0;
  }
}.

section Main.
  (* ===== Reductions ===== *)

  module R_Correct_L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, C : C_c.Scheme, Challenger : KEM1_c.KEMCorrectness_Oracle) = {
    var ss1d : SS1Space
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var pk : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var _tup_1 : CT1Space * SS1Space * SS1Space;
      var ss1e : SS1Space;
      var _tup_2 : SS2Space * CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ Challenger.compute(pk, sk1);
      ct1Star <- _tup_1.`1;
      ss1e <- _tup_1.`2;
      ss1d <- _tup_1.`3;
      _tup_2 <@ KEM2.encaps(pk2);
      ss2 <- _tup_2.`1;
      ct2Star <- _tup_2.`2;
      bct2 <- ct2Star;
      bpk2 <- pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ F.evaluate(ss1e, ss2, label);
      return ((pk, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var _r1 : bs_outlen;
      var ss1 : SS1Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss2 <@ KEM2.decaps(sk2, ct2);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct1 = ct1Star) {
          _r1 <@ F.evaluate(ss1d, ss2, label);
          _r0 <- Some (_r1);
        } else {
          ss1 <@ KEM1.decaps(sk1, ct1);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

  module R_Correct_R (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, C : C_c.Scheme, Challenger : KEM1_c.KEMCorrectness_Oracle) = {
    var ss1d : SS1Space
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var pk : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var corr : CT1Space * SS1Space * SS1Space;
      var rsp2 : SS2Space * CT2Space;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      corr <@ Challenger.compute(pk, sk1);
      ct1Star <- corr.`1;
      ss1d <- corr.`3;
      rsp2 <@ KEM2.encaps(pk2);
      ct2Star <- rsp2.`2;
      ss <$ dbs_outlen;
      return ((pk, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var _r1 : bs_outlen;
      var ss1 : SS1Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss2 <@ KEM2.decaps(sk2, ct2);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct1 = ct1Star) {
          _r1 <@ F.evaluate(ss1d, ss2, label);
          _r0 <- Some (_r1);
        } else {
          ss1 <@ KEM1.decaps(sk1, ct1);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

  module R_KEM1_L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, C : C_c.Scheme, Challenger : KEM1_c.KEM_INDCCA_MultiChal_Oracle) = {
    var ss1Star : SS1Space
    var sk2 : SK2Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SS1Space * CT1Space;
      var pk1 : PK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var _tup_1 : SS2Space * CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var ss : bs_outlen;
      _tup <@ Challenger.initialize();
      pk1 <- _tup.`1;
      ss1Star <- _tup.`2;
      ct1Star <- _tup.`3;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ KEM2.encaps(pk2);
      ss2 <- _tup_1.`1;
      ct2Star <- _tup_1.`2;
      bct2 <- ct2Star;
      bpk2 <- pk2;
      label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
      ss <@ F.evaluate(ss1Star, ss2, label);
      return ((pk1, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss2 : SS2Space;
      var bct2 : bs_ct2len;
      var bpk2 : bs_pk2len;
      var label : bs_ct2len_pk2len;
      var _r1 : bs_outlen;
      var ss1_opt : SS1Space option;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss2 <@ KEM2.decaps(sk2, ct2);
        bct2 <- ct2;
        bpk2 <- pk2;
        label <- concat_bs_ct2len_bs_pk2len_to_bs_ct2len_pk2len bct2 bpk2;
        if (ct1 = ct1Star) {
          _r1 <@ F.evaluate(ss1Star, ss2, label);
          _r0 <- Some (_r1);
        } else {
          ss1_opt <@ Challenger.decaps(ct1);
          if (false) {
            _r0 <- None;
          } else {
            _r2 <@ F.evaluate(oget (ss1_opt), ss2, label);
            _r0 <- Some (_r2);
          }
        }
      }
      return _r0;
    }
  }.

