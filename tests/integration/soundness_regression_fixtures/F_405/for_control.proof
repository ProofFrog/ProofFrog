// Target: method inliner (visitors.InlineTransformer), the names an inlined
// body's variables get (F-405).
// Control: a true equivalence; a sound engine prints Proof Succeeded!.
// for_capture's Left against its true value.
import 'Cl.primitive';
import 'ClImpl.scheme';
import 'GSumCtl.game';
proof:
let:
    ClImpl P = ClImpl();
assume:
theorem:
    GSumCtl(P);
games:
    GSumCtl(P).Left against GSumCtl(P).Adversary;
    GSumCtl(P).Right against GSumCtl(P).Adversary;
