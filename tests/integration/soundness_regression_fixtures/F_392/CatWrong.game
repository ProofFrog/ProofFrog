Game Left(Int k, Int n) {
    BitString<k * k + n> Get() {
        BitString<k * k> a <- BitString<k * k>;
        BitString<n> b <- BitString<n>;
        return a || b;
    }
}
Game Right(Int k, Int n) {
    BitString<k * k + n> Get() {
        BitString<k * k> c <- BitString<k * k>;
        return c || 0^n;
    }
}
export as CatWrong;
