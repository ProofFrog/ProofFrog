(* ===== Abstract theory: primitive + security games + assumption ===== *)

abstract theory KEM_Theory.
  type publickey.

  type secretkey.

  type sharedsecret.

  type ciphertext.

  op dsharedsecret : sharedsecret distr.

  axiom dsharedsecret_ll : is_lossless dsharedsecret.

  axiom dsharedsecret_fu : is_funiform dsharedsecret.

  axiom dsharedsecret_full : is_full dsharedsecret.

  module type Scheme = {
    proc keygen() : publickey * secretkey
    proc encaps(pk : publickey) : sharedsecret * ciphertext
    proc decaps(sk : secretkey, m : ciphertext) : sharedsecret
  }.

  op ev_decaps : secretkey -> ciphertext -> sharedsecret.

  module type KEM_INDCCA_MultiChal_Oracle = {
    proc initialize() : publickey * sharedsecret * ciphertext
    proc decaps(c : ciphertext) : sharedsecret option
  }.

  module KEM_INDCCA_MultiChal_Real (K : Scheme) : KEM_INDCCA_MultiChal_Oracle = {
    var sk : secretkey
    var ctStar : ciphertext
    proc initialize() : publickey * sharedsecret * ciphertext = {
      var _tup : publickey * secretkey;
      var pk : publickey;
      var _tup_0 : sharedsecret * ciphertext;
      var ss : sharedsecret;
      _tup <@ K.keygen();
      pk <- _tup.`1;
      sk <- _tup.`2;
      _tup_0 <@ K.encaps(pk);
      ss <- _tup_0.`1;
      ctStar <- _tup_0.`2;
      return (pk, ss, ctStar);
    }
    proc decaps(c : ciphertext) : sharedsecret option = {
      var _r0 : sharedsecret option;
      var _r1 : sharedsecret;
      if (c = ctStar) {
        _r0 <- None;
      } else {
        _r1 <@ K.decaps(sk, c);
        _r0 <- Some (_r1);
      }
      return _r0;
    }
  }.

  module KEM_INDCCA_MultiChal_Random (K : Scheme) : KEM_INDCCA_MultiChal_Oracle = {
    var sk : secretkey
    var ctStar : ciphertext
    proc initialize() : publickey * sharedsecret * ciphertext = {
      var _tup : publickey * secretkey;
      var pk : publickey;
      var _tup_0 : sharedsecret * ciphertext;
      var ssReal : sharedsecret;
      var ss : sharedsecret;
      _tup <@ K.keygen();
      pk <- _tup.`1;
      sk <- _tup.`2;
      _tup_0 <@ K.encaps(pk);
      ssReal <- _tup_0.`1;
      ctStar <- _tup_0.`2;
      ss <$ dsharedsecret;
      return (pk, ss, ctStar);
    }
    proc decaps(c : ciphertext) : sharedsecret option = {
      var _r0 : sharedsecret option;
      var _r1 : sharedsecret;
      if (c = ctStar) {
        _r0 <- None;
      } else {
        _r1 <@ K.decaps(sk, c);
        _r0 <- Some (_r1);
      }
      return _r0;
    }
  }.

  module type KEM_INDCCA_MultiChal_Adv (O : KEM_INDCCA_MultiChal_Oracle) = {
    proc distinguish(pk : publickey * sharedsecret * ciphertext) : bool {O.decaps}
  }.

  module type KEMCorrectness_Oracle = {
    proc compute(pk : publickey, sk : secretkey) : ciphertext * sharedsecret * sharedsecret
  }.

  module KEMCorrectness_FromDecaps (K : Scheme) : KEMCorrectness_Oracle = {
    proc compute(pk : publickey, sk : secretkey) : ciphertext * sharedsecret * sharedsecret = {
      var _tup : sharedsecret * ciphertext;
      var ss_e : sharedsecret;
      var ct : ciphertext;
      var ss_d : sharedsecret;
      _tup <@ K.encaps(pk);
      ss_e <- _tup.`1;
      ct <- _tup.`2;
      ss_d <@ K.decaps(sk, ct);
      return (ct, ss_e, ss_d);
    }
  }.

  module KEMCorrectness_FromEncaps (K : Scheme) : KEMCorrectness_Oracle = {
    proc compute(pk : publickey, sk : secretkey) : ciphertext * sharedsecret * sharedsecret = {
      var _tup : sharedsecret * ciphertext;
      var ss : sharedsecret;
      var ct : ciphertext;
      _tup <@ K.encaps(pk);
      ss <- _tup.`1;
      ct <- _tup.`2;
      return (ct, ss, ss);
    }
  }.

  module type KEMCorrectness_Adv (O : KEMCorrectness_Oracle) = {
    proc distinguish() : bool
  }.

  module Game_KEM_INDCCA_MultiChal_Real (Em : Scheme, A : KEM_INDCCA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : publickey * sharedsecret * ciphertext;
      pk <@ KEM_INDCCA_MultiChal_Real(Em).initialize();
      b <@ A(KEM_INDCCA_MultiChal_Real(Em)).distinguish(pk);
      return b;
    }
  }.

  module Game_KEM_INDCCA_MultiChal_Random (Em : Scheme, A : KEM_INDCCA_MultiChal_Adv) = {
    proc main() : bool = {
      var b : bool;
      var pk : publickey * sharedsecret * ciphertext;
      pk <@ KEM_INDCCA_MultiChal_Random(Em).initialize();
      b <@ A(KEM_INDCCA_MultiChal_Random(Em)).distinguish(pk);
      return b;
    }
  }.

  op eps_KEM_INDCCA_MultiChal : real.

  axiom eps_KEM_INDCCA_MultiChal_pos : 0%r <= eps_KEM_INDCCA_MultiChal.

  axiom KEM_INDCCA_MultiChal_advantage (Em <: Scheme) (A <: KEM_INDCCA_MultiChal_Adv) &m :
    `| Pr[Game_KEM_INDCCA_MultiChal_Real(Em, A).main() @ &m : res] - Pr[Game_KEM_INDCCA_MultiChal_Random(Em, A).main() @ &m : res] | <= eps_KEM_INDCCA_MultiChal.

  module Game_KEMCorrectness_FromDecaps (Em : Scheme, A : KEMCorrectness_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectness_FromDecaps(Em)).distinguish();
      return b;
    }
  }.

  module Game_KEMCorrectness_FromEncaps (Em : Scheme, A : KEMCorrectness_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KEMCorrectness_FromEncaps(Em)).distinguish();
      return b;
    }
  }.

  op eps_KEMCorrectness : real.

  axiom eps_KEMCorrectness_pos : 0%r <= eps_KEMCorrectness.

  axiom KEMCorrectness_advantage (Em <: Scheme) (A <: KEMCorrectness_Adv) &m :
    `| Pr[Game_KEMCorrectness_FromDecaps(Em, A).main() @ &m : res] - Pr[Game_KEMCorrectness_FromEncaps(Em, A).main() @ &m : res] | <= eps_KEMCorrectness.
end KEM_Theory.

