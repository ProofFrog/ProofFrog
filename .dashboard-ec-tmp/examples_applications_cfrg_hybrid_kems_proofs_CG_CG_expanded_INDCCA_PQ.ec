  lemma hop_15_initialize :
    equiv [ R_Correct_Ideal(KEM_PQ, NG, G, H, L, CG_expanded(KEM_PQ, NG, G, H, L), KEM_PQ_c.KEMCorrectnessWithDK_FromDecaps(KEM_PQ)).initialize ~ Hybrid_c.KEM_INDCCA_Random(CG_expanded(KEM_PQ, NG, G, H, L)).initialize :
            ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} ==> ={res} /\ ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.dk.`1{2} = R_Correct_Ideal.corr.`2{1} /\ Hybrid_c.KEM_INDCCA_Random.dk.`3{2} = NG_c.ev_exp (NG_c.ev_generator) (Hybrid_c.KEM_INDCCA_Random.dk.`2{2}) /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_Correct_Ideal.ctStar{1} /\ R_Correct_Ideal.corr{1}.`5 = KEM_PQ_c.ev_decaps (R_Correct_Ideal.corr{1}.`2) (R_Correct_Ideal.corr{1}.`3) ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 15, oracle 'initialize': init equiv
       with a dead F.evaluate on one side (PRF-random hop). The shared
       backbone is keygen; encaps; <fresh sample>, but one wrapper still
       runs an F.evaluate whose result the sample overwrites. Drop it with a
       one-sided phoare, then peel the common backbone:
         proc. inline *.
         (* drop the dead F.evaluate on the side that has it: *)
         seq <k> <k+1> : (={glob K, glob F} /\ <live coupling>).
         + exists* (glob F){i}, <Fseedi>, <Finputi>; elim* => gf a0 a1;
           call{i} (F_evaluate_det gf a0 a1); auto.
         wp; rnd; wp; call (_: true); wp; call (_: true); skip => /#. *)
    admit.
    qed.

