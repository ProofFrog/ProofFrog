// Target: Dead Null Guard Elimination (None-test folding), F-416 fix, gap1 item D.
// Hypothesis: as member_alias_scheme, but the let constant's type is a PRIMITIVE member
// alias P.Elem (OptSource with Elem = BitString<8>?). The let type P.Elem is a FieldAccess,
// which must be read through the instantiated primitive, or `c == None` folds to false.
// Distinguisher (c = None): Test() returns true on Left, false on Right.
// Expected if sound: Proof Failed.
import 'OptSource.primitive';
import 'a7_letconst.game';

proof:

let:
    OptSource P = OptSource();
    P.Elem c;

assume:

theorem:
    A7LetConst(c);

games:
    A7LetConst(c).Left against A7LetConst(c).Adversary;
    A7LetConst(c).Right against A7LetConst(c).Adversary;
