  }
  proc decaps(dk : KEMPQDecapsKeySpace * KEMTDecapsKeySpace * KEMTEncapsKeySpace, ct : KEMPQCiphertextSpace * KEMTCiphertextSpace) : bs_kdf_nout = {
    var dk_PQ : KEMPQDecapsKeySpace;
    var dk_T : KEMTDecapsKeySpace;
    var ek_T : KEMTEncapsKeySpace;
    var ct_PQ : KEMPQCiphertextSpace;
    var ct_T : KEMTCiphertextSpace;
    var ss_PQ : bs_kem_pq_nss;
    var ss_T : KEMTSharedSecretSpace;
    var _r0 : bs_kem_pq_nss;
    var _r1 : bs_kem_t_nss;
    var _r2 : bs_kem_t_nct;
    var _r3 : bs_kem_t_nek;
    var _r4 : bs_nlabel;
    var kdf_in : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel;
    var _r5 : bs_kdf_nout;
    dk_PQ <- dk.`1;
    dk_T <- dk.`2;
    ek_T <- dk.`3;
    ct_PQ <- ct.`1;
    ct_T <- ct.`2;
    ss_PQ <@ KEM_PQ.decaps(dk_PQ, ct_PQ);
    ss_T <@ KEM_T.decaps(dk_T, ct_T);
    _r0 <@ KEM_PQ.encodesharedsecret(ss_PQ);
    _r1 <@ KEM_T.encodesharedsecret(ss_T);
    _r2 <@ KEM_T.encodeciphertext(ct_T);
    _r3 <@ KEM_T.encodeencapskey(ek_T);
    _r4 <@ L.get();
    kdf_in <- concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_to_bs_kem_pq_nss_kem_t_nct_kem_t_nss (concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss _r0 _r1) _r2) _r3) _r4;
    _r5 <@ H.evaluate(kdf_in);
    return _r5;
  }
}.

section Main.
  (* ===== Reductions ===== *)

  module R_Correct_Real (KEM_PQ : KEM_PQ_c.Scheme, KEM_T : KEM_T_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme, Hybrid : Hybrid_c.Scheme, Challenger : KEM_PQ_c.KEMCorrectnessWithDK_Oracle) = {
    var corr : KEMPQEncapsKeySpace * KEMPQDecapsKeySpace * KEMPQCiphertextSpace * bs_kem_pq_nss * bs_kem_pq_nss
    var t_keys : KEMTEncapsKeySpace * KEMTDecapsKeySpace
    var ctStar : KEMPQCiphertextSpace * KEMTCiphertextSpace
    proc initialize() : (KEMPQEncapsKeySpace * KEMTEncapsKeySpace) * bs_kdf_nout * (KEMPQCiphertextSpace * KEMTCiphertextSpace) = {
      var ek_PQ : KEMPQEncapsKeySpace;
      var ct_PQ : KEMPQCiphertextSpace;
      var ss_PQ_e : bs_kem_pq_nss;
      var ek_T : KEMTEncapsKeySpace;
      var _tup : KEMTSharedSecretSpace * KEMTCiphertextSpace;
      var ss_T : KEMTSharedSecretSpace;
      var ct_T : KEMTCiphertextSpace;
      var _r0 : bs_kem_pq_nss;
      var _r1 : bs_kem_t_nss;
      var _r2 : bs_kem_t_nct;
      var _r3 : bs_kem_t_nek;
      var _r4 : bs_nlabel;
      var kdf_in : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel;
      var ss : bs_kdf_nout;
      corr <@ Challenger.compute();
      t_keys <@ KEM_T.keygen();
      ek_PQ <- corr.`1;
      ct_PQ <- corr.`3;
      ss_PQ_e <- corr.`4;
      ek_T <- t_keys.`1;
      _tup <@ KEM_T.encaps(ek_T);
      ss_T <- _tup.`1;
      ct_T <- _tup.`2;
      _r0 <@ KEM_PQ.encodesharedsecret(ss_PQ_e);
      _r1 <@ KEM_T.encodesharedsecret(ss_T);
      _r2 <@ KEM_T.encodeciphertext(ct_T);
      _r3 <@ KEM_T.encodeencapskey(ek_T);
      _r4 <@ L.get();
      kdf_in <- concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_to_bs_kem_pq_nss_kem_t_nct_kem_t_nss (concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss _r0 _r1) _r2) _r3) _r4;
      ss <@ H.evaluate(kdf_in);
      ctStar <- (ct_PQ, ct_T);
      return ((ek_PQ, ek_T), ss, ctStar);
    }
    proc decaps(ct : KEMPQCiphertextSpace * KEMTCiphertextSpace) : bs_kdf_nout option = {
      var _r5 : bs_kdf_nout option;
      var ct_PQ : KEMPQCiphertextSpace;
      var ct_T : KEMTCiphertextSpace;
      var dec_ss_T : KEMTSharedSecretSpace;
      var kdf_in : bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel;
      var _r6 : bs_kem_pq_nss;
      var _r7 : bs_kem_t_nss;
      var _r8 : bs_kem_t_nct;
      var _r9 : bs_kem_t_nek;
      var _r10 : bs_nlabel;
      var _r11 : bs_kdf_nout;
      var dec_ss_PQ : bs_kem_pq_nss;
      var _r0 : bs_kem_pq_nss;
      var _r1 : bs_kem_t_nss;
      var _r2 : bs_kem_t_nct;
      var _r3 : bs_kem_t_nek;
      var _r4 : bs_nlabel;
      var _r12 : bs_kdf_nout;
      if (ct = ctStar) {
        _r5 <- None;
      } else {
        ct_PQ <- ct.`1;
        ct_T <- ct.`2;
        dec_ss_T <@ KEM_T.decaps(t_keys.`2, ct_T);
        if (ct_PQ = corr.`3) {
          _r6 <@ KEM_PQ.encodesharedsecret(corr.`5);
          _r7 <@ KEM_T.encodesharedsecret(dec_ss_T);
          _r8 <@ KEM_T.encodeciphertext(ct_T);
          _r9 <@ KEM_T.encodeencapskey(t_keys.`1);
          _r10 <@ L.get();
          kdf_in <- concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_to_bs_kem_pq_nss_kem_t_nct_kem_t_nss (concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss _r6 _r7) _r8) _r9) _r10;
          _r11 <@ H.evaluate(kdf_in);
          _r5 <- Some (_r11);
        } else {
          dec_ss_PQ <@ KEM_PQ.decaps(corr.`2, ct_PQ);
          _r0 <@ KEM_PQ.encodesharedsecret(dec_ss_PQ);
          _r1 <@ KEM_T.encodesharedsecret(dec_ss_T);
          _r2 <@ KEM_T.encodeciphertext(ct_T);
          _r3 <@ KEM_T.encodeencapskey(t_keys.`1);
          _r4 <@ L.get();
          kdf_in <- concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_to_bs_kem_pq_nss_kem_t_nct_kem_t_nss (concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss _r0 _r1) _r2) _r3) _r4;
          _r12 <@ H.evaluate(kdf_in);
          _r5 <- Some (_r12);
        }
      }
      return _r5;
    }
  }.

