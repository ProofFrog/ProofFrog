  op dfun_bs_lambda1_t_bs_in_t_to_bs_out_t : (bs_lambda1_t * bs_in_t -> bs_out_t) distr.

  axiom dfun_bs_lambda1_t_bs_in_t_to_bs_out_t_ll : is_lossless dfun_bs_lambda1_t_bs_in_t_to_bs_out_t.

  axiom dfun_bs_lambda1_t_bs_in_t_to_bs_out_t_fu : is_funiform dfun_bs_lambda1_t_bs_in_t_to_bs_out_t.

  axiom dfun_bs_lambda1_t_bs_in_t_to_bs_out_t_full : is_full dfun_bs_lambda1_t_bs_in_t_to_bs_out_t.

  module type Scheme = {
    proc evaluate(key1 : bs_lambda1_t, key2 : bs_lambda2_t, input : bs_in_t) : bs_out_t
  }.

  op ev_evaluate : bs_lambda1_t -> bs_lambda2_t -> bs_in_t -> bs_out_t.

  module type TwoKeyPRFSecondKeySecurity_Oracle = {
    proc initialize() : unit
    proc lookup(key1 : bs_lambda1_t, x : bs_in_t) : bs_out_t
  }.

  module TwoKeyPRFSecondKeySecurity_Real (F : Scheme) : TwoKeyPRFSecondKeySecurity_Oracle = {
    var k : bs_lambda2_t
    proc initialize() : unit = {
      k <$ dbs_lambda2_t;
    }
    proc lookup(key1 : bs_lambda1_t, x : bs_in_t) : bs_out_t = {
      var _r0 : bs_out_t;
      _r0 <@ F.evaluate(key1, k, x);
      return _r0;
    }
  }.

  module TwoKeyPRFSecondKeySecurity_Random (F : Scheme) : TwoKeyPRFSecondKeySecurity_Oracle = {
    var rF : bs_lambda1_t * bs_in_t -> bs_out_t
    proc initialize() : unit = {
      rF <$ dfun_bs_lambda1_t_bs_in_t_to_bs_out_t;
    }
    proc lookup(key1 : bs_lambda1_t, x : bs_in_t) : bs_out_t = {
      return rF (key1, x);
    }
  }.

  module type TwoKeyPRFSecondKeySecurity_Adv (O : TwoKeyPRFSecondKeySecurity_Oracle) = {
    proc distinguish() : bool {O.lookup}
  }.

  module Game_TwoKeyPRFSecondKeySecurity_Real (Em : Scheme, A : TwoKeyPRFSecondKeySecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      TwoKeyPRFSecondKeySecurity_Real(Em).initialize();
      b <@ A(TwoKeyPRFSecondKeySecurity_Real(Em)).distinguish();
      return b;
    }
  }.

  module Game_TwoKeyPRFSecondKeySecurity_Random (Em : Scheme, A : TwoKeyPRFSecondKeySecurity_Adv) = {
    proc main() : bool = {
      var b : bool;
      TwoKeyPRFSecondKeySecurity_Random(Em).initialize();
      b <@ A(TwoKeyPRFSecondKeySecurity_Random(Em)).distinguish();
      return b;
    }
  }.

  op eps_TwoKeyPRFSecondKeySecurity : real.

  axiom eps_TwoKeyPRFSecondKeySecurity_pos : 0%r <= eps_TwoKeyPRFSecondKeySecurity.

  axiom TwoKeyPRFSecondKeySecurity_advantage (Em <: Scheme) (A <: TwoKeyPRFSecondKeySecurity_Adv) &m :
    `| Pr[Game_TwoKeyPRFSecondKeySecurity_Real(Em, A).main() @ &m : res] - Pr[Game_TwoKeyPRFSecondKeySecurity_Random(Em, A).main() @ &m : res] | <= eps_TwoKeyPRFSecondKeySecurity.
end TwoKeyPRF_Theory.

(* ===== Theory instantiation ===== *)

clone KEM_Theory as KEM1_c with
  type sharedsecret <- SS1Space,
  type ciphertext <- CT1Space,
  type publickey <- PK1Space,
  type secretkey <- SK1Space,
  op dsharedsecret <- dSS1Space.

clone KEM_Theory as KEM2_c with
  type sharedsecret <- SS2Space,
  type ciphertext <- CT2Space,
  type publickey <- PK2Space,
  type secretkey <- SK2Space,
  op dsharedsecret <- dSS2Space.

clone TwoKeyPRF_Theory as F_c with
  type bs_lambda1_t <- bs_ss1len,
  type bs_lambda2_t <- bs_ss2len,
  type bs_in_t <- bs_ct1len_ct2len_pk1len_pk2len,
  type bs_out_t <- bs_outlen,
  op dbs_lambda2_t <- dbs_ss2len.

clone KEM_Theory as KC_c with
  type sharedsecret <- bs_outlen,
  type ciphertext <- CT1Space * CT2Space,
  type publickey <- PK1Space * PK2Space,
  type secretkey <- SK1Space * SK2Space * PK1Space * PK2Space,
  op dsharedsecret <- dbs_outlen.

(* ===== Per-clone distribution axioms ===== *)

lemma KEM1_dSS1Space_funi :
  is_funiform dSS1Space.
proof.
  exact dSS1Space_fu.
qed.

lemma KEM1_dSS1Space_ll :
  is_lossless dSS1Space.
proof.
  exact dSS1Space_ll.
qed.

lemma KEM2_dSS2Space_funi :
  is_funiform dSS2Space.
proof.
  exact dSS2Space_fu.
qed.

lemma KEM2_dSS2Space_ll :
  is_lossless dSS2Space.
proof.
  exact dSS2Space_ll.
qed.

lemma F_dbs_ss2len_funi :
  is_funiform dbs_ss2len.
proof.
  exact dbs_ss2len_fu.
qed.

lemma F_dbs_ss2len_ll :
  is_lossless dbs_ss2len.
proof.
  exact dbs_ss2len_ll.
qed.

lemma KC_dbs_outlen_funi :
  is_funiform dbs_outlen.
proof.
  exact dbs_outlen_fu.
qed.

lemma KC_dbs_outlen_ll :
  is_lossless dbs_outlen.
proof.
  exact dbs_outlen_ll.
qed.

(* NOTE: the FrogLang scheme has `requires` clauses that are not enforced by the EC export. The scheme module below may fail EC type-checking because cross-clone type equalities implied by the `requires` are not expressed in the clones. Deferred to Phase 5D. *)

(* ===== Concrete scheme implementation ===== *)

module KEMCombiner (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : KC_c.Scheme = {
  proc keygen() : (PK1Space * PK2Space) * (SK1Space * SK2Space * PK1Space * PK2Space) = {
    var k1 : PK1Space * SK1Space;
    var k2 : PK2Space * SK2Space;
    k1 <@ KEM1.keygen();
    k2 <@ KEM2.keygen();
    return ((k1.`1, k2.`1), (k1.`2, k2.`2, k1.`1, k2.`1));
  }
  proc encaps(pk : PK1Space * PK2Space) : bs_outlen * (CT1Space * CT2Space) = {
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var _tup : SS1Space * CT1Space;
    var ss1 : SS1Space;
    var ct1 : CT1Space;
    var _tup_0 : SS2Space * CT2Space;
    var ss2 : SS2Space;
    var ct2 : CT2Space;
    var bpk1 : bs_pk1len;
    var bct1 : bs_ct1len;
    var bpk2 : bs_pk2len;
    var bct2 : bs_ct2len;
    var label : bs_ct1len_ct2len_pk1len_pk2len;
    var ss : bs_outlen;
    pk1 <- pk.`1;
    pk2 <- pk.`2;
    _tup <@ KEM1.encaps(pk1);
    ss1 <- _tup.`1;
    ct1 <- _tup.`2;
    _tup_0 <@ KEM2.encaps(pk2);
    ss2 <- _tup_0.`1;
    ct2 <- _tup_0.`2;
    bpk1 <- pk1;
    bct1 <- ct1;
    bpk2 <- pk2;
    bct2 <- ct2;
    label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
    ss <@ F.evaluate(ss1, ss2, label);
    return (ss, (ct1, ct2));
  }
  proc decaps(sk : SK1Space * SK2Space * PK1Space * PK2Space, c : CT1Space * CT2Space) : bs_outlen = {
    var sk1 : SK1Space;
    var sk2 : SK2Space;
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var ct1 : CT1Space;
    var ct2 : CT2Space;
    var ss1 : SS1Space;
    var ss2 : SS2Space;
    var bpk1 : bs_pk1len;
    var bct1 : bs_ct1len;
    var bpk2 : bs_pk2len;
    var bct2 : bs_ct2len;
    var label : bs_ct1len_ct2len_pk1len_pk2len;
    var _r0 : bs_outlen;
    sk1 <- sk.`1;
    sk2 <- sk.`2;
    pk1 <- sk.`3;
    pk2 <- sk.`4;
    ct1 <- c.`1;
    ct2 <- c.`2;
    ss1 <@ KEM1.decaps(sk1, ct1);
    ss2 <@ KEM2.decaps(sk2, ct2);
    bpk1 <- pk1;
    bct1 <- ct1;
    bpk2 <- pk2;
    bct2 <- ct2;
    label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
    _r0 <@ F.evaluate(ss1, ss2, label);
    return _r0;
  }
}.

section Main.
  (* ===== Reductions ===== *)

  module R_Correct_L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : KEM2_c.KEMCorrectness_Oracle) = {
    var ss2d : SS2Space
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk1 : PK1Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var _tup_1 : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var _tup_2 : CT2Space * SS2Space * SS2Space;
      var ss2e : SS2Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk1 <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ KEM1.encaps(pk1);
      ss1 <- _tup_1.`1;
      ct1Star <- _tup_1.`2;
      _tup_2 <@ Challenger.compute(pk2, sk2);
      ct2Star <- _tup_2.`1;
      ss2e <- _tup_2.`2;
      ss2d <- _tup_2.`3;
      bpk1 <- pk1;
      bct1 <- ct1Star;
      bpk2 <- pk2;
      bct2 <- ct2Star;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      ss <@ F.evaluate(ss1, ss2e, label);
      return ((pk1, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bpk1 <- pk1;
        bct1 <- ct1;
        bpk2 <- pk2;
        bct2 <- ct2;
        label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
        if (ct2 = ct2Star) {
          _r1 <@ F.evaluate(ss1, ss2d, label);
          _r0 <- Some (_r1);
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

  module R_Correct_R (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : KEM2_c.KEMCorrectness_Oracle) = {
    var ss2d : SS2Space
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk1 : PK1Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var rsp1 : SS1Space * CT1Space;
      var corr : CT2Space * SS2Space * SS2Space;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk1 <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      rsp1 <@ KEM1.encaps(pk1);
      ct1Star <- rsp1.`2;
      corr <@ Challenger.compute(pk2, sk2);
      ct2Star <- corr.`1;
      ss2d <- corr.`3;
      ss <$ dbs_outlen;
      return ((pk1, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bpk1 <- pk1;
        bct1 <- ct1;
        bpk2 <- pk2;
        bct2 <- ct2;
        label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
        if (ct2 = ct2Star) {
          _r1 <@ F.evaluate(ss1, ss2d, label);
          _r0 <- Some (_r1);
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

  module R_KEM2_L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : KEM2_c.KEM_INDCCA_MultiChal_Oracle) = {
    var ss2Star : SS2Space
    var sk1 : SK1Space
    var pk1 : PK1Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var _tup_0 : PK2Space * SS2Space * CT2Space;
      var _tup_1 : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var ss : bs_outlen;
      _tup <@ KEM1.keygen();
      pk1 <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ Challenger.initialize();
      pk2 <- _tup_0.`1;
      ss2Star <- _tup_0.`2;
      ct2Star <- _tup_0.`3;
      _tup_1 <@ KEM1.encaps(pk1);
      ss1 <- _tup_1.`1;
      ct1Star <- _tup_1.`2;
      bpk1 <- pk1;
      bct1 <- ct1Star;
      bpk2 <- pk2;
      bct2 <- ct2Star;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      ss <@ F.evaluate(ss1, ss2Star, label);
      return ((pk1, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var _r1 : bs_outlen;
      var ss2_opt : SS2Space option;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bpk1 <- pk1;
        bct1 <- ct1;
        bpk2 <- pk2;
        bct2 <- ct2;
        label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
        if (ct2 = ct2Star) {
          _r1 <@ F.evaluate(ss1, ss2Star, label);
          _r0 <- Some (_r1);
        } else {
          ss2_opt <@ Challenger.decaps(ct2);
          if (false) {
            _r0 <- None;
          } else {
            _r2 <@ F.evaluate(ss1, oget (ss2_opt), label);
            _r0 <- Some (_r2);
          }
        }
      }
      return _r0;
    }
  }.

  module R_PRF_L (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : F_c.TwoKeyPRFSecondKeySecurity_Oracle) = {
    var sk1 : SK1Space
    var sk2 : SK2Space
    var pk1 : PK1Space
    var pk2 : PK2Space
    var ct1Star : CT1Space
    var ct2Star : CT2Space
    proc initialize() : (PK1Space * PK2Space) * bs_outlen * (CT1Space * CT2Space) = {
      var _tup : PK1Space * SK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var _tup_1 : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var rsp2 : SS2Space * CT2Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var ss : bs_outlen;
      Challenger.initialize();
      _tup <@ KEM1.keygen();
      pk1 <- _tup.`1;
      sk1 <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ KEM1.encaps(pk1);
      ss1 <- _tup_1.`1;
      ct1Star <- _tup_1.`2;
      rsp2 <@ KEM2.encaps(pk2);
      ct2Star <- rsp2.`2;
      bpk1 <- pk1;
      bct1 <- ct1Star;
      bpk2 <- pk2;
      bct2 <- ct2Star;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      ss <@ Challenger.lookup(ss1, label);
      return ((pk1, pk2), ss, (ct1Star, ct2Star));
    }
    proc decaps(c : CT1Space * CT2Space) : bs_outlen option = {
      var _r0 : bs_outlen option;
      var ct1 : CT1Space;
      var ct2 : CT2Space;
      var ss1 : SS1Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var _r1 : bs_outlen;
      var ss2 : SS2Space;
      var _r2 : bs_outlen;
      if (c = (ct1Star, ct2Star)) {
        _r0 <- None;
      } else {
        ct1 <- c.`1;
        ct2 <- c.`2;
        ss1 <@ KEM1.decaps(sk1, ct1);
        bpk1 <- pk1;
        bct1 <- ct1;
        bpk2 <- pk2;
        bct2 <- ct2;
        label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
        if (ct2 = ct2Star) {
          _r1 <@ Challenger.lookup(ss1, label);
          _r0 <- Some (_r1);
        } else {
          ss2 <@ KEM2.decaps(sk2, ct2);
          _r2 <@ F.evaluate(ss1, ss2, label);
          _r0 <- Some (_r2);
        }
      }
      return _r0;
    }
  }.

  module R_KEM2_R (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : KEM2_c.KEM_INDCCA_MultiChal_Oracle) = {
