  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: KC_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS2, -G_StoredSS2_R, -KC_c.KEM_INDCCA_MultiChal_Random, -KC_c.KEM_INDCCA_MultiChal_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM2_L, -R_KEM2_R, -R_PRF_L, -R_PRF_R}) &m :
    Pr[Game_step_0(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F}).
    + conseq hop_0_decaps.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEMCorrectness_advantage axiom applied to R_Correct_L_Adv. *)

  lemma hop_1_pr (A <: KC_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS2, -G_StoredSS2_R, -KC_c.KEM_INDCCA_MultiChal_Random, -KC_c.KEM_INDCCA_MultiChal_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM2_L, -R_KEM2_R, -R_PRF_L, -R_PRF_R}) &m :
    `| Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEMCorrectness.
  proof.
    have hL : Pr[Game_step_1(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromDecaps(KEM2, R_Correct_L_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res]
            = Pr[KEM2_c.Game_KEMCorrectness_FromEncaps(KEM2, R_Correct_L_Adv(KEM1, KEM2, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (KEM2_c.KEMCorrectness_advantage KEM2 (R_Correct_L_Adv(KEM1, KEM2, F, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: KC_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS2, -G_StoredSS2_R, -KC_c.KEM_INDCCA_MultiChal_Random, -KC_c.KEM_INDCCA_MultiChal_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM2_L, -R_KEM2_R, -R_PRF_L, -R_PRF_R}) &m :
    Pr[Game_step_2(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2.sk1{2} = R_Correct_L.sk1{1} /\ G_StoredSS2.sk2{2} = R_Correct_L.sk2{1} /\ G_StoredSS2.pk1{2} = R_Correct_L.pk1{1} /\ G_StoredSS2.pk2{2} = R_Correct_L.pk2{1} /\ G_StoredSS2.ct1Star{2} = R_Correct_L.ct1Star{1} /\ G_StoredSS2.ct2Star{2} = R_Correct_L.ct2Star{1} /\ R_Correct_L._tup_2{1}.`3 = R_Correct_L._tup_2{1}.`2).
    + conseq hop_2_decaps.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_3_pr (A <: KC_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS2, -G_StoredSS2_R, -KC_c.KEM_INDCCA_MultiChal_Random, -KC_c.KEM_INDCCA_MultiChal_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM2_L, -R_KEM2_R, -R_PRF_L, -R_PRF_R}) &m :
    Pr[Game_step_3(KEM1, KEM2, F, A).main() @ &m : res] = Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM1, glob KEM2, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM1} /\ ={glob KEM2} /\ ={glob F} /\ G_StoredSS2.ss2Star{1} = R_KEM2_L.ss2Star{2} /\ G_StoredSS2.sk1{1} = R_KEM2_L.sk1{2} /\ G_StoredSS2.pk1{1} = R_KEM2_L.pk1{2} /\ G_StoredSS2.pk2{1} = R_KEM2_L.pk2{2} /\ G_StoredSS2.ct1Star{1} = R_KEM2_L.ct1Star{2} /\ G_StoredSS2.ct2Star{1} = R_KEM2_L.ct2Star{2} /\ R_KEM2_L.ct2Star{2} = KEM2_c.KEM_INDCCA_MultiChal_Real.ctStar{2}).
    + conseq hop_3_decaps.
    call hop_3_initialize.
    auto.
    qed.

  (* Hop 4: assumption hop. Bounded by the KEM_INDCCA_MultiChal_advantage axiom applied to R_KEM2_L_Adv. *)

  lemma hop_4_pr (A <: KC_c.KEM_INDCCA_MultiChal_Adv {-KEM1, -KEM2, -F, -F_c.TwoKeyPRFSecondKeySecurity_Random, -F_c.TwoKeyPRFSecondKeySecurity_Real, -G_RandKey, -G_RandKey_R, -G_StoredSS2, -G_StoredSS2_R, -KC_c.KEM_INDCCA_MultiChal_Random, -KC_c.KEM_INDCCA_MultiChal_Real, -KEM2_c.KEM_INDCCA_MultiChal_Random, -KEM2_c.KEM_INDCCA_MultiChal_Real, -R_Correct_L, -R_Correct_R, -R_KEM2_L, -R_KEM2_R, -R_PRF_L, -R_PRF_R}) &m :
    `| Pr[Game_step_4(KEM1, KEM2, F, A).main() @ &m : res] - Pr[Game_step_5(KEM1, KEM2, F, A).main() @ &m : res] | <= KEM2_c.eps_KEM_INDCCA_MultiChal.
  proof.
