// Target: Dead Null Guard Elimination (released else-less guard path), F-416 fix, gap1 item D.
// Hypothesis: as member_alias_scheme, the let constant c has the FieldAccess type C.Elem, and
// C.Elem stands for BitString<8>?. Unless the pass reads the member alias, the guard
// `if (c == None) { count = count + 1; }` is removed as dead.
// Distinguisher (c = None): Hit(); Get() returns 1 on Left, 0 on Right.
// Expected if sound: Proof Failed.
import 'Checker.primitive';
import 'OptCheck.scheme';
import 'a7g_guard.game';

proof:

let:
    OptCheck C = OptCheck();
    C.Elem c;

assume:

theorem:
    A7GGuard(c);

games:
    A7GGuard(c).Left against A7GGuard(c).Adversary;
    A7GGuard(c).Right against A7GGuard(c).Adversary;
