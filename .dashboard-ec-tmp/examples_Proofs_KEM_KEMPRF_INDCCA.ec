  declare module K <: K_c.Scheme {-G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}.

  declare module F <: F_c.Scheme {-K, -G_RandKey, -KF_c.KEM_INDCCA_MultiChal_Random, -KF_c.KEM_INDCCA_MultiChal_Real, -K_c.KEM_INDCCA_MultiChal_Random, -K_c.KEM_INDCCA_MultiChal_Real, -R_KEM, -R_MultiPRF}.

  (* ===== Deterministic-method specs ===== *)

  declare axiom K_decaps_det (g : (glob K)) (a0 : SKeySpace) (a1 : CiphertextSpace) : phoare[ K.decaps : (glob K) = g /\ sk = a0 /\ m = a1 ==> (glob K) = g /\ res = K_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom F_evaluate_det (g : (glob F)) (a0 : bs_lambda) (a1 : bs_in) : phoare[ F.evaluate : (glob F) = g /\ seed = a0 /\ input = a1 ==> (glob F) = g /\ res = F_c.ev_evaluate a0 a1 ] = 1%r.

  (* ===== Glob-preservation specs (dead-call drop) ===== *)

  declare axiom F_evaluate_pres (g : (glob F)) : phoare[ F.evaluate : (glob F) = g ==> (glob F) = g ] = 1%r.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0_initialize :
    equiv [ KF_c.KEM_INDCCA_MultiChal_Real(KEMPRF(K, F)).initialize ~ R_KEM(K, F, KEMPRF(K, F), K_c.KEM_INDCCA_MultiChal_Real(K)).initialize :
            ={glob K} /\ ={glob F} ==> ={res} /\ ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCCA_MultiChal_Real.ctStar{1} = R_KEM.ctStar{2} /\ R_KEM.ctStar{2} = K_c.KEM_INDCCA_MultiChal_Real.ctStar{2} /\ KF_c.KEM_INDCCA_MultiChal_Real.sk{1} = K_c.KEM_INDCCA_MultiChal_Real.sk{2} ].
  proof.
    (* resolution: synth-param *)
    proc.
    inline *.
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

  lemma hop_0_decaps :
    equiv [ KF_c.KEM_INDCCA_MultiChal_Real(KEMPRF(K, F)).decaps ~ R_KEM(K, F, KEMPRF(K, F), K_c.KEM_INDCCA_MultiChal_Real(K)).decaps :
            ={c} /\ ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCCA_MultiChal_Real.ctStar{1} = R_KEM.ctStar{2} /\ R_KEM.ctStar{2} = K_c.KEM_INDCCA_MultiChal_Real.ctStar{2} /\ KF_c.KEM_INDCCA_MultiChal_Real.sk{1} = K_c.KEM_INDCCA_MultiChal_Real.sk{2} ==> ={res} /\ ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCCA_MultiChal_Real.ctStar{1} = R_KEM.ctStar{2} /\ R_KEM.ctStar{2} = K_c.KEM_INDCCA_MultiChal_Real.ctStar{2} /\ KF_c.KEM_INDCCA_MultiChal_Real.sk{1} = K_c.KEM_INDCCA_MultiChal_Real.sk{2} ].
  proof.
    (* resolution: admit-guided *)
    (* multi-oracle hop 0, oracle 'decaps': post-init
       body transformed along the chain; not closed by proc; sim / reorder.
       VALIDATED fill template (det-axiom finisher; KEMPRF hop_0_challenge
       compiles EC EXIT 0). Fill <...> with this hop's EC inline names:
         proc. inline *. sp. wp.
         seq 1 1 : (={glob K, glob F} /\ <encapsResL>{1} = <encapsResR>{2}
                    /\ <live-state coupling>).
         + sim.                          (* relate the abstract encaps calls *)
         sp. wp.
         exists* (glob F){1}, <FseedL>{1}, <FinputL>{1}; elim* => gf1 a0 a1.
         call{1} (F_evaluate_det gf1 a0 a1).
         exists* (glob F){2}, <FseedR>{2}, <FinputR>{2}; elim* => gf2 b0 b1.
         call{2} (F_evaluate_det gf2 b0 b1).
         skip => /#.
       A reusable name-independent helper for the F.evaluate step (derive
       once per primitive from F_evaluate_det; lets 'wp. call F_evaluate_equiv'
       replace the two exists*/call blocks):
         lemma F_evaluate_equiv : equiv[ F.evaluate ~ F.evaluate :
           ={glob F, seed, input} ==> ={res, glob F} ].
         proof. proc*; exists* (glob F){1}, seed{1}, input{1}; elim* => g s i;
           call{1} (F_evaluate_det g s i); call{2} (F_evaluate_det g s i);
           skip => /#. qed.
       Per-shape variants (the body transform differs by hop):
       - distribution swap (e.g. dsharedsecret <-> dbs_lambda under the
         requires-equality alias): couple the two uniform samples with rnd,
         discharging the distribution equality from is_funiform + is_full;
       - sample/encaps order swap: swap{i} to align, then the det finisher;
       - dead F.evaluate: call{i} (F_evaluate_det ...) to drop it, then sim. *)
    admit.
    qed.

