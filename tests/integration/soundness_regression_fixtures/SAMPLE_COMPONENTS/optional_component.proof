// A draw of [BitString<n>?, BitString<n>] draws an optional component: ill-formed.
import 'Pairs.primitive';
import 'OptionalPairs.scheme';
import 'DrawPair.game';

proof:

let:
    Int n;
    Pairs E = OptionalPairs(n);

assume:

theorem:
    DrawPair(E);

games:
    DrawPair(E).Left against DrawPair(E).Adversary;
    DrawPair(E).Right against DrawPair(E).Adversary;
