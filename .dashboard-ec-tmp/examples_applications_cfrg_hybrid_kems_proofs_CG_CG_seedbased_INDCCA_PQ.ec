      var _r9 : NGElementSpace;
      var _r10 : NGElementSpace;
      var _r11 : bs_ng_nelem;
      var _r12 : bs_nlabel;
      var _r13 : bs_kdf_nout;
      var dec_ss_PQ : bs_kem_pq_nss;
      var _r1 : bs_kem_pq_nss;
      var _r2 : bs_ng_nelem;
      var _r3 : NGElementSpace;
      var _r4 : NGElementSpace;
      var _r5 : bs_ng_nelem;
      var _r6 : bs_nlabel;
      var kdf_in : bs_kem_pq_nss_2_ng_nelem_ng_nss_nlabel;
      var _r14 : bs_kdf_nout;
