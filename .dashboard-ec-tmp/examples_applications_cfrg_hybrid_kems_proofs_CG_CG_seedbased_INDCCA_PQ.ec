  (* Hop 21: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_21_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    Pr[Game_step_21(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_22(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L}).
    + conseq hop_21_decaps.
    call hop_21_initialize.
    auto.
    qed.

  (* Hop 22: assumption hop. Bounded by the PRGSec_advantage axiom applied to R_PRG_R_Adv. *)

  lemma hop_22_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    `| Pr[Game_step_22(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_23(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= G_c.eps_PRGSec.
  proof.
    have hL : Pr[Game_step_22(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSec_Random(G, R_PRG_R_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_23(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[G_c.Game_PRGSec_Real(G, R_PRG_R_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    have H := G_c.PRGSec_advantage G (R_PRG_R_Adv(KEM_PQ, NG, G, H, L, A)) &m.
    smt().
    qed.

  (* Hop 23: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_23_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    Pr[Game_step_23(KEM_PQ, NG, G, H, L, A).main() @ &m : res] = Pr[Game_step_24(KEM_PQ, NG, G, H, L, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //.
    proc.
    call (_: ={glob KEM_PQ} /\ ={glob NG} /\ ={glob G} /\ ={glob H} /\ ={glob L} /\ Hybrid_c.KEM_INDCCA_Random.ctStar{2} = R_PRG_R.ctStar{1}).
    + conseq hop_23_decaps.
    call hop_23_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real, -R_KG_L, -R_KG_R, -R_PRG_L, -R_PRG_R}) &m :
    `| Pr[Game_step_0(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_24(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= G_c.eps_PRGSec + KEM_PQ_c.eps_KeyGenEquiv + KEM_PQ_c.eps_KEMCorrectnessWithDK + KEM_PQ_c.eps_KEM_INDCCA + H_c.eps_KDFPRFSec + H_c.eps_KDFPRFSec + KEM_PQ_c.eps_KEM_INDCCA + KEM_PQ_c.eps_KEMCorrectnessWithDK + KEM_PQ_c.eps_KeyGenEquiv + G_c.eps_PRGSec.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    have h6 := hop_6_pr A &m.
    have h7 := hop_7_pr A &m.
    have h8 := hop_8_pr A &m.
    have h9 := hop_9_pr A &m.
    have h10 := hop_10_pr A &m.
    have h11 := hop_11_pr A &m.
    have h12 := hop_12_pr A &m.
    have h13 := hop_13_pr A &m.
    have h14 := hop_14_pr A &m.
    have h15 := hop_15_pr A &m.
    have h16 := hop_16_pr A &m.
    have h17 := hop_17_pr A &m.
    have h18 := hop_18_pr A &m.
    have h19 := hop_19_pr A &m.
    have h20 := hop_20_pr A &m.
    have h21 := hop_21_pr A &m.
    have h22 := hop_22_pr A &m.
    have h23 := hop_23_pr A &m.
    smt(G_c.eps_PRGSec_pos H_c.eps_KDFPRFSec_pos KEM_PQ_c.eps_KEMCorrectnessWithDK_pos KEM_PQ_c.eps_KEM_INDCCA_pos KEM_PQ_c.eps_KeyGenEquiv_pos).
    qed.
end section Main.
