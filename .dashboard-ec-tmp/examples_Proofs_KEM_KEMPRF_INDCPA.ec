  declare module K <: K_c.Scheme {-G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}.

  declare module F <: F_c.Scheme {-K, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}.

  (* ===== Deterministic-method specs ===== *)

  declare axiom K_decaps_det (g : (glob K)) (a0 : SKeySpace) (a1 : CiphertextSpace) : phoare[ K.decaps : (glob K) = g /\ sk = a0 /\ m = a1 ==> (glob K) = g /\ res = K_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom F_evaluate_det (g : (glob F)) (a0 : bs_lambda) (a1 : bs_in) : phoare[ F.evaluate : (glob F) = g /\ seed = a0 /\ input = a1 ==> (glob F) = g /\ res = F_c.ev_evaluate a0 a1 ] = 1%r.

  (* ===== Per-hop equivalence lemmas ===== *)

  lemma hop_0_initialize :
    equiv [ KF_c.KEM_INDCPA_MultiChal_Real(KEMPRF(K, F)).initialize ~ R_KEM(K, F, KEMPRF(K, F), K_c.KEM_INDCPA_MultiChal_Real(K)).initialize :
            ={glob K} /\ ={glob F} ==> ={res} /\ ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCPA_MultiChal_Real.pk{1} = K_c.KEM_INDCPA_MultiChal_Real.pk{2} ].
  proof.
    (* resolution: synth-static *)
    proc; inline *; sim.
    qed.

  lemma hop_0_challenge :
    equiv [ KF_c.KEM_INDCPA_MultiChal_Real(KEMPRF(K, F)).challenge ~ R_KEM(K, F, KEMPRF(K, F), K_c.KEM_INDCPA_MultiChal_Real(K)).challenge :
            ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCPA_MultiChal_Real.pk{1} = K_c.KEM_INDCPA_MultiChal_Real.pk{2} ==> ={res} /\ ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCPA_MultiChal_Real.pk{1} = K_c.KEM_INDCPA_MultiChal_Real.pk{2} ].
  proof.
    (* resolution: cached-guided *)
    proc. inline *. sp. wp.
    seq 1 1 : (={glob K, glob F} /\ x{1} = _tup0{2} /\ KF_c.KEM_INDCPA_MultiChal_Real.pk{1} = K_c.KEM_INDCPA_MultiChal_Real.pk{2}).
    + sim.
    sp. wp.
    exists* (glob F){1}, k{1}, c{1}; elim* => gf1 kv cv.
    call{1} (F_evaluate_det gf1 kv cv).
    exists* (glob F){2}, ss{2}, ct{2}; elim* => gf2 ssv ctv.
    call{2} (F_evaluate_det gf2 ssv ctv).
    skip => /#.
    qed.

  lemma hop_2_initialize :
    equiv [ R_KEM(K, F, KEMPRF(K, F), K_c.KEM_INDCPA_MultiChal_Random(K)).initialize ~ G_RandKey(K, F).initialize :
            ={glob K} /\ ={glob F} ==> ={res} /\ ={glob K} /\ ={glob F} /\ K_c.KEM_INDCPA_MultiChal_Random.pk{1} = G_RandKey.pk{2} ].
  proof.
    (* resolution: synth-static *)
    proc; inline *; sim.
    qed.

  lemma hop_2_challenge :
    equiv [ R_KEM(K, F, KEMPRF(K, F), K_c.KEM_INDCPA_MultiChal_Random(K)).challenge ~ G_RandKey(K, F).challenge :
            ={glob K} /\ ={glob F} /\ K_c.KEM_INDCPA_MultiChal_Random.pk{1} = G_RandKey.pk{2} ==> ={res} /\ ={glob K} /\ ={glob F} /\ K_c.KEM_INDCPA_MultiChal_Random.pk{1} = G_RandKey.pk{2} ].
  proof.
    (* resolution: cached-guided *)
    proc. inline *.
    have eqd : dSharedSecretSpace = dbs_lambda
      by apply eq_funi_ll; [ apply dSharedSecretSpace_fu | apply dSharedSecretSpace_ll
                           | apply dbs_lambda_fu | apply dbs_lambda_ll ].
    swap{2} 1 1.
    seq 1 1 : (={glob K, glob F} /\ rsp{1} = rsp{2} /\ K_c.KEM_INDCPA_MultiChal_Random.pk{1} = G_RandKey.pk{2}).
    + sim.
    seq 1 1 : (={glob K, glob F} /\ rsp{1} = rsp{2} /\ ss0{1} = key{2} /\ K_c.KEM_INDCPA_MultiChal_Random.pk{1} = G_RandKey.pk{2}).
    + rnd (fun (x : SharedSecretSpace) => x) (fun (x : SharedSecretSpace) => x).
      skip => />. rewrite eqd. done.
    sp. wp.
    exists* (glob F){1}, ss{1}, ct{1}; elim* => gf1 a0 a1.
    call{1} (F_evaluate_det gf1 a0 a1).
    exists* (glob F){2}, key{2}, ct{2}; elim* => gf2 b0 b1.
    call{2} (F_evaluate_det gf2 b0 b1).
    skip => /#.
    qed.

  lemma hop_3_initialize :
    equiv [ G_RandKey(K, F).initialize ~ R_MultiPRF(K, F, KEMPRF(K, F), F_c.PRFSecurity_MultiKey_Real(F)).initialize :
            ={glob K} /\ ={glob F} ==> ={res} /\ ={glob K} /\ ={glob F} /\ G_RandKey.pk{1} = R_MultiPRF.pk{2} ].
  proof.
    (* resolution: synth-static *)
    proc; inline *; sim.
    qed.

  lemma hop_3_challenge :
    equiv [ G_RandKey(K, F).challenge ~ R_MultiPRF(K, F, KEMPRF(K, F), F_c.PRFSecurity_MultiKey_Real(F)).challenge :
            ={glob K} /\ ={glob F} /\ G_RandKey.pk{1} = R_MultiPRF.pk{2} ==> ={res} /\ ={glob K} /\ ={glob F} /\ G_RandKey.pk{1} = R_MultiPRF.pk{2} ].
  proof.
    (* resolution: cached-guided *)
    proc. inline *.
    swap{1} 1 2.
    seq 1 1 : (={glob K, glob F} /\ rsp{1} = rsp{2} /\ G_RandKey.pk{1} = R_MultiPRF.pk{2}).
    + sim.
    sp. wp.
    seq 1 1 : (={glob K, glob F} /\ rsp{1} = rsp{2} /\ ct{1} = ct{2} /\ x{2} = ct{2} /\ key{1} = k{2} /\ G_RandKey.pk{1} = R_MultiPRF.pk{2}).
    + rnd. skip => />.
    exists* (glob F){1}, key{1}, ct{1}; elim* => gf1 a0 a1.
    call{1} (F_evaluate_det gf1 a0 a1).
    exists* (glob F){2}, k{2}, x{2}; elim* => gf2 b0 b1.
    call{2} (F_evaluate_det gf2 b0 b1).
    skip => /#.
    qed.

  lemma hop_5_initialize :
    equiv [ R_MultiPRF(K, F, KEMPRF(K, F), F_c.PRFSecurity_MultiKey_Random(F)).initialize ~ KF_c.KEM_INDCPA_MultiChal_Random(KEMPRF(K, F)).initialize :
            ={glob K} /\ ={glob F} ==> ={res} /\ ={glob K} /\ ={glob F} /\ R_MultiPRF.pk{1} = KF_c.KEM_INDCPA_MultiChal_Random.pk{2} ].
  proof.
    (* resolution: synth-static *)
    proc; inline *; sim.
    qed.

  lemma hop_5_challenge :
    equiv [ R_MultiPRF(K, F, KEMPRF(K, F), F_c.PRFSecurity_MultiKey_Random(F)).challenge ~ KF_c.KEM_INDCPA_MultiChal_Random(KEMPRF(K, F)).challenge :
            ={glob K} /\ ={glob F} /\ R_MultiPRF.pk{1} = KF_c.KEM_INDCPA_MultiChal_Random.pk{2} ==> ={res} /\ ={glob K} /\ ={glob F} /\ R_MultiPRF.pk{1} = KF_c.KEM_INDCPA_MultiChal_Random.pk{2} ].
  proof.
    (* resolution: cached-guided *)
    proc. inline *.
    sp.
    seq 1 1 : (={glob K, glob F} /\ rsp{1} = x{2} /\ R_MultiPRF.pk{1} = KF_c.KEM_INDCPA_MultiChal_Random.pk{2}).
    + sim.
    sp.
    seq 0 1 : (={glob K, glob F} /\ rsp{1} = x{2} /\ ct{1} = x{2}.`2 /\ c{2} = x{2}.`2 /\ R_MultiPRF.pk{1} = KF_c.KEM_INDCPA_MultiChal_Random.pk{2}).
    + exists* (glob F){2}, k{2}, c{2}; elim* => gf k0 c0.
      call{2} (F_evaluate_det gf k0 c0).
      skip => /#.
    wp. rnd. wp. skip => /#.
    qed.

  (* ===== Per-hop probability lemmas ===== *)

  (* Hop 0: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_0_pr (A <: KF_c.KEM_INDCPA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}) &m :
    Pr[Game_step_0(K, F, A).main() @ &m : res] = Pr[Game_step_1(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ KF_c.KEM_INDCPA_MultiChal_Real.pk{1} = K_c.KEM_INDCPA_MultiChal_Real.pk{2}).
    + conseq hop_0_challenge.
    call hop_0_initialize.
    auto.
    qed.

  (* Hop 1: assumption hop. Bounded by the KEM_INDCPA_MultiChal_advantage axiom applied to R_KEM_Adv. *)

  lemma hop_1_pr (A <: KF_c.KEM_INDCPA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}) &m :
    `| Pr[Game_step_1(K, F, A).main() @ &m : res] - Pr[Game_step_2(K, F, A).main() @ &m : res] | <= K_c.eps_KEM_INDCPA_MultiChal.
  proof.
    have hL : Pr[Game_step_1(K, F, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCPA_MultiChal_Real(K, R_KEM_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_2(K, F, A).main() @ &m : res]
            = Pr[K_c.Game_KEM_INDCPA_MultiChal_Random(K, R_KEM_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (K_c.KEM_INDCPA_MultiChal_advantage K (R_KEM_Adv(K, F, A)) &m).
    qed.

  (* Hop 2: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_2_pr (A <: KF_c.KEM_INDCPA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}) &m :
    Pr[Game_step_2(K, F, A).main() @ &m : res] = Pr[Game_step_3(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ K_c.KEM_INDCPA_MultiChal_Random.pk{1} = G_RandKey.pk{2}).
    + conseq hop_2_challenge.
    call hop_2_initialize.
    auto.
    qed.

  (* Hop 3: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_3_pr (A <: KF_c.KEM_INDCPA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}) &m :
    Pr[Game_step_3(K, F, A).main() @ &m : res] = Pr[Game_step_4(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ G_RandKey.pk{1} = R_MultiPRF.pk{2}).
    + conseq hop_3_challenge.
    call hop_3_initialize.
    auto.
    qed.

  (* Hop 4: assumption hop. Bounded by the PRFSecurity_MultiKey_advantage axiom applied to R_MultiPRF_Adv. *)

  lemma hop_4_pr (A <: KF_c.KEM_INDCPA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}) &m :
    `| Pr[Game_step_4(K, F, A).main() @ &m : res] - Pr[Game_step_5(K, F, A).main() @ &m : res] | <= F_c.eps_PRFSecurity_MultiKey.
  proof.
    have hL : Pr[Game_step_4(K, F, A).main() @ &m : res]
            = Pr[F_c.Game_PRFSecurity_MultiKey_Real(F, R_MultiPRF_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_5(K, F, A).main() @ &m : res]
            = Pr[F_c.Game_PRFSecurity_MultiKey_Random(F, R_MultiPRF_Adv(K, F, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //; proc; inline *; sim.
    rewrite hL hR.
    apply (F_c.PRFSecurity_MultiKey_advantage F (R_MultiPRF_Adv(K, F, A)) &m).
    qed.

  (* Hop 5: interchangeability. The two adjacent games are equivalent (no advantage). *)

  lemma hop_5_pr (A <: KF_c.KEM_INDCPA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}) &m :
    Pr[Game_step_5(K, F, A).main() @ &m : res] = Pr[Game_step_6(K, F, A).main() @ &m : res].
  proof.
    byequiv (_: ={glob A, glob K, glob F} ==> ={res}) => //.
    proc.
    call (_: ={glob K} /\ ={glob F} /\ R_MultiPRF.pk{1} = KF_c.KEM_INDCPA_MultiChal_Random.pk{2}).
    + conseq hop_5_challenge.
    call hop_5_initialize.
    auto.
    qed.

  (* ===== Main theorem ===== *)

  lemma main_theorem (A <: KF_c.KEM_INDCPA_MultiChal_Adv {-K, -F, -G_RandKey, -KF_c.KEM_INDCPA_MultiChal_Random, -KF_c.KEM_INDCPA_MultiChal_Real, -K_c.KEM_INDCPA_MultiChal_Random, -K_c.KEM_INDCPA_MultiChal_Real, -R_MultiPRF}) &m :
    `| Pr[Game_step_0(K, F, A).main() @ &m : res] - Pr[Game_step_6(K, F, A).main() @ &m : res] | <= K_c.eps_KEM_INDCPA_MultiChal + F_c.eps_PRFSecurity_MultiKey.
  proof.
    have h0 := hop_0_pr A &m.
    have h1 := hop_1_pr A &m.
    have h2 := hop_2_pr A &m.
    have h3 := hop_3_pr A &m.
    have h4 := hop_4_pr A &m.
    have h5 := hop_5_pr A &m.
    smt(F_c.eps_PRFSecurity_MultiKey_pos K_c.eps_KEM_INDCPA_MultiChal_pos).
    qed.
end section Main.
