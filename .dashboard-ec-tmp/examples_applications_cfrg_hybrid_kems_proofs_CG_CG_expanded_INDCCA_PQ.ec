  (* Hop 9: assumption hop. Bounded by the KDFPRFSec_advantage axiom applied to RE_Adv. *)

  lemma hop_9_pr (A <: Hybrid_c.KEM_INDCCA_Adv {-KEM_PQ, -NG, -G, -H, -L, -GameCaseSplitIdeal, -GameCaseSplitReal, -GameFreshSS, -H_c.KDFPRFSec_Random, -H_c.KDFPRFSec_Real, -Hybrid_c.KEM_INDCCA_Random, -Hybrid_c.KEM_INDCCA_Real, -KEM_PQ_c.KEM_INDCCA_Random, -KEM_PQ_c.KEM_INDCCA_Real, -RB, -RC, -RD, -RE, -R_Correct_Ideal, -R_Correct_Real}) &m :
    `| Pr[Game_step_9(KEM_PQ, NG, G, H, L, A).main() @ &m : res] - Pr[Game_step_10(KEM_PQ, NG, G, H, L, A).main() @ &m : res] | <= H_c.eps_KDFPRFSec.
  proof.
    have hL : Pr[Game_step_9(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[H_c.Game_KDFPRFSec_Random(H, RE_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
    have hR : Pr[Game_step_10(KEM_PQ, NG, G, H, L, A).main() @ &m : res]
            = Pr[H_c.Game_KDFPRFSec_Real(H, RE_Adv(KEM_PQ, NG, G, H, L, A)).main() @ &m : res]
      by byequiv (_: ={glob A, glob KEM_PQ, glob NG, glob G, glob H, glob L} ==> ={res}) => //; proc; inline *; sim.
