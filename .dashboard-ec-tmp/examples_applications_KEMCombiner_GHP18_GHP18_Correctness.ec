(* ===== Concrete scheme implementation ===== *)

module KEMCombiner (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme) : KC_c.Scheme = {
  proc keygen() : (PK1Space * PK2Space) * (SK1Space * SK2Space * PK1Space * PK2Space) = {
    var k1 : PK1Space * SK1Space;
    var k2 : PK2Space * SK2Space;
    k1 <@ KEM1.keygen();
    k2 <@ KEM2.keygen();
    return ((k1.`1, k2.`1), (k1.`2, k2.`2, k1.`1, k2.`1));
  }
  proc encaps(pk : PK1Space * PK2Space) : bs_outlen * (CT1Space * CT2Space) = {
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var _tup : SS1Space * CT1Space;
    var ss1 : SS1Space;
    var ct1 : CT1Space;
    var _tup_0 : SS2Space * CT2Space;
    var ss2 : SS2Space;
    var ct2 : CT2Space;
    var bpk1 : bs_pk1len;
    var bct1 : bs_ct1len;
    var bpk2 : bs_pk2len;
    var bct2 : bs_ct2len;
    var label : bs_ct1len_ct2len_pk1len_pk2len;
    var ss : bs_outlen;
    pk1 <- pk.`1;
    pk2 <- pk.`2;
    _tup <@ KEM1.encaps(pk1);
    ss1 <- _tup.`1;
    ct1 <- _tup.`2;
    _tup_0 <@ KEM2.encaps(pk2);
    ss2 <- _tup_0.`1;
    ct2 <- _tup_0.`2;
    bpk1 <- pk1;
    bct1 <- ct1;
    bpk2 <- pk2;
    bct2 <- ct2;
    label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
    ss <@ F.evaluate(ss1, ss2, label);
    return (ss, (ct1, ct2));
  }
  proc decaps(sk : SK1Space * SK2Space * PK1Space * PK2Space, c : CT1Space * CT2Space) : bs_outlen = {
    var sk1 : SK1Space;
    var sk2 : SK2Space;
    var pk1 : PK1Space;
    var pk2 : PK2Space;
    var ct1 : CT1Space;
    var ct2 : CT2Space;
    var ss1 : SS1Space;
    var ss2 : SS2Space;
    var bpk1 : bs_pk1len;
    var bct1 : bs_ct1len;
    var bpk2 : bs_pk2len;
    var bct2 : bs_ct2len;
    var label : bs_ct1len_ct2len_pk1len_pk2len;
    var _r0 : bs_outlen;
    sk1 <- sk.`1;
    sk2 <- sk.`2;
    pk1 <- sk.`3;
    pk2 <- sk.`4;
    ct1 <- c.`1;
    ct2 <- c.`2;
    ss1 <@ KEM1.decaps(sk1, ct1);
    ss2 <@ KEM2.decaps(sk2, ct2);
    bpk1 <- pk1;
    bct1 <- ct1;
    bpk2 <- pk2;
    bct2 <- ct2;
    label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
    _r0 <@ F.evaluate(ss1, ss2, label);
    return _r0;
  }
}.

section Main.
  declare module KEM1 <: KEM1_c.Scheme.

  declare module KEM2 <: KEM2_c.Scheme {-KEM1}.

  declare module F <: F_c.Scheme {-KEM1, -KEM2}.

  (* ===== Deterministic-method specs ===== *)

  declare axiom KEM1_decaps_det (g : (glob KEM1)) (a0 : SK1Space) (a1 : CT1Space) : phoare[ KEM1.decaps : (glob KEM1) = g /\ sk = a0 /\ m = a1 ==> (glob KEM1) = g /\ res = KEM1_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom KEM2_decaps_det (g : (glob KEM2)) (a0 : SK2Space) (a1 : CT2Space) : phoare[ KEM2.decaps : (glob KEM2) = g /\ sk = a0 /\ m = a1 ==> (glob KEM2) = g /\ res = KEM2_c.ev_decaps a0 a1 ] = 1%r.

  declare axiom F_evaluate_det (g : (glob F)) (a0 : bs_ss1len) (a1 : bs_ss2len) (a2 : bs_ct1len_ct2len_pk1len_pk2len) : phoare[ F.evaluate : (glob F) = g /\ key1 = a0 /\ key2 = a1 /\ input = a2 ==> (glob F) = g /\ res = F_c.ev_evaluate a0 a1 a2 ] = 1%r.

  (* ===== Reductions ===== *)

  module R_KEM1 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : KEM1_c.KEMCorrectness_Oracle) = {
    proc compute() : (CT1Space * CT2Space) * bs_outlen * bs_outlen = {
      var _tup : PK1Space * SK1Space;
      var pk1 : PK1Space;
      var sk : SK1Space;
      var _tup_0 : PK2Space * SK2Space;
      var pk2 : PK2Space;
      var sk2 : SK2Space;
      var _tup_1 : CT1Space * SS1Space * SS1Space;
      var ct1 : CT1Space;
      var ss1_e : SS1Space;
      var ss1_d : SS1Space;
      var _tup_2 : SS2Space * CT2Space;
      var ss2_e : SS2Space;
      var ct2 : CT2Space;
      var ss2_d : SS2Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var _r0 : bs_outlen;
      var _r1 : bs_outlen;
      _tup <@ KEM1.keygen();
      pk1 <- _tup.`1;
      sk <- _tup.`2;
      _tup_0 <@ KEM2.keygen();
      pk2 <- _tup_0.`1;
      sk2 <- _tup_0.`2;
      _tup_1 <@ Challenger.compute(pk1, sk);
      ct1 <- _tup_1.`1;
      ss1_e <- _tup_1.`2;
      ss1_d <- _tup_1.`3;
      _tup_2 <@ KEM2.encaps(pk2);
      ss2_e <- _tup_2.`1;
      ct2 <- _tup_2.`2;
      ss2_d <@ KEM2.decaps(sk2, ct2);
      bpk1 <- pk1;
      bct1 <- ct1;
      bpk2 <- pk2;
      bct2 <- ct2;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      _r0 <@ F.evaluate(ss1_e, ss2_e, label);
      _r1 <@ F.evaluate(ss1_d, ss2_d, label);
      return ((ct1, ct2), _r0, _r1);
    }
  }.

  module R_KEM2 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : KEM2_c.KEMCorrectness_Oracle) = {
    proc compute() : (CT1Space * CT2Space) * bs_outlen * bs_outlen = {
      var k1 : PK1Space * SK1Space;
      var _tup : PK2Space * SK2Space;
      var pk2 : PK2Space;
      var sk : SK2Space;
      var pk1 : PK1Space;
      var _tup_0 : SS1Space * CT1Space;
      var ss1 : SS1Space;
      var ct1 : CT1Space;
      var _tup_1 : CT2Space * SS2Space * SS2Space;
      var ct2 : CT2Space;
      var ss2_e : SS2Space;
      var ss2_d : SS2Space;
      var bpk1 : bs_pk1len;
      var bct1 : bs_ct1len;
      var bpk2 : bs_pk2len;
      var bct2 : bs_ct2len;
      var label : bs_ct1len_ct2len_pk1len_pk2len;
      var _r0 : bs_outlen;
      var _r1 : bs_outlen;
      k1 <@ KEM1.keygen();
      _tup <@ KEM2.keygen();
      pk2 <- _tup.`1;
      sk <- _tup.`2;
      pk1 <- k1.`1;
      _tup_0 <@ KEM1.encaps(pk1);
      ss1 <- _tup_0.`1;
      ct1 <- _tup_0.`2;
      _tup_1 <@ Challenger.compute(pk2, sk);
      ct2 <- _tup_1.`1;
      ss2_e <- _tup_1.`2;
      ss2_d <- _tup_1.`3;
      bpk1 <- pk1;
      bct1 <- ct1;
      bpk2 <- pk2;
      bct2 <- ct2;
      label <- concat_bs_ct1len_pk1len_pk2len_bs_ct2len_to_bs_ct1len_ct2len_pk1len_pk2len (concat_bs_ct1len_pk1len_bs_pk2len_to_bs_ct1len_pk1len_pk2len (concat_bs_pk1len_bs_ct1len_to_bs_ct1len_pk1len bpk1 bct1) bpk2) bct2;
      _r0 <@ F.evaluate(ss1, ss2_e, label);
      _r1 <@ F.evaluate(ss1, ss2_d, label);
      return ((ct1, ct2), _r0, _r1);
    }
  }.

  (* ===== Reductions lifted to assumption-adversaries ===== *)

  module R_KEM1_Adv (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv, C : KEM1_c.KEMCorrectness_Oracle) = {
    proc distinguish() : bool = {
      var b : bool;
      b <@ A(R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), C)).distinguish();
      return b;
    }
  }.

  module R_KEM2_Adv (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv, C : KEM2_c.KEMCorrectness_Oracle) = {
    proc distinguish() : bool = {
      var b : bool;
      b <@ A(R_KEM2(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), C)).distinguish();
      return b;
    }
  }.

  (* ===== Game-step wrappers ===== *)

  (* Game_step_0: KEMCorrectnessKG.FromDecaps *)

  module Game_step_0 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KC_c.KEMCorrectnessKG_FromDecaps(KEMCombiner(KEM1, KEM2, F))).distinguish();
      return b;
    }
  }.

  (* Game_step_1: KEMCorrectness.FromDecaps composed with reduction R_KEM1 *)

  module Game_step_1 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEMCorrectness_FromDecaps(KEM1))).distinguish();
      return b;
    }
  }.

  (* Game_step_2: KEMCorrectness.FromEncaps composed with reduction R_KEM1 *)

  module Game_step_2 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R_KEM1(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM1_c.KEMCorrectness_FromEncaps(KEM1))).distinguish();
      return b;
    }
  }.

  (* Game_step_3: KEMCorrectness.FromDecaps composed with reduction R_KEM2 *)

  module Game_step_3 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R_KEM2(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromDecaps(KEM2))).distinguish();
      return b;
    }
  }.

  (* Game_step_4: KEMCorrectness.FromEncaps composed with reduction R_KEM2 *)

  module Game_step_4 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(R_KEM2(KEM1, KEM2, F, KEMCombiner(KEM1, KEM2, F), KEM2_c.KEMCorrectness_FromEncaps(KEM2))).distinguish();
      return b;
    }
  }.

  (* Game_step_5: KEMCorrectnessKG.FromEncaps *)

  module Game_step_5 (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, A : KC_c.KEMCorrectnessKG_Adv) = {
    proc main() : bool = {
      var b : bool;
      b <@ A(KC_c.KEMCorrectnessKG_FromEncaps(KEMCombiner(KEM1, KEM2, F))).distinguish();
      return b;
    }
  }.

