  module G_StoredSS_T (KEM_PQ : KEM_PQ_c.Scheme, KEM_T : KEM_T_c.Scheme, G : G_c.Scheme, H : H_c.Scheme, L : L_c.Scheme) : Hybrid_c.KEM_INDCCA_Oracle = {
