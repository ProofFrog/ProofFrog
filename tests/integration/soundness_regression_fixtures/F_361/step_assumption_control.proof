// Positive control for F-361 (step assumptions). The multi-key PRF hybrid
// proof from the examples, with one change: a let entry `Int count;` that
// shares its name with the reduction's field `count` and is not passed to
// the reduction. The engine renames a game field named like a let entry,
// so the step assumptions, which name the field as written
// (`R_Hybrid(F, 1).count >= 1`), must follow the rename to keep reading
// the field.
// Expected: Proof Succeeded!

import 'PRF.primitive';
import 'PRFSecurity.game';
import 'PRFSecurity_MultiKey.game';

proof:

let:
    Int lambda;
    Int in;
    Int out;
    Int q;
    Int count;
    PRF F = PRF(lambda, in, out);

assume:
    PRFSecurity(F);
    calls <= q;

theorem:
    PRFSecurity_MultiKey(F);

games:
    PRFSecurity_MultiKey(F).Real against PRFSecurity_MultiKey(F).Adversary;

    assume R_Hybrid(F, 1).count >= 1;

    induction(i from 1 to q) {
        PRFSecurity(F).Real compose R_Hybrid(F, i) against PRFSecurity_MultiKey(F).Adversary;
        PRFSecurity(F).Random compose R_Hybrid(F, i) against PRFSecurity_MultiKey(F).Adversary;
    }

    assume R_Hybrid(F, q).count < q + 1;

    PRFSecurity_MultiKey(F).Random against PRFSecurity_MultiKey(F).Adversary;

Reduction R_Hybrid(PRF F, Int h) compose PRFSecurity(F) against PRFSecurity_MultiKey(F).Adversary {
    Int count;

    Void Initialize() {
        count = 0;
        challenger.Initialize();
    }

    BitString<F.out> Lookup(BitString<F.in> x) {
        count = count + 1;
        if (count < h) {
            BitString<F.out> r <- BitString<F.out>;
            return r;
        } else if (count == h) {
            return challenger.Lookup(x);
        } else {
            BitString<F.lambda> k <- BitString<F.lambda>;
            return F.evaluate(k, x);
        }
    }
}
