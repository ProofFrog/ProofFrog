          _r11 <@ H.evaluate(kdf_in);
          _r5 <- Some (_r11);
        } else {
          dec_ss_PQ_opt <@ Challenger.decaps(ct_PQ);
          if (false) {
            _r5 <- None;
          } else {
            _r0 <@ KEM_PQ.encodesharedsecret(oget (dec_ss_PQ_opt));
