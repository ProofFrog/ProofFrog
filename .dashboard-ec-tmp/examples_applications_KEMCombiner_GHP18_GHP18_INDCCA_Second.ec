    proc.
    inline *.
    swap{1} [14..15] -9.
    wp.
    rnd.
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    wp.
    call (_: true).
    skip => /#.
    qed.

