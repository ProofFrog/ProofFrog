          _r7 <@ KEM_T.encodesharedsecret(corr.`5);
          _r8 <@ KEM_T.encodeciphertext(ct_T);
          _r9 <@ KEM_T.encodeencapskey(corr.`1);
          _r10 <@ L.get();
          kdf_in <- concat_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_bs_nlabel_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss_nlabel (concat_bs_kem_pq_nss_kem_t_nct_kem_t_nss_bs_kem_t_nek_to_bs_kem_pq_nss_kem_t_nct_kem_t_nek_kem_t_nss (concat_bs_kem_pq_nss_kem_t_nss_bs_kem_t_nct_to_bs_kem_pq_nss_kem_t_nct_kem_t_nss (concat_bs_kem_pq_nss_bs_kem_t_nss_to_bs_kem_pq_nss_kem_t_nss _r6 _r7) _r8) _r9) _r10;
