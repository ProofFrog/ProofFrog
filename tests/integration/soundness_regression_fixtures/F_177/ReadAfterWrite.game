// Positive control for F-177: t is assigned before P.f(t) reads it, so
// P.f(t) is P.f(x0), the value Initialize cached in c.
import 'Det.primitive';

Game Real(Det P, Int x0) {
    Int c;
    Void Initialize() {
        c = P.f(x0);
    }
    Int Reveal() {
        return c;
    }
    Int Query() {
        Int t;
        t = x0;
        Int r = P.f(t);
        return r + t;
    }
}

Game Ideal(Det P, Int x0) {
    Int c;
    Void Initialize() {
        c = P.f(x0);
    }
    Int Reveal() {
        return c;
    }
    Int Query() {
        return c + x0;
    }
}

export as ReadAfterWrite;
