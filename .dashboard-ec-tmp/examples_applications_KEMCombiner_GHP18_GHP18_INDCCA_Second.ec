  module R_PRF_R (KEM1 : KEM1_c.Scheme, KEM2 : KEM2_c.Scheme, F : F_c.Scheme, KC : KC_c.Scheme, Challenger : F_c.TwoKeyPRFSecondKeySecurity_Oracle) = {
